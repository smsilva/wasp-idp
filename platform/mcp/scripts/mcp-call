#!/usr/bin/env python3
"""Launch platform-mcp over stdio, call one tool and print its result as JSON (cli-smoke, #222, #224)."""
import argparse
import asyncio
import json
import os
import sys

from mcp import Client, StdioServerParameters


async def call(tool: str, arguments: dict, toolsets: str, allow_writes: bool) -> int:
  # The stdio client passes only a few variables to the server; the smoke's XDG_CONFIG_HOME
  # (its own login) and PLATFORM_API_URL must reach it.
  env = {key: value for key, value in os.environ.items() if key in ("XDG_CONFIG_HOME", "PLATFORM_API_URL", "HOME")}
  args = ["--toolsets", toolsets] + (["--allow-writes"] if allow_writes else [])
  server = StdioServerParameters(command="platform-mcp", args=args, env=env)
  async with Client(server) as client:
    result = await client.call_tool(tool, arguments)
  if result.is_error:
    print(result.content[0].text, file=sys.stderr)
    return 1
  print(json.dumps(result.structured_content, indent=2))
  return 0


def main() -> None:
  parser = argparse.ArgumentParser(description=__doc__)
  parser.add_argument("tool", help="name of the tool to call")
  parser.add_argument("--arguments", default="{}", help="tool arguments as a JSON object (default: %(default)s)")
  parser.add_argument("--toolsets", default="core", help="toolsets to enable (default: %(default)s)")
  parser.add_argument("--allow-writes", action="store_true", help="start the server with the write tools")
  args = parser.parse_args()
  sys.exit(asyncio.run(call(args.tool, json.loads(args.arguments), args.toolsets, args.allow_writes)))


if __name__ == "__main__":
  main()
