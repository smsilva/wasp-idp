def line_set(spec, default):
  if not spec:
    return default
  lines = set()
  for part in str(spec).split(","):
    start, _, end = part.partition("-")
    lines.update(range(int(start), int(end or start) + 1))
  return lines


def highlight_yaml(line):
  esc = html.escape
  item = re.match(r"^(\s*- )(.*)$", line)
  if item and not re.match(r"^[\w.-]+:(\s|$)", item.group(2)):
    return f"{esc(item.group(1))}<span class='s'>{esc(item.group(2))}</span>"
  match = re.match(r"^(\s*)(- )?([\w.-]+)(:)(\s.*|)$", line)
  if not match:
    return esc(line)
  indent, dash, key, colon, rest = match.groups()
  value = esc(rest)
  value = re.sub(r"(\$\{[^}]+\})", r"<span class='p'>\1</span>", value)
  if "<span" not in value and re.fullmatch(r"\s*\d+", rest):
    value = f"<span class='n'>{value}</span>"
  elif "<span" not in value and rest.strip():
    value = f"<span class='s'>{value}</span>"
  return f"{indent}{dash or ''}<span class='k'>{esc(key)}</span>{colon}{value}"


def render_code(code, base):
  source = (base / code["file"]).read_text().splitlines()
  shown = sorted(line_set(code.get("lines"), set(range(1, len(source) + 1))))
  focus = line_set(code.get("focus"), set())
  def row(number):
    css = "focus" if number in focus else ("dim" if focus else "")
    return f"<span class='ln {css}'><span class='no'>{number}</span>{highlight_yaml(source[number - 1])}</span>"
  columns = [shown[:split], shown[split + 1:]] if (split := code_split(shown, source)) else [shown]
  pres = "".join(f"<pre>{''.join(row(n) for n in column)}</pre>" for column in columns)
  return (f"<div class='code'><div class='bar'><b>●</b> <i>●</i> <u>●</u> &nbsp; {html.escape(pathlib.Path(code['file']).name)}</div>"
          f"<div class='cols'>{pres}</div></div>")


def code_split(shown, source):
  """Long files go in two columns, broken at the blank line closest to the middle (index into shown, or None)."""
  if len(shown) <= 20:
    return None
  blanks = [i for i, n in enumerate(shown) if not source[n - 1].strip()]
  return min(blanks, key=lambda i: abs(i - len(shown) / 2)) if blanks else None


URL = re.compile(r"https?://[^\s<>\"')]+[^\s<>\"').,;:]")
TOPIC = re.compile(r"references/[\w.-]+\.md")


# `--topics-url`: published builds link topics to their rendered page on GitHub, not the raw .md.
TOPICS_URL = None


def topic_href(token, topics_dir, base):
  if TOPICS_URL:
    return f"{TOPICS_URL.rstrip('/')}/{pathlib.Path(token).name}"
  return os.path.relpath(topics_dir / pathlib.Path(token).name, base)


def linkify(text, topics_dir, base):
  """Escape notes and turn URLs and references/*.md mentions into links."""
  out, last = [], 0
  pattern = re.compile(f"{URL.pattern}|{TOPIC.pattern}")
  for match in pattern.finditer(text):
    out.append(html.escape(text[last:match.start()]))
    token = match.group(0)
    href = token if token.startswith("http") else topic_href(token, topics_dir, base)
    out.append(f"<a href='{html.escape(href)}' target='_blank'>{html.escape(token)}</a>")
    last = match.end()
  out.append(html.escape(text[last:]))
  return notes_markup("".join(out))


def notes_markup(escaped):
  """Light markdown in notes: **bold**, `code`, and "- " list items (already HTML-escaped)."""
  out = re.sub(r"\*\*(.+?)\*\*", r"<strong>\1</strong>", escaped)
  out = re.sub(r"`([^`\n]+?)`", r"<code class='note-code'>\1</code>", out)
  return re.sub(r"(?m)^- ", "• ", out)


def sources(text, topics_dir, base):
  """Topics cited in the notes, each with the URLs listed in its file, plus URLs cited directly."""
  items = []
  for token in dict.fromkeys(TOPIC.findall(text)):
    path = topics_dir / pathlib.Path(token).name
    href = html.escape(topic_href(token, topics_dir, base))
    if not path.exists():
      items.append(f"<li><a href='{href}'>{html.escape(token)}</a> (arquivo não encontrado)</li>")
      continue
    urls = list(dict.fromkeys(URL.findall(path.read_text())))
    links = "".join(f"<li><a href='{html.escape(u)}' target='_blank'>{html.escape(u)}</a></li>" for u in urls)
    items.append(f"<li><a href='{href}' target='_blank'>{html.escape(token)}</a>" + (f"<ul>{links}</ul>" if links else "") + "</li>")
  for url in dict.fromkeys(URL.findall(text)):
    items.append(f"<li><a href='{html.escape(url)}' target='_blank'>{html.escape(url)}</a></li>")
  return f"<ul class='sources'>{''.join(items)}</ul>" if items else ""


def validate(outline):
  errors = []
  audiences = set(outline.get("audiences", {}))
  acts = {act["name"] for act in outline["acts"]}
  names = {slide["name"] for slide in outline["slides"]}
  seen = set()
  for slide in outline["slides"]:
    name = slide["name"]
    if slide["act"] not in acts:
      errors.append(f"{name}: unknown act '{slide['act']}'")
    unknown = set(slide.get("audiences", [])) - audiences
    if unknown:
      errors.append(f"{name}: unknown audiences {sorted(unknown)}")
    for dependency in slide.get("dependsOn", []):
      if dependency not in names:
        errors.append(f"{name}: dependsOn unknown slide '{dependency}'")
      elif dependency not in seen:
        errors.append(f"{name}: dependsOn '{dependency}', which comes later")
    seen.add(name)
  for slide in outline["slides"]:
    parts = set(slide.get("show", [])) | set(slide.get("dim", [])) | set(slide.get("reveal", []))
    if parts and not slide.get("diagram"):
      errors.append(f"{slide['name']}: show/dim/reveal without diagram")
  # `parts`: every act and every item target (`go`, an act or a slide) must exist.
  slide_names = {slide["name"] for slide in outline["slides"]}
  for part in outline.get("parts") or []:
    for act in part["acts"]:
      if act not in acts:
        errors.append(f"part '{part['title']}': unknown act '{act}'")
    for item in part["items"]:
      if item["go"] not in acts and item["go"] not in slide_names:
        errors.append(f"part '{part['title']}': item '{item['label']}' goes to unknown '{item['go']}'")
  return errors


def build_steps(outline):
  """Expand acts and slides into presentation steps (one per reveal, as duplicate slides).

  Act opening: act title alone, then title dimmed + act question. Slide: one step per
  `screen` keyword, the current one bright and the previous ones dimmed. Code slides
  and `animations: none` render as a single step.
  """
  acts = {act["name"]: act for act in outline["acts"]}
  first_act = outline["acts"][0]["name"]
  steps, current_act, previous_section = [], None, None
  parts = outline.get("parts") or []
  part_start = {part["acts"][0]: n for n, part in enumerate(parts)}
  for slide in outline["slides"]:
    act = acts[slide["act"]]
    if slide["act"] != current_act:
      current_act = slide["act"]
      # `parts`: the agenda returns before each part, with that part highlighted.
      if current_act in part_start and outline["deck"].get("agendaSteps", True):
        steps.append({"slide": None, "act": act, "section": "", "items": [], "agenda": part_start[current_act]})
      # `opening: false` on an act skips its title/question steps; the header already names the act.
      if current_act != first_act and act.get("opening", True):
        steps.append({"slide": None, "act": act, "section": "", "items": [(act["title"], "active")] + ([(act["question"], "hidden")] if act.get("question") else [])})
        if act.get("question"):
          steps.append({"slide": None, "act": act, "section": "", "items": [(act["title"], "dim"), (act["question"], "active")]})
    section = "" if slide["act"] == first_act else act["title"]
    # Optional `topic`: groups consecutive slides on the same subject; shown under the act title.
    if section and slide.get("topic"):
      section = (section, slide["topic"])
    # Topic change: a divider step, act + topic large, before the first slide of the topic.
    # `divider: false` on a slide skips it (a diagram that already announces its topic).
    if isinstance(section, tuple) and section != previous_section and slide.get("divider", True):
      # `divider: <text>` replaces the topic in the transition (a plane opening on its first capability).
      shown = (section[0], slide["divider"]) if isinstance(slide.get("divider"), str) else section
      steps.append({"slide": slide, "act": act, "section": shown, "items": [], "divider": True})
    previous_section = section
    # `diagram`: an SVG whose <g data-part> groups are revealed one per step (`reveal`),
    # over parts already introduced: `show` at full color (the skeleton), `dim` dimmed
    # (the previous content). Earlier parts of the same `reveal` dim as the next one enters,
    # unless `accumulate: true` (they stay at full color: the drawing grows).
    if slide.get("diagram"):
      reveal = slide.get("reveal") or []
      shown = {**{part: "dim" for part in slide.get("dim", [])}, **{part: "on" for part in slide.get("show", [])}}
      # `start: empty`: a first step with nothing revealed yet; `empty` parts show only on it (an empty prompt).
      if not reveal or slide.get("start") == "empty":
        steps.append({"slide": slide, "act": act, "section": section, "items": [],
                      "diagram": {**shown, **{part: "on" for part in slide.get("empty", [])}}})
      for n, part in enumerate(reveal):
        steps.append({"slide": slide, "act": act, "section": section, "items": [],
                      "diagram": {**shown, **{done: "on" if slide.get("accumulate") else "dim" for done in reveal[:n]}, part: "on"}})
      continue
    screen = slide.get("screen") or []
    if slide.get("code") or not screen:
      steps.append({"slide": slide, "act": act, "section": section, "items": [], "code": slide.get("code")})
    elif slide.get("animations") == "none":
      # `deck.audience`: who the deck is for, discreet, on the first slide only.
      audience = outline["deck"].get("audience") if slide is outline["slides"][0] else None
      steps.append({"slide": slide, "act": act, "section": section, "items": [(item, "active") for item in screen]
                    + ([(slide["subtitle"], "active subtitle")] if slide.get("subtitle") else [])
                    + ([(audience, "active audience")] if audience else [])})
    else:
      # Optional `heading`: shown alone first, then stays on top, dimmed, while the items are revealed.
      heading = slide.get("heading")
      if heading:
        steps.append({"slide": slide, "act": act, "section": section,
                      "items": [(heading, "active heading")] + [(item, "hidden") for item in screen]})
      for shown in range(1, len(screen) + 1):
        # An item with sub-items ("- " lines in its value) reveals them one per step.
        # `subitems: together` on the slide shows them all in one step.
        progressive = slide.get("subitems") != "together"
        for subs in range(screen[shown - 1].count("\n- ") + 1 if progressive else 1):
          active = "active" + (f" subs-{subs}" if progressive and "\n- " in screen[shown - 1] else "")
          items = ([(heading, "dim heading")] if heading else []) + (
                   [(item, "dim") for item in screen[:shown - 1]] + [(screen[shown - 1], active)]
                   + [(item, "hidden") for item in screen[shown:]])
          steps.append({"slide": slide, "act": act, "section": section, "items": items})
  return steps


def rich(text, subs=None):
  """Inline markup in screen items: **label**, `catalog name`, _relation_.

  A leading **Label:** followed by a line break (`\n` in the YAML) puts the value on its own line.
  """
  out = html.escape(text)
  out = re.sub(r"`(.+?)`", r"<code class='mono'>\1</code>", out)
  out = re.sub(r"(?<![\w])_(.+?)_(?![\w])", r"<em>\1</em>", out)
  label = re.match(r"\*\*(.+?)\*\*\n(.*)", out, re.S)
  if label:
    value = re.sub(r"\*\*(.+?)\*\*", r"<strong>\1</strong>", label.group(2))
    # Value lines starting with "- " become sub-items, each on its own line with a dash.
    head, *items = value.split("\n- ")
    # `subs`: how many sub-items are revealed; the newest is bright, earlier ones and the head dim.
    shown = len(items) if subs is None else subs
    state = lambda i: "" if subs is None or i == shown - 1 else (" dim" if i < shown - 1 else " hidden")
    head = f"<span class='head{' dim' if subs else ''}'>{head}</span>" if items else head
    value = head + "".join(f"<span class='sub{state(i)}'>{sub}</span>" for i, sub in enumerate(items))
    return f"<strong class='lbl'>{label.group(1)}</strong> <span class='value'>{value}</span>"
  return re.sub(r"\*\*(.+?)\*\*", r"<strong>\1</strong>", out)


INLINE_LABEL = re.compile(r"\*\*([^*\n]+?:)\*\* ")


def aligned(items):
  """Every list item starts with an inline **Label:** — render labels as an invisible column."""
  listed = [text for text, state in items if "heading" not in state]
  return len(listed) > 1 and all(INLINE_LABEL.match(text) for text in listed)


def rich_aligned(text):
  label = INLINE_LABEL.match(text)
  return f"<strong class='lbl'>{html.escape(label.group(1))}</strong><span class='value'>{rich(text[label.end():])}</span>"


def rich_class(text):
  # Marked-up items render in regular weight, so only the marked parts stand out.
  if re.match(r"\*\*.+?\*\*\n", text):
    return " rich labeled"
  return " rich" if "**" in text or "`" in text or "_" in text else ""


def render_agenda(outline, current=None, links=None):
  """Agenda: deck title, meta and one box per part (number, title, message, items)."""
  esc = html.escape
  deck = outline["deck"]
  meta = "".join(f"<div>{esc(m)}</div>" for m in deck.get("meta", []))
  rows = []
  for n, part in enumerate(outline.get("parts") or []):
    state = "" if current is None or n == current else " dim"
    go = links["part"][n] if links else None
    attrs = f" class='row index-item{state}' data-go='{go[0]}' data-last='{go[1]}'" if go else f" class='row{state}'"
    items = "".join(
      (f"<div class='index-item' data-go='{links['items'][n][k]}'>{esc(item['label'])}</div>" if links else f"<div>{esc(item['label'])}</div>")
      for k, item in enumerate(part["items"]))
    long = " long" if len(part["title"]) > 12 else ""
    rows.append(f"<div{attrs}><div class='agnum'>{n + 1:02d}</div><div class='part{long}'>{esc(part['title'])}</div>"
                f"<div><div class='msg'>{esc(part['message'])}</div><div class='topics'>{items}</div></div></div>")
  # In the index, the deck title goes to the first slide.
  title_attrs = " class='title index-item' data-go='0' title='Ir para o primeiro slide'" if links else " class='title'"
  return (f"<div class='agenda'><div class='top'><div><div{title_attrs}>{esc(deck['title'])}</div>"
          f"<div class='sub'>{esc(deck.get('subtitle', ''))}</div></div><div class='meta'>{meta}</div></div>"
          f"<div class='list'>{''.join(rows)}</div></div>")


def render_stage(step, base, outline=None):
  esc = html.escape
  if step.get("agenda") is not None:
    return render_agenda(outline, step["agenda"])
  section = step["section"]
  if step.get("divider"):
    return (f"<div class='inner divider'><div class='divider-act'>{esc(section[0])}</div>"
            f"<div class='divider-topic'>{esc(section[1])}</div></div><div class='footer'></div>")
  has_topic = isinstance(section, tuple)
  if has_topic:
    section = f"<div class='section has-topic'><div class='act-name'>{esc(section[0])}</div><div class='topic'>{esc(section[1])}</div></div>"
  else:
    section = f"<div class='section'>{esc(section)}</div>" if section else ""
  if step.get("diagram") is not None:
    # The `heading` takes the topic line: the topic was already announced by its divider.
    heading = step["slide"].get("heading")
    if heading:
      act_name = step["section"][0] if has_topic else step["section"]
      section = f"<div class='section has-topic'><div class='act-name'>{esc(act_name)}</div><div class='topic'>{esc(heading)}</div></div>"
    svg = (base / step["slide"]["diagram"]).read_text()
    # `dev.2` takes its own state, else its group's (`dev`).
    state = lambda part: step["diagram"].get(part) or step["diagram"].get(part.split(".")[0], "hidden")
    svg = re.sub(r'<g data-part="([\w.-]+)">', lambda m: f'<g data-part="{m[1]}" class="part-{state(m[1])}">', svg)
    source = step["slide"].get("source")
    source_html = f"<div class='source'>Source: {esc(source)}</div>" if source else ""
    return f"{section}<div class='inner diagram-inner'><div class='diagram'>{svg}</div></div><div class='footer'></div>{source_html}"
  if step.get("code"):
    source = (base / step["code"]["file"]).read_text().splitlines()
    shown = sorted(line_set(step["code"].get("lines"), set(range(1, len(source) + 1))))
    split = code_split(shown, source)
    lines = max(split, len(shown) - split - 1) if split else len(shown)
    # Fit the code between header and footer; a two-line header (topic) leaves less room.
    size = min(1.6, (34 if has_topic else 38) / (lines * 1.55))
    body = f"<div style='--code-size: {size:.2f}cqw'>{render_code(step['code'], base)}</div>"
  else:
    # Sub-items ("- " lines inside a value) take a line each, so they count toward the size.
    count = sum(1 + text.count("\n- ") for text, state in step["items"] if "subtitle" not in state and "audience" not in state)
    # Items under a `heading` are a list of it: each one gets a dash, the heading does not.
    bulleted = bool(step["slide"] and step["slide"].get("heading"))
    bullet = lambda state: " bullet" if bulleted and "heading" not in state else ""
    size = 4.4 if count == 1 else 3.6 if count <= 3 else 3.0
    # Opt-in per slide (`align: true`): labels become an invisible column.
    align = bool(step["slide"] and step["slide"].get("align")) and aligned(step["items"])
    subs = lambda state: int(state.split("subs-")[1]) if "subs-" in state else None
    render = lambda text, state: rich_aligned(text) if align and "heading" not in state else rich(text, subs(state))
    body = (f"<div class='items{' aligned' if align else ''}' style='--item-size: {size:.2f}cqw'>"
            + "".join(f"<div class='item {state.replace('active', '').strip()}{bullet(state)}{rich_class(text)}'>{render(text, state)}</div>" for text, state in step["items"])
            + "</div>")
  source = step["slide"].get("source") if step["slide"] else None
  source_html = f"<div class='source'>Source: {esc(source)}</div>" if source else ""
  inner_class = "inner with-topic" if has_topic else "inner"
  return f"{section}<div class='{inner_class}'>{body}</div><div class='footer'></div>{source_html}"


def render_html(outline, base):
  esc = html.escape
  deck = outline["deck"]
  acts = {act["name"]: act for act in outline["acts"]}
  slides = outline["slides"]
  total = len(slides)
  topics_dir = (base / "references").resolve()

  # Home page generated by render-index, next to this script.
  # The home link only exists when a presentations index sits next to the script (one deck: no index).
  index_page = pathlib.Path(__file__).resolve().parent / "index.html"
  home = html.escape(os.path.relpath(index_page, base.resolve())) if index_page.exists() else None
  home_link = f"<a class='home' href='{home}'>⌂ presentations</a>" if home else ""
  nav = [home_link,
         f"<h1>{esc(deck['title'])}</h1>",
         f"<div class='focus'>{' — '.join(esc(x) for x in (deck.get('iteration'), deck.get('focus')) if x)}<br>{total} slides · {len(build_steps(outline))} passos<br><a class='present-link' data-step='0' style='margin:0'>▶ apresentar (P)</a></div>",
         "<div class='nav-tools'><a data-fold='open'>expandir tudo</a> · <a data-fold='items'>recolher itens</a> · <a data-fold='parts'>recolher tópicos</a> · <a data-fold='all'>recolher tudo</a></div>"]
  # Same grouping as the agenda index: part, then the part's items, then the slides of each item.
  # Acts outside every part (the opening) keep their act title.
  parts = outline.get("parts") or []
  part_of = {name: n for n, part in enumerate(parts) for name in part["acts"]}
  slide_at = {slide["name"]: i for i, slide in enumerate(slides)}
  def first_slide(go):
    return slide_at[go] if go in slide_at else next(i for i, slide in enumerate(slides) if slide["act"] == go)
  # Items pointing at the same slide (the business "Ask") share one heading.
  item_starts = [{} for _ in parts]
  for n, part in enumerate(parts):
    for item in part["items"]:
      item_starts[n].setdefault(first_slide(item["go"]), []).append(item["label"])
  # Collapsible: parts start open, items start closed (slides hidden), so the side index reads like the agenda.
  groups = []
  for number, slide in enumerate(slides, start=1):
    part = part_of.get(slide["act"])
    key = ("part", part) if part is not None else ("act", slide["act"])
    if not groups or groups[-1]["key"] != key:
      title = (f"<span class='pnum'>{part + 1:02d}</span>{esc(parts[part]['title'])}" if part is not None
               else esc(acts[slide["act"]]["title"]))
      groups.append({"key": key, "title": title, "items": [{"label": None, "slides": []}]})
    if part is not None and (labels := item_starts[part].get(number - 1)):
      groups[-1]["items"].append({"label": " · ".join(labels), "slides": []})
    groups[-1]["items"][-1]["slides"].append(f"<a href='#{slide['name']}'><span class='n'>{number}</span>{esc(slide['message'])}</a>")
  for group in groups:
    inner = []
    for item in group["items"]:
      if item["label"] is None:
        inner.extend(item["slides"])
      else:
        inner.append(f"<details class='item'><summary>{esc(item['label'])}<span class='count'>{len(item['slides'])}</span></summary>{''.join(item['slides'])}</details>")
    nav.append(f"<details class='part' open><summary>{group['title']}</summary>{''.join(inner)}</details>")

  steps = build_steps(outline)
  stages = [render_stage(step, base, outline) for step in steps]
  # data-slide on a slide's first step lets #present-<slide name> link to it while step numbers shift.
  first_of = lambda i: steps[i]["slide"] is not None and (i == 0 or steps[i - 1]["slide"] is not steps[i]["slide"])
  deck_html = "".join(f"<div class='stage' data-step='{i}'" + (f" data-slide='{esc(steps[i]['slide']['name'])}'" if first_of(i) else "") + f">{stage}</div>"
                      for i, stage in enumerate(stages))
  note_blocks = []
  for step in steps:
    slide, act = step["slide"], step["act"]
    if slide is None:
      head, message, notes = f"{act['title']} — abertura do ato", act.get("question", ""), ""
    else:
      head, message, notes = f"{act['title']} · {slide['name']}", slide["message"], linkify(slide.get("notes", ""), topics_dir, base)
    note_blocks.append(f"<template data-notes='{len(note_blocks)}'><div class='np-head'>{esc(head)}</div>"
                       f"<div class='np-message'>{esc(message)}</div><div class='notes'>{notes}</div></template>")
  deck_html += "".join(note_blocks)
  index = [f"<div class='index'><div class='index-hint'>{home_link + " · " if home_link else ""}↑ ↓ escolher · Enter ir · I ou Esc fechar</div>"]
  listed_acts = set()
  for number, slide in enumerate(slides, start=1):
    if slide["act"] not in listed_acts:
      listed_acts.add(slide["act"])
      act_steps = [i for i, step in enumerate(steps) if step["act"] is acts[slide["act"]]]
      index.append(f"<h2 class='index-item' data-go='{act_steps[0]}'>{esc(acts[slide['act']]['title'])}</h2>")
    own_steps = [i for i, step in enumerate(steps) if step["slide"] is slide]
    index.append(f"<a class='index-item' data-go='{own_steps[0]}' data-last='{own_steps[-1]}'><span class='n'>{number}</span>{esc(slide['message'])}</a>")
  index.append("</div>")
  if outline.get("parts"):
    # Agenda steps belong to the act they open; skip them so a click lands on content.
    first = lambda pred: next(i for i, step in enumerate(steps) if step.get("agenda") is None and pred(step))
    def target(name):
      if name in acts:
        return first(lambda step: step["act"] is acts[name])
      return first(lambda step: step["slide"] is not None and step["slide"]["name"] == name)
    part_ranges = []
    for part in outline["parts"]:
      own = [i for i, step in enumerate(steps) if step["act"]["name"] in part["acts"] and step.get("agenda") is None]
      part_ranges.append((own[0], own[-1]))
    links = {"part": part_ranges, "items": [[target(item["go"]) for item in part["items"]] for part in outline["parts"]]}
    index = [f"<div class='index agenda-index'><div class='index-hint'>{home_link + " · " if home_link else ""}↑ ↓ escolher · Enter ir · I ou Esc fechar</div><div class='agenda-stage'>{render_agenda(outline, None, links)}</div></div>"]
  deck_html += "".join(index)

  def thumbnails(indexes):
    cells = "".join(f"<div><div class='stage' data-step='{i}'>{stages[i]}</div><div class='caption'>passo {n} de {len(indexes)}</div></div>"
                    for n, i in enumerate(indexes, start=1))
    return f"<div class='steps'>{cells}</div>"

  body = []
  intro_done = set()
  for number, slide in enumerate(slides, start=1):
    act = acts[slide["act"]]
    if slide["act"] not in intro_done:
      intro_done.add(slide["act"])
      intro = [i for i, step in enumerate(steps) if step["slide"] is None and step["act"] is act]
      if intro:
        body.append(f"<section class='act-intro'><div class='act'>{esc(act['title'])} — abertura do ato</div>{thumbnails(intro)}</section>")
    own = [i for i, step in enumerate(steps) if step["slide"] is slide]
    question = f"<div class='question'>{esc(act['question'])}</div>" if act.get("question") else ""
    visual = thumbnails(own)
    meta = [f"<code>{esc(slide['name'])}</code>"]
    if slide.get("dependsOn"):
      meta.append("depende de: " + ", ".join(f"<a href='#{d}'>{esc(d)}</a>" for d in slide["dependsOn"]))
    if slide.get("audiences"):
      meta.append("mais relevante para: " + "".join(f"<span class='tag'>{esc(a)}</span>" for a in slide["audiences"]))
    body.append(f"""
<section class='slide' id='{slide['name']}'>
  <div class='act'>{esc(act['title'])}</div>{question}
  <div class='num'>Slide {number} / {total} · {len(own)} passo(s)<a class='present-link' data-step='{own[0]}'>▶ apresentar daqui</a></div>
  <div class='label'>Mensagem</div><div class='message'>{esc(slide['message'])}</div>
  <div class='label'>Tela</div>{visual}
  <div class='label'>Notas</div><div class='notes'>{linkify(slide.get('notes', ''), topics_dir, base)}</div>
  {f"<div class='label'>Fontes</div>{cited}" if (cited := sources(slide.get('notes', ''), topics_dir, base)) else ""}
  <div class='meta'>{' · '.join(meta)}</div>
</section>""")

  return f"""<!doctype html>
<html lang='pt-BR'><head><meta charset='utf-8'><meta name='viewport' content='width=device-width, initial-scale=1'><title>{' — '.join(esc(x) for x in (deck['title'], deck.get('iteration')) if x)}</title>
<style>{CSS}</style><script>if (/^#present-[\\w-]+$/.test(location.hash)) document.documentElement.classList.add('presenting');</script></head>
<body><div id='deck'>{deck_html}<div class='notes-panel'></div><div class='hint'>{home_link}<span class='keys'>{" · " if home_link else ""}← → avançar · I índice · N notas · L posição das notas · S janela do apresentador · F tela cheia · Esc sair</span></div><div class='counter'></div></div><button id='toggle-nav' type='button'>«</button><nav>{''.join(nav)}</nav><main>{''.join(body)}</main>
<script>{SCRIPT}</script></body></html>
"""


def main():
  parser = argparse.ArgumentParser(description=__doc__)
  parser.add_argument("outline", type=pathlib.Path, help="outline YAML file")
  parser.add_argument("--output", type=pathlib.Path, help="HTML output (default: outline name with .html)")
  parser.add_argument("--topics-url", help="base URL for references/*.md links (default: relative path)")
  args = parser.parse_args()
  global TOPICS_URL
  TOPICS_URL = args.topics_url

  outline = yaml.safe_load(args.outline.read_text())
  errors = validate(outline)
  if errors:
    print("\n".join(errors), file=sys.stderr)
    sys.exit(1)

  output = args.output or args.outline.with_suffix(".html")
  output.write_text(render_html(outline, args.outline.parent))
  print(output.resolve())


if __name__ == "__main__":
  main()
