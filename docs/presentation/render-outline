# Toggle for the side index: button, "[" shortcut, state persisted in localStorage.
SCRIPT = """
const KEY = 'idp-outline-nav-hidden';
const button = document.getElementById('toggle-nav');
function apply(hidden) {
  document.body.classList.toggle('nav-hidden', hidden);
  button.textContent = hidden ? '\u00bb' : '\u00ab';
  button.title = (hidden ? 'Mostrar' : 'Esconder') + ' o índice ([)';
}
function toggle() {
  const hidden = !document.body.classList.contains('nav-hidden');
  localStorage.setItem(KEY, hidden ? '1' : '0');
  apply(hidden);
}
button.addEventListener('click', toggle);
document.addEventListener('keydown', (event) => {
  if (event.key === '[' && !event.ctrlKey && !event.metaKey && !event.altKey && !document.getElementById('deck').classList.contains('on')) toggle();
});
apply(localStorage.getItem(KEY) === '1');
// open: everything · items: parts open, slides hidden · parts: items closed, parts closed · all: same, plus the opening.
document.querySelectorAll('nav [data-fold]').forEach((link) => link.addEventListener('click', () => {
  const mode = link.dataset.fold;
  document.querySelectorAll('nav details.item').forEach((d) => { d.open = mode === 'open'; });
  document.querySelectorAll('nav details.part').forEach((d) => {
    const loose = !d.querySelector('details.item');
    d.open = mode === 'open' || mode === 'items' || (mode === 'parts' && loose);
  });
}));
// Opening the page at #<slide>: unfold the item that holds it.
function reveal() {
  const link = Array.from(document.querySelectorAll('nav details a')).find((a) => a.getAttribute('href') === decodeURIComponent(location.hash));
  if (!link) return;
  for (let d = link.closest('details'); d; d = d.parentElement.closest('details')) d.open = true;
  link.scrollIntoView({ block: 'nearest' });
}
reveal();
window.addEventListener('hashchange', reveal);

// Presentation mode: one step at a time, full screen.
const deck = document.getElementById('deck');
const stages = deck.querySelectorAll('.stage');
let current = 0;
let syncing = false;
// Presenter view: a second window of this same page, kept in sync step by step.
const channel = new BroadcastChannel('idp-outline-' + location.pathname);
channel.onmessage = (event) => {
  syncing = true;
  if (!deck.classList.contains('on')) present(event.data); else show(event.data);
  syncing = false;
};
const NOTES_KEY = 'idp-outline-notes';
if (localStorage.getItem(NOTES_KEY) === '1' || location.search.includes('presenter')) deck.classList.add('with-notes');
const LAYOUT_KEY = 'idp-outline-notes-layout';
if (localStorage.getItem(LAYOUT_KEY) !== 'bottom') deck.classList.add('notes-right');
// Aligned label/value lists: shrink the font until the widest row fits the slide width.
function fitAligned(stage) {
  stage.querySelectorAll('.items.aligned').forEach((list) => {
    list.style.removeProperty('--fit');
    const inner = list.closest('.inner'), style = getComputedStyle(inner);
    const room = inner.clientWidth - parseFloat(style.paddingLeft) - parseFloat(style.paddingRight);
    const left = list.getBoundingClientRect().left;
    const widest = Math.max(...Array.from(list.querySelectorAll('.value, .item')).map((el) => el.getBoundingClientRect().right - left));
    if (widest > room) list.style.setProperty('--fit', (room / widest * 0.98).toFixed(3));
  });
}
document.fonts.ready.then(() => { if (deck.classList.contains('on')) fitAligned(stages[current]); });
window.addEventListener('resize', () => { if (deck.classList.contains('on')) fitAligned(stages[current]); });
function show(index) {
  current = Math.max(0, Math.min(stages.length - 1, index));
  stages.forEach((stage, i) => stage.classList.toggle('current', i === current));
  fitAligned(stages[current]);
  deck.querySelector('.counter').textContent = (current + 1) + ' / ' + stages.length;
  deck.querySelector('.notes-panel').innerHTML = deck.querySelector(`template[data-notes='${current}']`).innerHTML;
  if (!syncing) channel.postMessage(current);
  history.replaceState(null, '', '#present-' + (current + 1));
}
function present(index) { deck.classList.add('on'); show(index); }
function stop() {
  deck.classList.remove('on');
  document.documentElement.classList.remove('presenting');
  history.replaceState(null, '', location.pathname);
  if (document.fullscreenElement) document.exitFullscreen();
}
document.querySelectorAll('[data-step]').forEach((element) => {
  if (element.closest('#deck')) return;
  element.addEventListener('click', () => { if (!getSelection().isCollapsed) return; present(Number(element.dataset.step)); });
});
// Navigation is keyboard-only (space, arrows) so a click never jumps away from a text selection.
// On touch screens there is no keyboard: a tap on the right third advances, on the left third goes back.
deck.addEventListener('pointerup', (event) => {
  if (event.pointerType !== 'touch' || !deck.classList.contains('on') || deck.classList.contains('index-open')) return;
  if (event.target.closest('a, .notes-panel')) return;
  const x = event.clientX / window.innerWidth;
  if (x > 2 / 3) show(current + 1);
  else if (x < 1 / 3) show(current - 1);
});
// Slide index inside presentation mode.
const items = Array.from(deck.querySelectorAll('.index-item'));
let selected = 0;
function select(index) {
  selected = Math.max(0, Math.min(items.length - 1, index));
  items.forEach((item, i) => item.classList.toggle('selected', i === selected));
  items[selected].scrollIntoView({ block: 'nearest' });
}
function openIndex() {
  deck.classList.add('index-open');
  let here = 0;
  items.forEach((item, i) => {
    const first = Number(item.dataset.go), last = Number(item.dataset.last ?? item.dataset.go);
    item.classList.toggle('here', item.dataset.last !== undefined && current >= first && current <= last);
    if (first <= current) here = i;
  });
  select(here);
  items[selected].scrollIntoView({ block: 'center' });
}
function closeIndex() { deck.classList.remove('index-open'); }
items.forEach((item) => item.addEventListener('click', (event) => {
  event.stopPropagation();
  closeIndex();
  show(Number(item.dataset.go));
}));
deck.querySelector('.index').addEventListener('click', (event) => event.stopPropagation());
// #present-N opens step N; #present-<slide name> opens that slide's first step (stable when steps shift).
// Also on hashchange: pasting a #present-… link into a tab already on the deck does not reload the page.
function presentFromHash() {
