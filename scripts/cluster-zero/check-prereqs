#!/bin/bash
# Validate the CLI tools needed to bring up the local cluster-zero exercise.
#
# No `set -e`: the checker must keep going after a missing tool to report the
# full list in a single run.

required_tools="k3d kubectl helm docker"
minimum_inotify_instances=1024
# k3d 5.9.0 ships k3s v1.35; the platform needs k3s >= 1.31 (#571). Keep in step with MIN_K3D in
# cli/src/wasp_platform/bootstrap/local.py.
minimum_k3d="5.9.0"
inotify_file="${INOTIFY_MAX_INSTANCES_FILE:-/proc/sys/fs/inotify/max_user_instances}"

missing=""
low_inotify="false"
old_k3d=""

version_for() {
  local tool="${1?}"
  case "${tool}" in
    k3d)
      k3d version | head --lines 1
      ;;
    kubectl)
      kubectl version --client 2> /dev/null | head --lines 1
      ;;
    helm)
      helm version --short
      ;;
    docker)
      docker --version
      ;;
  esac
}

echo "Checking cluster-zero prerequisites..."
echo ""

for tool in ${required_tools}; do
  if command -v "${tool}" &> /dev/null; then
    version="$(version_for "${tool}")"
    if [ "${tool}" = "k3d" ]; then
      k3d_number="$(printf '%s' "${version}" | sed -n 's/.*v\([0-9][0-9.]*\).*/\1/p')"
      lowest="$(printf '%s\n%s\n' "${minimum_k3d}" "${k3d_number:-0}" | sort --version-sort | head --lines 1)"
      if [ "${lowest}" != "${minimum_k3d}" ]; then
        printf '  OLD     %-8s %s (need >= %s)\n' "${tool}" "${version}" "${minimum_k3d}"
        old_k3d="true"
        continue
      fi
    fi
    printf '  ok      %-8s %s\n' "${tool}" "${version}"
  else
    printf '  MISSING %-8s\n' "${tool}"
    missing="${missing} ${tool}"
  fi
done

# Five k3d nodes exhaust the default limit (128) and containerd never starts.
inotify_instances="$(cat "${inotify_file}" 2> /dev/null || echo 0)"
if [ "${inotify_instances}" -lt "${minimum_inotify_instances}" ]; then
  printf '  LOW     %-8s fs.inotify.max_user_instances=%s (need >= %s)\n' \
    "inotify" "${inotify_instances}" "${minimum_inotify_instances}"
  low_inotify="true"
else
  printf '  ok      %-8s fs.inotify.max_user_instances=%s\n' "inotify" "${inotify_instances}"
fi

echo ""

if [ -n "${old_k3d}" ]; then
  echo "k3d ${minimum_k3d} or newer is required: its default k3s image must be v1.31 or newer."
  echo "Upgrade it: https://k3d.io/#installation"
  exit 1
fi

if [ "${low_inotify}" = "true" ]; then
  echo "Raise it before creating clusters:"
  echo "  sudo sysctl --write fs.inotify.max_user_instances=${minimum_inotify_instances} fs.inotify.max_user_watches=524288"
  echo "and persist it in /etc/sysctl.d/99-inotify.conf."
  exit 1
fi

if [ -n "${missing}" ]; then
  echo "Missing required tools:${missing}"
  echo "Install them before creating a cluster."
  exit 1
fi

echo "All prerequisites present."