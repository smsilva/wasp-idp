step "workload signals: latency, traffic, errors and saturation from Prometheus, from the CLI and over MCP (#411, #473, ADR 0040)"
# Traffic on every attempt: the sidecar creates a series on its first request, so a burst that ends
# before Prometheus scrapes the series twice (15s apart) leaves a counter that never grows, and no rate.
for attempt in $(seq 1 30); do
  for request in $(seq 1 10); do
    curl --silent --output /dev/null --max-time 5 "${public_url}" || true
  done
  curl --silent --output /dev/null --max-time 5 "${public_url}status/500" || true
  signals="$(platform workload signals "${public_component}" --environment "${environment}" --output json)"
  jq --exit-status '.trafficRps > 0 and .errorRate > 0' <<< "${signals}" > /dev/null && break
  sleep 5
done
echo "${signals}"
jq --exit-status '.trafficRps > 0 and .errorRate > 0 and .latencyP95Ms != null' <<< "${signals}" > /dev/null || {
  echo "expected traffic, errors and latency in the signals of ${public_component}" >&2
  exit 1
}
jq --exit-status '.saturation.value != null and .saturation.memory != null' <<< "${signals}" > /dev/null || {
  echo "expected saturation from the limits of ${public_component}" >&2
  exit 1
}
output="$(platform workload signals "${public_component}" --environment "${environment}")"
echo "${output}"
expect_output "latency p95 " "${output}"
expect_output " req/s · errors " "${output}"
expect_failure "a number of minutes or hours" \
  platform workload signals "${public_component}" \
    --environment "${environment}" \
    --window 1d

# The same instance over MCP: list, get, history and signals (#473).
mcp_workloads=(uv run --project platform/mcp python platform/mcp/scripts/mcp-call --toolsets workloads)
output="$("${mcp_workloads[@]}" workloads_list --arguments "{\"environment\": \"${environment}\"}")"
expect_output "\"instance\": \"${public_component}\"" "${output}"
output="$("${mcp_workloads[@]}" workloads_get --arguments "{\"environment\": \"${environment}\", \"instance\": \"${public_component}\"}")"
expect_output "\"component\": \"${public_component}\"" "${output}"
output="$("${mcp_workloads[@]}" workloads_history --arguments "{\"environment\": \"${environment}\", \"instance\": \"${public_component}\"}")"
expect_output "\"revision\": 1" "${output}"
output="$("${mcp_workloads[@]}" workloads_signals --arguments "{\"environment\": \"${environment}\", \"instance\": \"${public_component}\"}")"
jq --exit-status '.trafficRps > 0' <<< "${output}" > /dev/null || {
  echo "expected traffic in workloads_signals of ${public_component}, got: ${output}" >&2
  exit 1
}

output="$(platform workload remove "${public_component}" \
  --environment "${environment}" \
  --wait)"
expect_output "revision 2: removed from ${environment}" "${output}"
kubectl --context k3d-platform-local --namespace platform-system wait \
  "resourcerequests.platform.wasp.silvios.me/${environment}.${public_component}.route" \
  --for delete \
  --timeout 60s
# The Forager released the route: the HTTPRoute is gone, and the Gateway answers 404 for the host once
# istiod pushed the change (until then, 500: the route points at the Service remove already deleted).
for attempt in $(seq 1 15); do
  status="$(curl --silent --output /dev/null --write-out '%{http_code}' --max-time 10 "${public_url}")"
