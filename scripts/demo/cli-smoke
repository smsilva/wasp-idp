expect_failure "${workload_component} has 2 instances in ${workload_environment}" \
  platform workload get \
    --component "${workload_component}" \
    --environment "${workload_environment}"
output="$(platform workload get --instance "${workload_extra}" --environment "${workload_environment}")"
expect_output "${workload_extra}@${workload_environment} (Available)" "${output}"
# The Service of the component balances only its own instance: 2 pods, none of the second instance.
endpoints="$(kubectl --kubeconfig "${workload_kubeconfig}" --namespace apps get endpointslices \
  --selector "kubernetes.io/service-name=${workload_component}" \
  --output jsonpath='{range .items[*].endpoints[*]}{.targetRef.name}{"\n"}{end}')"
