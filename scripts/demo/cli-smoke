if [[ "$(grep --count . <<< "${endpoints}")" != "2" ]] || grep --quiet -- "^${workload_extra}-" <<< "${endpoints}"; then
  echo "expected the 2 pods of ${workload_component} behind its Service, and none of ${workload_extra}" >&2
  exit 1
fi
output="$(platform catalog component get "${workload_component}")"
expect_output "${workload_extra}@${workload_environment} (0.3.0, Available)" "${output}"
output="$(platform workload remove \
  --instance "${workload_extra}" \
  --environment "${workload_environment}" \
  --wait)"
echo "${output}"
expect_output "${workload_extra}@${workload_environment} revision 2: removed from ${workload_environment}" "${output}"
output="$(platform workload remove \
  --component "${workload_component}" \
  --environment "${workload_environment}" \
  --wait)"
