step "workload deploy with dns and route: the instance reached from outside (#358)"
# The platform default resolves dns and route as provision: a host under the environment's entry point
# (ADR 0036) and an HTTPRoute on its Gateway. The route takes the host from the dns output.
kubectl --context k3d-platform-local apply --filename - <<MANIFEST
apiVersion: catalog.platform.wasp.silvios.me/v1alpha1
kind: Component
metadata:
  name: ${public_component}
  namespace: platform-system
spec:
  owner: team-platform
  system: platform
  source:
    repo: wasp-foundry/${public_component}
---
apiVersion: catalog.platform.wasp.silvios.me/v1alpha1
kind: Version
metadata:
  name: ${public_component}.0.1.0
  namespace: platform-system
  labels:
    platform.wasp.silvios.me/component: ${public_component}
spec:
  component: ${public_component}
  version: "0.1.0"
  image: ghcr.io/stefanprodan/podinfo
  digest: "${workload_digest}"
  commit: "$(printf '6%.0s' {1..40})"
  branch: main
  createdAt: "2026-10-12T12:00:00Z"
  appSpec:
    apiVersion: score.dev/v1b1
    metadata:
      name: ${public_component}
    resources:
      dns:
        type: dns
      route:
        type: route
        params:
          host: \${resources.dns.host}
          path: /
          port: 80
    containers:
      app:
        image: .
        variables:
          PODINFO_UI_MESSAGE: \${metadata.name}
        readinessProbe:
          httpGet:
            path: /readyz
            port: 9898
        # The denominator of saturation in workload signals (#411).
        resources:
          limits:
            cpu: 200m
            memory: 128Mi
    service:
      ports:
        http:
          port: 80
          targetPort: 9898
MANIFEST
public_url="http://${public_component}.${workload_environment}.localhost:7080/"
output="$(platform workload deploy \
  --component "${public_component}" \
  --environment "${workload_environment}" \
  --version 0.1.0 \
  --wait)"
echo "${output}"
expect_output "revision 1: 0.1.0 running" "${output}"
output="$(platform workload list --environment "${workload_environment}")"
echo "${output}"
expect_output "${public_url}" "${output}"
output="$(platform workload get --component "${public_component}" --environment "${workload_environment}")"
echo "${output}"
expect_output "url           ${public_url}" "${output}"
expect_output "internal url  http://${public_component}.apps:80" "${output}"
expect_output "resource      route (route, provision): Ready" "${output}"
# --wait ends when the pods are ready; the Gateway's Envoy may get the Service's endpoints a moment later
# (istiod push), so the first answer can still be an error under load.
for attempt in $(seq 1 15); do
  answer="$(curl --silent --fail --max-time 10 "${public_url}" || true)"
  [[ -n "${answer}" ]] && break
  sleep 2
done
expect_output "\"message\": \"${public_component}\"" "${answer}"

step "workload signals: latency, traffic, errors and saturation from Prometheus (#411, ADR 0040)"
# Traffic on every attempt: the sidecar creates a series on its first request, so a burst that ends
# before Prometheus scrapes the series twice (15s apart) leaves a counter that never grows, and no rate.
for attempt in $(seq 1 30); do
  for request in $(seq 1 10); do
    curl --silent --output /dev/null --max-time 5 "${public_url}" || true
  done
  curl --silent --output /dev/null --max-time 5 "${public_url}status/500" || true
  signals="$(platform workload signals --component "${public_component}" --environment "${workload_environment}" --output json)"
  jq --exit-status '.trafficRps > 0 and .errorRate > 0' <<< "${signals}" > /dev/null && break
  sleep 5
done
echo "${signals}"
jq --exit-status '.trafficRps > 0 and .errorRate > 0 and .latencyP95Ms != null' <<< "${signals}" > /dev/null || {
  echo "expected traffic, errors and latency in the signals of ${public_component}" >&2
  exit 1
}
jq --exit-status '.saturation.value != null and .saturation.memory != null' <<< "${signals}" > /dev/null || {
  echo "expected saturation from the limits of ${public_component}" >&2
  exit 1
}
output="$(platform workload signals --component "${public_component}" --environment "${workload_environment}")"
echo "${output}"
expect_output "latency p95 " "${output}"
expect_output " req/s · errors " "${output}"
expect_failure "a number of minutes or hours" \
  platform workload signals \
    --component "${public_component}" \
    --environment "${workload_environment}" \
    --window 1d

output="$(platform workload remove \
  --component "${public_component}" \
  --environment "${workload_environment}" \
  --wait)"
expect_output "revision 2: removed from ${workload_environment}" "${output}"
kubectl --context k3d-platform-local --namespace platform-system wait \
  "resourcerequests.platform.wasp.silvios.me/${workload_environment}.${public_component}.route" \
  --for delete \
  --timeout 60s
# The Forager released the route: the HTTPRoute is gone, and the Gateway answers 404 for the host once
# istiod pushed the change (until then, 500: the route points at the Service remove already deleted).
for attempt in $(seq 1 15); do
  status="$(curl --silent --output /dev/null --write-out '%{http_code}' --max-time 10 "${public_url}")"
  [[ "${status}" == "404" ]] && break
  sleep 2
done
if [[ "${status}" != "404" ]]; then
  echo "expected 404 at ${public_url} after remove, got ${status}" >&2
  exit 1
fi
kubectl --context k3d-platform-local --namespace platform-system delete versions.catalog.platform.wasp.silvios.me --selector "platform.wasp.silvios.me/component=${public_component}"
kubectl --context k3d-platform-local --namespace platform-system delete resources.catalog.platform.wasp.silvios.me "${public_component}-dns" "${public_component}-route"
kubectl --context k3d-platform-local --namespace platform-system delete components.catalog.platform.wasp.silvios.me "${public_component}"
platform environment delete "${workload_environment}"
kubectl --context k3d-platform-local --namespace platform-system delete versions.catalog.platform.wasp.silvios.me --selector "platform.wasp.silvios.me/component=${workload_component}"
kubectl --context k3d-platform-local --namespace platform-system delete resources.catalog.platform.wasp.silvios.me "${workload_component}-db" "${workload_component}-dns" "${workload_component}-redis" "${workload_component}-route" --ignore-not-found
kubectl --context k3d-platform-local --namespace platform-system delete components.catalog.platform.wasp.silvios.me "${workload_component}"

