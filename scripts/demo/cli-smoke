connected="false"
for attempt in $(seq 1 30); do
  if kubectl --kubeconfig "${workload_kubeconfig}" --namespace apps logs "deployment/${workload_component}" 2>/dev/null | grep --quiet "${workload_component}-db-"; then
    connected="true"
