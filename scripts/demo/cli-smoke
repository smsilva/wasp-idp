step "workload deploy with a postgres: the Forager provisions it, remove undoes it (#304)"
# The platform default policy (platform-default) resolves postgres as provision: a dedicated
# Postgres in the vcluster, its outputs in the variables and the password as a secretKeyRef. The app
# is a psql client that selects until it connects: the deploy proves the wiring, its log the database.
kubectl --context k3d-platform-local apply --filename - <<MANIFEST
apiVersion: catalog.platform.wasp.silvios.me/v1alpha1
kind: Version
metadata:
  name: ${workload_component}.0.5.0
  namespace: platform-system
  labels:
    platform.wasp.silvios.me/component: ${workload_component}
spec:
  component: ${workload_component}
  version: "0.5.0"
  image: docker.io/library/postgres
  digest: "${postgres_digest}"
  commit: "$(printf '5%.0s' {1..40})"
  branch: main
  createdAt: "2026-10-11T14:00:00Z"
  appSpec:
    apiVersion: score.dev/v1b1
    metadata:
      name: ${workload_component}
    resources:
      db:
        type: postgres
    containers:
      app:
        image: .
        command: ["sh", "-c"]
        args: ["until psql --command 'select current_database()'; do sleep 2; done; sleep infinity"]
        variables:
          PGHOST: \${resources.db.host}
          PGPORT: \${resources.db.port}
          PGDATABASE: \${resources.db.name}
          PGUSER: \${resources.db.username}
          PGPASSWORD: \${resources.db.password}
MANIFEST
output="$(platform workload deploy \
  --component "${workload_component}" \
  --environment "${workload_environment}" \
  --version 0.5.0 \
  --wait)"
echo "${output}"
expect_output "revision 8: 0.5.0 running" "${output}"
output="$(platform workload get --component "${workload_component}" --environment "${workload_environment}")"
echo "${output}"
expect_output "resource      db (postgres, provision): Ready" "${output}"
connected="false"
for attempt in $(seq 1 30); do
  if kubectl --kubeconfig "${workload_kubeconfig}" --namespace apps logs "deployment/${workload_component}" 2>/dev/null | grep --quiet "current_database"; then
    connected="true"
    break
  fi
  sleep 2
done
if [[ "${connected}" != "true" ]]; then
  kubectl --kubeconfig "${workload_kubeconfig}" --namespace apps logs "deployment/${workload_component}" | tail -5 >&2
  echo "the app never connected to its postgres" >&2
  exit 1
fi
# The Resource of the catalog derived from the Score (no id): <component>-<resource>.
output="$(platform catalog resource get "${workload_component}-db")"
expect_output "team-platform" "${output}"
output="$(platform workload remove \
  --component "${workload_component}" \
  --environment "${workload_environment}" \
  --wait)"
expect_output "revision 9: removed from ${workload_environment}" "${output}"
kubectl --context k3d-platform-local --namespace platform-system wait \
  "resourcerequests.platform.wasp.silvios.me/${workload_environment}.${workload_component}.db" \
  --for delete \
  --timeout 60s

step "environment policy set|get: postgres in mode compose, in the shared instance (#305)"
# The policy of the environment comes before the platform default: the same 0.5.0 now gets a role
# and a database in shared-pg (platform-resources), reached through the Service the vcluster
# replicates into its namespace resources. remove drops them.
expect_failure "compose needs params.instance" \
