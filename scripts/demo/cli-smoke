#!/bin/bash
set -e

show_usage() {
  cat <<USAGE
Usage: ${0##*/} [--skip-init]

Runs the CLI walkthrough end to end without a browser (#179), on the local target:
init, login as the test user, the refusals a non-admin gets, an environment
created and deleted, then login as the test admin, the catalog import of
idp/catalog/, a team with two test users, checked in the token, an
environment shared with that team (the teammate gets a personal kubeconfig whose
token the Platform API issues (ADR 0028), cannot delete the environment nor get
its admin kubeconfig, and loses access after unshare, in kubectl too), the
templates (list, render, import plan), an SCM connection up to the GitHub
manifest page (creating the App needs a browser and an org owner, so it stays
out), the refusals of component create (unknown system, a --param outside the
schema, a name already in the index, a connection that is not ready), the
refusals of build create (unknown component, a malformed version, an org with no
connection), and a cloud account (ADR 0029): refused with a clear message without an
AWS base credential; with one, the role the platform cannot assume stays
TrustNotEstablished, and another user neither sees it nor registers the same
role. Stops at the first failure with a non-zero exit code.

It runs with its own XDG_CONFIG_HOME (a temporary copy of the platform config), so
your own login in ~/.config/platform/credentials is never touched.

  --skip-init  reuse the running platform-local instead of running 'platform init'
USAGE
}

skip_init="false"

while [[ "$#" -gt 0 ]]; do
  case "${1}" in
    --skip-init) skip_init="true"; shift ;;
    --help) show_usage; exit 0 ;;
    *) echo "Unknown option: ${1}" >&2; show_usage >&2; exit 1 ;;
  esac
done

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
environment="smoke-${RANDOM}"
team="smoke-team-${RANDOM}"
shared_environment="smoke-shared-${RANDOM}"
cloud_account="smoke-aws-${RANDOM}"
# Documentation account ID: AssumeRole there is always denied, which is what the step checks.
cloud_role="arn:aws:iam::123456789012:role/platform-smoke-${RANDOM}"
connection="smoke-scm-${RANDOM}"
component="smoke-component-${RANDOM}"
taken_component="smoke-taken-${RANDOM}"
build_component="smoke-build-${RANDOM}"
render_directory="$(mktemp --directory)"
user_config="${XDG_CONFIG_HOME:-${HOME}/.config}/platform/config.yaml"

# The test logins replace the credentials file; a private config dir keeps the user's session.
smoke_config="$(mktemp --directory)"
mkdir --parents "${smoke_config}/platform"
if [[ -f "${user_config}" ]]; then
  cp "${user_config}" "${smoke_config}/platform/config.yaml"
fi
export XDG_CONFIG_HOME="${smoke_config}"

# The CLI of this checkout, not whatever 'platform' is installed.
platform() {
  uv run --quiet --project "${repo_root}/cli" platform "$@"
}

step() {
  printf '\n\033[1m== %s\033[0m\n' "$*"
}

expect_output() {
  local expected="${1?}"
  local output="${2?}"
  if ! grep --quiet --fixed-strings -- "${expected}" <<< "${output}"; then
    echo "expected '${expected}' in:" >&2
    echo "${output}" >&2
    exit 1
  fi
}

# Runs a command that must fail, and checks its message.
expect_failure() {
  local expected="${1?}"
  shift
  local output
  if output="$("$@" 2>&1)"; then
    echo "expected '$*' to fail, it succeeded:" >&2
    echo "${output}" >&2
    exit 1
  fi
  expect_output "${expected}" "${output}"
  echo "${output}"
}

cleanup() {
  # An environment left behind keeps a vcluster and a host port busy. After a successful run it is
  # already gone and this fails silently; bash keeps the script's own exit status.
  platform environment delete "${environment}" > /dev/null 2>&1 || true
  platform environment delete "${shared_environment}" > /dev/null 2>&1 || true
  platform team delete "${team}" > /dev/null 2>&1 || true
  platform cloud account remove "${cloud_account}" > /dev/null 2>&1 || true
  platform scm connection remove "${connection}" > /dev/null 2>&1 || true
  kubectl --context k3d-platform-local --namespace platform-system delete components.catalog.platform.wasp.silvios.me "${taken_component}" --ignore-not-found > /dev/null 2>&1 || true
  rm --recursive --force "${smoke_config}" "${render_directory}"
}
trap cleanup EXIT

cd "${repo_root}"

if [[ "${skip_init}" == "false" ]]; then
  step "platform init --target local"
  platform init --target local
fi

step "login as the test user (platform-users)"
platform login --test-user
output="$(platform whoami)"
expect_output "platform-smoke@platform.local (platform-users)" "${output}"

step "a non-admin cannot create a domain"
expect_failure "403" \
  platform catalog domain create smoke-forbidden \
    --owner team-platform

step "a non-admin lists templates but cannot create one"
output="$(platform catalog template list)"
expect_output "python-service" "${output}"
expect_failure "403" \
  platform catalog template create smoke-forbidden \
    --type service \
    --owner team-platform \
    --repo https://github.com/smsilva/wasp-idp \
    --path platform/templates/python-service/content \
    --ref main

step "a non-admin cannot list SCM connections"
expect_failure "403" platform scm connection list

step "environment create --wait"
platform environment create "${environment}" \
  --profile ephemeral \
  --wait
output="$(platform environment list)"
expect_output "${environment}" "${output}"

step "environment delete"
platform environment delete "${environment}"

step "login as the test admin (platform-admins)"
platform login --test-admin
output="$(platform whoami)"
expect_output "platform-smoke-admin@platform.local (platform-admins, platform-users)" "${output}"

step "catalog import idp/catalog/"
platform catalog import idp/catalog/ --yes
output="$(platform catalog import idp/catalog/ --dry-run)"
expect_output "nothing to do" "${output}"

step "team create and member add (platform-admins)"
platform team create "${team}"
platform team member add "${team}" platform-smoke@platform.local
platform team member add "${team}" platform-smoke-member@platform.local
output="$(platform team get "${team}")"
expect_output "platform-smoke@platform.local" "${output}"
expect_output "platform-smoke-member@platform.local" "${output}"

step "the test user gets the team in its token, and cannot manage teams"
platform login --test-user
output="$(platform whoami)"
expect_output "${team}" "${output}"
expect_failure "403" platform team create smoke-forbidden

step "the Platform API's Keycloak client cannot put anyone in platform-admins (#238)"
keycloak_admin_api="http://localhost:8180/admin/realms/platform"
client_secret="$(kubectl --context k3d-platform-local --namespace platform-system \
  get secret platform-api-keycloak \
  --output jsonpath='{.data.PLATFORM_API_ADMIN_SECRET}' | base64 --decode)"
client_token="$(curl --silent --fail \
  --data grant_type=client_credentials \
  --data client_id=platform-api-admin \
  --data-urlencode "client_secret=${client_secret}" \
  http://localhost:8180/realms/platform/protocol/openid-connect/token | jq --raw-output .access_token)"
smoke_user_id="$(curl --silent --fail \
  --header "Authorization: Bearer ${client_token}" \
  "${keycloak_admin_api}/users?email=platform-smoke@platform.local&exact=true" | jq --raw-output '.[0].id')"
admins_group_id="$(curl --silent --fail \
  --header "Authorization: Bearer ${client_token}" \
  "${keycloak_admin_api}/groups?search=platform-admins&exact=true" | jq --raw-output '.[] | select(.path == "/platform-admins") | .id')"
status="$(curl --silent --output /dev/null --write-out '%{http_code}' \
  --request PUT \
  --header "Authorization: Bearer ${client_token}" \
  "${keycloak_admin_api}/users/${smoke_user_id}/groups/${admins_group_id}")"
if [[ "${status}" != "403" ]]; then
  echo "expected 403 adding a user to platform-admins with the API client, got ${status}" >&2
  exit 1
fi
echo "403 as expected"

step "environment shared with the team"
platform environment create "${shared_environment}" \
  --profile ephemeral \
  --share-with "${team}" \
  --wait

step "the teammate sees it, gets the kubeconfig, and cannot delete it"
platform login --test-member
output="$(platform environment list)"
expect_output "${shared_environment}" "${output}"
expect_output "platform-smoke@platform.local" "${output}"
output="$(platform environment get "${shared_environment}")"
expect_output "kubectl --kubeconfig" "${output}"
expect_failure "403" platform environment delete "${shared_environment}"
expect_failure "403" platform environment get "${shared_environment}" --admin

step "the teammate's kubectl runs as their own identity, with no certificate in the file (#233)"
member_kubeconfig="${smoke_config}/platform/environments/${shared_environment}.kubeconfig"
if grep --quiet -- "client-key-data" "${member_kubeconfig}"; then
  echo "the personal kubeconfig carries a static credential" >&2
  exit 1
fi
output="$(kubectl --kubeconfig "${member_kubeconfig}" auth whoami)"
expect_output "system:serviceaccount:platform-identities:" "${output}"

step "after unshare, the teammate no longer gets it"
platform login --test-user
platform environment unshare "${shared_environment}" --team "${team}"
platform login --test-member
output="$(platform environment get "${shared_environment}")"
if grep --quiet --fixed-strings -- "kubectl --kubeconfig" <<< "${output}"; then
  echo "teammate still gets the kubeconfig after unshare" >&2
  exit 1
fi
output="$(platform environment list)"
if grep --quiet --fixed-strings -- "${shared_environment}" <<< "${output}"; then
  echo "teammate still lists ${shared_environment} after unshare" >&2
  exit 1
fi
expect_failure "not yours nor shared" kubectl --kubeconfig "${member_kubeconfig}" get namespaces

step "the owner deletes the shared environment"
platform login --test-user
platform environment delete "${shared_environment}"

step "team delete"
platform login --test-admin
platform team delete "${team}"
output="$(platform team list)"
if grep --quiet --fixed-strings -- "${team}" <<< "${output}"; then
  echo "team ${team} still listed after delete" >&2
  exit 1
fi

step "catalog template: the seed is the default for service"
output="$(platform catalog template list)"
expect_output "python-service  service" "${output}"
expect_output "yes" "${output}"

step "catalog template render python-service (fetched at the registered ref)"
platform catalog template render python-service \
  --name smoke-demo \
  --system smoke-system \
  --output "${render_directory}/smoke-demo"
if grep --recursive --fixed-strings --quiet '${{' --exclude-dir .github "${render_directory}/smoke-demo"; then
  echo "unrendered expression left in ${render_directory}/smoke-demo" >&2
  exit 1
fi
expect_output "platform.wasp.silvios.me/template: python-service@" "$(cat "${render_directory}/smoke-demo/catalog-info.yaml")"
expect_output "system: smoke-system" "$(cat "${render_directory}/smoke-demo/catalog-info.yaml")"
expect_output "# smoke-demo: product requirements" "$(cat "${render_directory}/smoke-demo/docs/prd.md")"

step "catalog template import idp/templates/python-service --dry-run"
# Dry run: the Backstage template has the seed's name, and applying would repoint the seed. Its
# owner, group:default/guests, is not a team here: the plan shows that error next to the steps.
output="$(expect_failure "team 'guests' not found" \
  platform catalog template import idp/templates/python-service \
    --repo https://github.com/smsilva/wasp-idp \
    --ref main \
    --dry-run)"
expect_output "publish:github: the platform creates the repo" "${output}"
expect_output "publish:github:pull-request: GitOps belongs to the release" "${output}"

step "scm connection add --no-browser (the manifest flow stops at GitHub)"
output="$(platform scm connection add "${connection}" \
  --vendor github \
  --org wasp-foundry \
  --no-browser)"
next_url="$(grep --only-matching 'http://127.0.0.1:9090/v1/scm/connections/[^ ]*' <<< "${output}")"
page="$(curl --silent --fail "${next_url}")"
expect_output 'action="https://github.com/organizations/wasp-foundry/settings/apps/new?state=' "${page}"
expect_output "default_permissions" "${page}"
status="$(curl --silent --output /dev/null --write-out '%{http_code}' \
  "http://127.0.0.1:9090/v1/scm/connections/${connection}/github/callback?code=fake&state=forged")"
if [[ "${status}" != "400" ]]; then
  echo "expected 400 for a forged state, got ${status}" >&2
  exit 1
fi
output="$(platform scm connection get "${connection}")"
expect_output "AppNotCreated" "${output}"

step "component create: every refusal happens before GitHub (#279)"
# The happy path needs a ready connection, so it stays in the manual walkthrough (step 19).
expect_failure "system 'smoke-missing' not found" \
  platform catalog component create "${component}" \
    --system smoke-missing \
    --owner team-platform \
    --scm "${connection}"
expect_failure "params.colour: not a parameter of python-service" \
  platform catalog component create "${component}" \
    --system platform \
    --owner team-platform \
    --param colour=blue \
    --scm "${connection}"
# A component in the index, as the discovery would write it: the name is taken.
kubectl --context k3d-platform-local apply --filename - <<MANIFEST
apiVersion: catalog.platform.wasp.silvios.me/v1alpha1
kind: Component
metadata:
  name: ${taken_component}
  namespace: platform-system
spec:
  owner: team-platform
  system: platform
  source:
    repo: wasp-foundry/${taken_component}
MANIFEST
expect_failure "component '${taken_component}' already exists" \
  platform catalog component create "${taken_component}" \
    --system platform \
    --owner team-platform \
    --scm "${connection}"
output="$(platform catalog component list --system platform)"
expect_output "${taken_component}" "${output}"
kubectl --context k3d-platform-local --namespace platform-system delete components.catalog.platform.wasp.silvios.me "${taken_component}"
expect_failure "is not ready (AppNotCreated)" \
  platform catalog component create "${component}" \
    --system platform \
    --owner team-platform \
    --scm "${connection}"
expect_failure "not found" platform catalog component get "${component}"

step "build create: every refusal happens before GitHub (#287)"
# The happy path dispatches a real workflow, so it stays in the manual walkthrough (step 20). The repo's
# org has no connection here, so no request can reach GitHub, even with a ready one for wasp-foundry.
kubectl --context k3d-platform-local apply --filename - <<MANIFEST
apiVersion: catalog.platform.wasp.silvios.me/v1alpha1
kind: Component
metadata:
  name: ${build_component}
  namespace: platform-system
spec:
  owner: team-platform
  system: platform
  source:
    repo: smoke-no-connection/${build_component}
MANIFEST
expect_failure "component not found" \
  platform build create \
    --component smoke-missing \
    --branch main
expect_failure "<major>.<minor>.<patch>" \
  platform build create \
    --component "${build_component}" \
    --branch main \
    --version v1
expect_failure "no scm connection for the org 'smoke-no-connection'" \
  platform build create \
    --component "${build_component}" \
    --branch main
output="$(platform build list --component "${build_component}")"
expect_output "VERSION" "${output}"
if [[ "$(wc --lines <<< "${output}")" != "1" ]]; then
  echo "expected no versions of ${build_component}, got:" >&2
  echo "${output}" >&2
  exit 1
fi
kubectl --context k3d-platform-local --namespace platform-system delete components.catalog.platform.wasp.silvios.me "${build_component}"

step "scm connection remove"
platform scm connection remove "${connection}"
expect_failure "404" platform scm connection get "${connection}"

step "cloud account: trust policy, TrustNotEstablished, private to its owner (#193)"
platform login --test-user
if output="$(platform cloud account add "${cloud_account}" --role-arn "${cloud_role}" 2>&1)"; then
  echo "${output}"
  expect_output '"sts:ExternalId"' "${output}"
  output="$(expect_failure "TrustNotEstablished" platform cloud account verify "${cloud_account}" --wait)"
  platform login --test-member
  output="$(platform cloud account list)"
  if grep --quiet --fixed-strings -- "${cloud_account}" <<< "${output}"; then
    echo "${cloud_account} listed for another user" >&2
    exit 1
  fi
  expect_failure "403" platform cloud account remove "${cloud_account}"
  expect_failure "already registered" \
    platform cloud account add "${cloud_account}-again" \
      --role-arn "${cloud_role}"
  platform login --test-user
  platform cloud account remove "${cloud_account}"
else
  # init ran without --aws-profile: the capability has no provider.
  expect_output "--aws-profile" "${output}"
  echo "${output}"
fi

step "logout"
platform logout
expect_failure "not logged in" platform whoami

printf '\n\033[32m✓ cli-smoke passed\033[0m\n'
