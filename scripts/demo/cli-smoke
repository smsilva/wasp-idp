#!/bin/bash
set -e

show_usage() {
  cat <<USAGE
Usage: ${0##*/} [--skip-init]

Runs the CLI walkthrough end to end without a browser (#179), on the local target:
init, login as the test user, platform status as each role, the refusals a non-admin gets, an environment
created (its gateway answering at *.<name>.localhost:7080, a hostNetwork or privileged pod refused in the
vcluster and on the host) and deleted, then
login as the test admin, the catalog import of idp/catalog/, a team with two
test users, checked in the token, an environment shared with that team (the
teammate gets a personal kubeconfig whose token the Platform API issues (ADR
0028), cannot delete the environment nor get its admin kubeconfig, and loses
access after unshare, in kubectl too), the
templates (list, render, import plan), an SCM connection up to the GitHub
manifest page (creating the App needs a browser and an org owner, so it stays
out), the refusals of component create (unknown system, a --param outside the
schema, a name already in the index, a connection that is not ready), component
clone --https of a public repo in the index, and of a name outside it, the OCI
registries (add refused to a non-admin, NoDefaultRegistry when the cluster has no
default, add with --vendor and --scm-connection, a non-ghcr.io host and a taken
address refused, ready once /v2/ answers, set-default keeping one default, remove
refused while a version is in it), the refusals of build create (outside the
owner team, unknown component, a malformed version, an unknown registry, a GHCR
of another org with RegistryNotWritableByCI, an org with no connection), the
Workload Spec (spec validate of a
valid and an invalid Score, spec get of a Version written by kubectl, refused outside the owner team,
by version and by branch, and SpecNotIndexed for a Version without it), a Workload Instance
(deploy of a public image by digest with --wait, list, get, history, rollback to the previous
success, runningIn in catalog component get, remove; refused outside the owner team, for a version
outside the index, a rollback to a failed revision, and ResourcesNotSupported for a resource type without provider; a pod
in the vcluster reaches the Service of the instance by DNS), a second instance of the same component
(deploy --instance, list with COMPONENT, get --component refused as ambiguous, the Service of the
component without the pods of the second instance, remove --instance), a route (workload route
--header to the second instance: a client with the sidecar reaches it with the header and the first
one without; TRAFFIC in list; refused to another component's instance, remove of a routed instance
refused; --clear), a chain of two calls (productpage -> reviews) routed by --baggage to a second
instance of reviews, which a --header route does not reach past the first call (#340), the plan
of an environment (workload apply with --dry-run, --wait and --prune, refused outside the owner team), a postgres
provisioned by the Forager (deploy until Ready, an app that connects to it with psql, the derived catalog Resource,
released on remove), an instance reached from outside through dns and route (its public URL
answers, and 404 after remove, #358), its golden signals from Prometheus after a burst of traffic
(workload signals, #411), and a cloud account (ADR 0029): refused with a clear message without an
AWS base credential; with one, the role the platform cannot assume stays
TrustNotEstablished, and another user neither sees it nor registers the same
role. Stops at the first failure with a non-zero exit code.

It runs with its own XDG_CONFIG_HOME (a temporary copy of the platform config), so
your own login in ~/.config/platform/credentials is never touched.

  --skip-init  reuse the running platform-local instead of running 'platform init'
USAGE
}

skip_init="false"

while [[ "$#" -gt 0 ]]; do
  case "${1}" in
    --skip-init) skip_init="true"; shift ;;
    --help) show_usage; exit 0 ;;
    *) echo "Unknown option: ${1}" >&2; show_usage >&2; exit 1 ;;
  esac
done

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
environment="smoke-${RANDOM}"
team="smoke-team-${RANDOM}"
shared_environment="smoke-shared-${RANDOM}"
cloud_account="smoke-aws-${RANDOM}"
# Documentation account ID: AssumeRole there is always denied, which is what the step checks.
cloud_role="arn:aws:iam::123456789012:role/platform-smoke-${RANDOM}"
connection="smoke-scm-${RANDOM}"
component="smoke-component-${RANDOM}"
taken_component="smoke-taken-${RANDOM}"
clone_component="smoke-clone-${RANDOM}"
build_component="smoke-build-${RANDOM}"
smoke_registry="smoke-reg-${RANDOM}"
other_registry="smoke-reg-other-${RANDOM}"
other_namespace="smoke-other-${RANDOM}"
workload_component="smoke-workload-${RANDOM}"
route_component="smoke-route-${RANDOM}"
public_component="smoke-public-${RANDOM}"
chain_suffix="${RANDOM}"
productpage_component="smoke-productpage-${chain_suffix}"
reviews_component="smoke-reviews-${chain_suffix}"
workload_directory="$(mktemp --directory)"
workload_environment="smoke-workload-${RANDOM}"
# ghcr.io/stefanprodan/podinfo:6.7.1, public: the vcluster pulls it without credentials.
workload_digest="sha256:862ca45e61b32392f7941a1bdfdbe5ff8b6899070135f1bdca1c287d0057fc94"
# postgres:17-alpine, public: the app of the Forager step is its psql client.
postgres_digest="sha256:b0f9560a2de083e2cc7382e75f808c7381a32852a7ec49117deedb300e552b24"
render_directory="$(mktemp --directory)"
clone_directory="$(mktemp --directory)"
user_config="${XDG_CONFIG_HOME:-${HOME}/.config}/platform/config.yaml"

# The test logins replace the credentials file; a private config dir keeps the user's session.
smoke_config="$(mktemp --directory)"
mkdir --parents "${smoke_config}/platform"
if [[ -f "${user_config}" ]]; then
  cp "${user_config}" "${smoke_config}/platform/config.yaml"
fi
export XDG_CONFIG_HOME="${smoke_config}"

# The CLI of this checkout, not whatever 'platform' is installed.
platform() {
  uv run --quiet --project "${repo_root}/cli" platform "$@"
}

# Each step header shows its position and the elapsed time, so a slow --wait reads apart from a hung one.
step_total="$(grep --count --extended-regexp '^ *step "' "${0}")"
if [[ "${skip_init}" == "true" ]]; then
  step_total="$(( step_total - 1 ))"
fi
step_number=0

# Color only on a terminal: a log file keeps plain text.
if [[ -t 1 ]]; then
  bold=$'\033[1m'
  green=$'\033[32m'
  reset=$'\033[0m'
else
  bold=""
  green=""
  reset=""
fi

step() {
  step_number="$(( step_number + 1 ))"
  printf '\n%s== [%d/%d · %dm%02ds] %s%s\n' "${bold}" "${step_number}" "${step_total}" "$(( SECONDS / 60 ))" "$(( SECONDS % 60 ))" "$*" "${reset}"
}

expect_output() {
  local expected="${1?}"
  local output="${2?}"
  if ! grep --quiet --fixed-strings -- "${expected}" <<< "${output}"; then
    echo "expected '${expected}' in:" >&2
    echo "${output}" >&2
    exit 1
  fi
}

# Runs a command that must fail, and checks its message.
expect_failure() {
  local expected="${1?}"
  shift
  local output
  if output="$("$@" 2>&1)"; then
    echo "expected '$*' to fail, it succeeded:" >&2
    echo "${output}" >&2
    exit 1
  fi
  expect_output "${expected}" "${output}"
  # Prefixed, so that a refusal the step expects never reads as a failure.
  sed 's/^/  expected refusal: /' <<< "${output}"
}

cleanup() {
  # An environment left behind keeps a vcluster and a host port busy. After a successful run it is
  # already gone and this fails silently; bash keeps the script's own exit status.
  platform environment delete "${environment}" > /dev/null 2>&1 || true
  platform environment delete "${shared_environment}" > /dev/null 2>&1 || true
  platform environment delete "${workload_environment}" > /dev/null 2>&1 || true
  platform team delete "${team}" > /dev/null 2>&1 || true
  platform cloud account remove "${cloud_account}" > /dev/null 2>&1 || true
  platform scm connection remove "${connection}" > /dev/null 2>&1 || true
  platform registry remove "${smoke_registry}" > /dev/null 2>&1 || true
  platform registry remove "${other_registry}" > /dev/null 2>&1 || true
  kubectl --context k3d-platform-local --namespace platform-system delete components.catalog.platform.wasp.silvios.me "${taken_component}" "${clone_component}" "${workload_component}" "${route_component}" "${productpage_component}" "${reviews_component}" "${public_component}" --ignore-not-found > /dev/null 2>&1 || true
  kubectl --context k3d-platform-local --namespace platform-system delete versions.catalog.platform.wasp.silvios.me --selector "platform.wasp.silvios.me/component in (${workload_component},${route_component},${productpage_component},${reviews_component},${public_component})" > /dev/null 2>&1 || true
  # The database restored by hand for bind (#306): a run stopped mid-step leaves it, and the next one
  # fails on "role restored already exists".
  kubectl --context k3d-platform-local --namespace platform-resources exec statefulset/shared-pg -- \
    psql --username postgres --command "drop database if exists restored with (force)" --command "drop role if exists restored" > /dev/null 2>&1 || true
  kubectl --context k3d-platform-local --namespace platform-resources delete secret restored-db --ignore-not-found > /dev/null 2>&1 || true
  rm --recursive --force "${smoke_config}" "${render_directory}" "${clone_directory}" "${workload_directory}"
}
trap cleanup EXIT

cd "${repo_root}"

if [[ "${skip_init}" == "false" ]]; then
  step "platform init --target local"
  platform init --target local
fi

step "login as the test user (platform-users)"
platform login --test-user
output="$(platform whoami)"
expect_output "platform-smoke@platform.local (platform-users)" "${output}"

step "platform status as a regular user: each capability and its status, nothing more (#269)"
# Exits 1 while scm has no ready connection: the step checks the lines, not the exit code.
output="$(platform status 2>&1 || true)"
echo "${output}"
expect_output "CAPABILITY     STATUS" "${output}"
for capability in identity catalog environment resources workload observability; do
  if ! grep --quiet --extended-regexp "^${capability} +Active\$" <<< "${output}"; then
    echo "expected '${capability}  Active' with no other column" >&2
    exit 1
  fi
done

step "a non-admin cannot create a domain"
expect_failure "403" \
  platform catalog domain create smoke-forbidden \
    --owner team-platform

step "a non-admin lists templates but cannot create one"
output="$(platform catalog template list)"
expect_output "python-service" "${output}"
expect_failure "403" \
  platform catalog template create smoke-forbidden \
    --type service \
    --owner team-platform \
    --repo https://github.com/smsilva/wasp-idp \
    --path platform/templates/python-service/content \
    --ref main

step "a non-admin cannot list SCM connections"
expect_failure "403" platform scm connection list

step "environment create --wait: a vcluster with the mesh (ADR 0035, #343)"
platform environment create "${environment}" \
  --profile ephemeral \
  --wait
output="$(platform environment list)"
expect_output "${environment}" "${output}"
# Ready only with istiod up: status.mesh holds the versions the provider installed.
mesh="$(kubectl --context k3d-platform-local --namespace platform-system get environment "${environment}" \
  --output jsonpath='{.status.mesh.istio} {.status.mesh.gatewayAPI}')"
echo "mesh: ${mesh}"
if [[ ! "${mesh}" =~ ^1\.30\.[0-9]+\ v1\.5\.[0-9]+$ ]]; then
  echo "expected istio 1.30 and gateway api 1.5 in status.mesh of ${environment}, got '${mesh}'" >&2
  exit 1
fi

step "environment get: the entry point of its workloads (ADR 0036, #357)"
output="$(platform environment get "${environment}")"
expect_output "workloads at http://*.${environment}.localhost:7080" "${output}"
# No route yet: the shared Traefik reaches the environment's Gateway, which answers 404.
headers="$(curl --silent --output /dev/null --dump-header - "http://smoke.${environment}.localhost:7080/" | tr --delete '\r' || true)"
server="$(grep --ignore-case '^server:' <<< "${headers}" || true)"
echo "${server}"
if [[ "${server,,}" != "server: istio-envoy" ]]; then
  echo "expected the Gateway of ${environment} (server: istio-envoy) at http://smoke.${environment}.localhost:7080/, got: ${headers:-no answer}" >&2
  exit 1
fi

step "a pod cannot reach the host: baseline in the vcluster and on the host (#414, ADR 0041)"
owner_kubeconfig="${smoke_config}/platform/environments/${environment}.kubeconfig"
expect_failure "hostNetwork, hostPID and hostIPC are not allowed in an environment" \
  kubectl --kubeconfig "${owner_kubeconfig}" run smoke-host-network \
    --image busybox \
    --overrides '{"spec":{"hostNetwork":true}}' \
    --dry-run=server
# The guard is the host: the owner is cluster-admin in the vcluster and can delete the copy there. A pod
# as the vcluster syncs it (its label) into env-<name> is refused too.
expect_failure "privileged containers are not allowed in an environment" \
  kubectl --context k3d-platform-local --namespace "env-${environment}" run smoke-privileged \
    --image busybox \
    --labels vcluster.loft.sh/managed-by=vcluster \
    --privileged \
    --dry-run=server

step "environment delete"
platform environment delete "${environment}"

step "login as the test admin (platform-admins)"
platform login --test-admin
output="$(platform whoami)"
expect_output "platform-smoke-admin@platform.local (platform-admins, platform-users)" "${output}"

step "platform status as an admin: providers, detail, and one capability in full (#269, ADR 0039)"
output="$(platform status 2>&1 || true)"
echo "${output}"
expect_output "PROVIDERS" "${output}"
for line in "catalog +Active +platform-api" "environment +Active +local_vcluster" "resources +Active +forager" "workload +Active +workload" "scm +[A-Za-z]+ +scm_github"; do
  if ! grep --quiet --extended-regexp "^${line}" <<< "${output}"; then
    echo "expected a line matching '${line}'" >&2
    exit 1
  fi
done
output="$(platform status environment)"
echo "${output}"
expect_output "environment  Active" "${output}"
expect_output "local_vcluster" "${output}"
output="$(platform status scm 2>&1 || true)"
echo "${output}"
expect_output "depends on    identity, catalog" "${output}"
if ! grep --quiet --extended-regexp "^  github +scm_github +[0-9a-f]{12} +1/1 +Active" <<< "${output}"; then
  echo "expected the github driver of scm, Active" >&2
  exit 1
fi
expect_failure "capability 'nope' not found" platform status nope

step "catalog import idp/catalog/"
platform catalog import idp/catalog/ --yes
output="$(platform catalog import idp/catalog/ --dry-run)"
expect_output "nothing to do" "${output}"

step "team create and member add (platform-admins)"
platform team create "${team}"
platform team member add "${team}" platform-smoke@platform.local
platform team member add "${team}" platform-smoke-member@platform.local
output="$(platform team get "${team}")"
expect_output "platform-smoke@platform.local" "${output}"
expect_output "platform-smoke-member@platform.local" "${output}"

step "the test user gets the team in its token, and cannot manage teams"
platform login --test-user
output="$(platform whoami)"
expect_output "${team}" "${output}"
expect_failure "403" platform team create smoke-forbidden

step "the Platform API's Keycloak client cannot put anyone in platform-admins (#238)"
keycloak_admin_api="http://localhost:8180/admin/realms/platform"
client_secret="$(kubectl --context k3d-platform-local --namespace platform-system \
  get secret platform-api-keycloak \
  --output jsonpath='{.data.PLATFORM_API_ADMIN_SECRET}' | base64 --decode)"
client_token="$(curl --silent --fail \
  --data grant_type=client_credentials \
  --data client_id=platform-api-admin \
  --data-urlencode "client_secret=${client_secret}" \
  http://localhost:8180/realms/platform/protocol/openid-connect/token | jq --raw-output .access_token)"
smoke_user_id="$(curl --silent --fail \
  --header "Authorization: Bearer ${client_token}" \
  "${keycloak_admin_api}/users?email=platform-smoke@platform.local&exact=true" | jq --raw-output '.[0].id')"
admins_group_id="$(curl --silent --fail \
  --header "Authorization: Bearer ${client_token}" \
  "${keycloak_admin_api}/groups?search=platform-admins&exact=true" | jq --raw-output '.[] | select(.path == "/platform-admins") | .id')"
status="$(curl --silent --output /dev/null --write-out '%{http_code}' \
  --request PUT \
  --header "Authorization: Bearer ${client_token}" \
  "${keycloak_admin_api}/users/${smoke_user_id}/groups/${admins_group_id}")"
if [[ "${status}" != "403" ]]; then
  echo "expected 403 adding a user to platform-admins with the API client, got ${status}" >&2
  exit 1
fi
echo "403 as expected"

step "environment shared with the team"
platform environment create "${shared_environment}" \
  --profile ephemeral \
  --share-with "${team}" \
  --wait

step "the teammate sees it, gets the kubeconfig, and cannot delete it"
platform login --test-member
output="$(platform environment list)"
expect_output "${shared_environment}" "${output}"
expect_output "platform-smoke@platform.local" "${output}"
output="$(platform environment get "${shared_environment}")"
expect_output "kubectl --kubeconfig" "${output}"
expect_failure "403" platform environment delete "${shared_environment}"
expect_failure "403" platform environment get "${shared_environment}" --admin

step "the teammate's kubectl runs as their own identity, with no certificate in the file (#233)"
member_kubeconfig="${smoke_config}/platform/environments/${shared_environment}.kubeconfig"
if grep --quiet -- "client-key-data" "${member_kubeconfig}"; then
  echo "the personal kubeconfig carries a static credential" >&2
  exit 1
fi
output="$(kubectl --kubeconfig "${member_kubeconfig}" auth whoami)"
expect_output "system:serviceaccount:platform-identities:" "${output}"

step "after unshare, the teammate no longer gets it"
platform login --test-user
platform environment unshare "${shared_environment}" --team "${team}"
platform login --test-member
output="$(platform environment get "${shared_environment}")"
if grep --quiet --fixed-strings -- "kubectl --kubeconfig" <<< "${output}"; then
  echo "teammate still gets the kubeconfig after unshare" >&2
  exit 1
fi
output="$(platform environment list)"
if grep --quiet --fixed-strings -- "${shared_environment}" <<< "${output}"; then
  echo "teammate still lists ${shared_environment} after unshare" >&2
  exit 1
fi
expect_failure "not yours nor shared" kubectl --kubeconfig "${member_kubeconfig}" get namespaces

step "the owner deletes the shared environment"
platform login --test-user
platform environment delete "${shared_environment}"

step "team delete"
platform login --test-admin
platform team delete "${team}"
output="$(platform team list)"
if grep --quiet --fixed-strings -- "${team}" <<< "${output}"; then
  echo "team ${team} still listed after delete" >&2
  exit 1
fi

step "catalog template: the seed is the default for service"
output="$(platform catalog template list)"
expect_output "python-service  service" "${output}"
expect_output "yes" "${output}"

step "catalog template render python-service (fetched at the registered ref)"
platform catalog template render python-service \
  --name smoke-demo \
  --system smoke-system \
  --output "${render_directory}/smoke-demo"
if grep --recursive --fixed-strings --quiet '${{' --exclude-dir .github "${render_directory}/smoke-demo"; then
  echo "unrendered expression left in ${render_directory}/smoke-demo" >&2
  exit 1
fi
expect_output "platform.wasp.silvios.me/template: python-service@" "$(cat "${render_directory}/smoke-demo/catalog-info.yaml")"
expect_output "system: smoke-system" "$(cat "${render_directory}/smoke-demo/catalog-info.yaml")"
expect_output "# smoke-demo: product requirements" "$(cat "${render_directory}/smoke-demo/docs/prd.md")"

step "catalog template import idp/templates/python-service --dry-run"
# Dry run: the Backstage template has the seed's name, and applying would repoint the seed. Its
# owner, group:default/guests, is not a team here: the plan shows that error next to the steps.
output="$(expect_failure "team 'guests' not found" \
  platform catalog template import idp/templates/python-service \
    --repo https://github.com/smsilva/wasp-idp \
    --ref main \
    --dry-run)"
expect_output "publish:github: the platform creates the repo" "${output}"
expect_output "publish:github:pull-request: GitOps belongs to the release" "${output}"

step "scm connection add --no-browser (the manifest flow stops at GitHub)"
output="$(platform scm connection add "${connection}" \
  --vendor github \
  --org wasp-foundry \
  --no-browser)"
next_url="$(grep --only-matching 'http://127.0.0.1:9090/v1/scm/connections/[^ ]*' <<< "${output}")"
page="$(curl --silent --fail "${next_url}")"
expect_output 'action="https://github.com/organizations/wasp-foundry/settings/apps/new?state=' "${page}"
expect_output "default_permissions" "${page}"
status="$(curl --silent --output /dev/null --write-out '%{http_code}' \
  "http://127.0.0.1:9090/v1/scm/connections/${connection}/github/callback?code=fake&state=forged")"
if [[ "${status}" != "400" ]]; then
  echo "expected 400 for a forged state, got ${status}" >&2
  exit 1
fi
output="$(platform scm connection get "${connection}")"
expect_output "AppNotCreated" "${output}"

step "component create: every refusal happens before GitHub (#279)"
# The happy path needs a ready connection, so it stays in the manual walkthrough (Components).
expect_failure "system 'smoke-missing' not found" \
  platform catalog component create "${component}" \
    --system smoke-missing \
    --owner team-platform \
    --scm "${connection}"
expect_failure "params.colour: not a parameter of python-service" \
  platform catalog component create "${component}" \
    --system platform \
    --owner team-platform \
    --param colour=blue \
    --scm "${connection}"
# A component in the index, as the discovery would write it: the name is taken.
kubectl --context k3d-platform-local apply --filename - <<MANIFEST
apiVersion: catalog.platform.wasp.silvios.me/v1alpha1
kind: Component
metadata:
  name: ${taken_component}
  namespace: platform-system
spec:
  owner: team-platform
  system: platform
  source:
    repo: wasp-foundry/${taken_component}
MANIFEST
expect_failure "component '${taken_component}' already exists" \
  platform catalog component create "${taken_component}" \
    --system platform \
    --owner team-platform \
    --scm "${connection}"
output="$(platform catalog component list --system platform)"
expect_output "${taken_component}" "${output}"
kubectl --context k3d-platform-local --namespace platform-system delete components.catalog.platform.wasp.silvios.me "${taken_component}"
expect_failure "is not ready (AppNotCreated)" \
  platform catalog component create "${component}" \
    --system platform \
    --owner team-platform \
    --scm "${connection}"
expect_failure "not found" platform catalog component get "${component}"

step "component clone: the repo of a component in the index (#327)"
# A component in the index pointing at a public repo of the foundry: an anonymous HTTPS clone needs
# no credential.
kubectl --context k3d-platform-local apply --filename - <<MANIFEST
apiVersion: catalog.platform.wasp.silvios.me/v1alpha1
kind: Component
metadata:
  name: ${clone_component}
  namespace: platform-system
spec:
  owner: team-platform
  system: platform
  source:
    repo: wasp-foundry/details
MANIFEST
output="$(platform catalog component clone "${clone_component}" \
  --https \
  --directory "${clone_directory}/details" 2>&1)"
expect_output "# git clone https://github.com/wasp-foundry/details.git" "${output}"
test -f "${clone_directory}/details/catalog-info.yaml"
kubectl --context k3d-platform-local --namespace platform-system delete components.catalog.platform.wasp.silvios.me "${clone_component}"
expect_failure "platform catalog component list" platform catalog component clone "${component}"

step "registry add|list|get|set-default|remove: the OCI registries builds push to (ADR 0037, #365)"
# Registries of the smoke only: a GHCR of smoke-no-connection (the org of the build step below) and one
# of another org. The default of the cluster, if any, is restored at the end.
platform login --test-user
expect_failure "requires group 'platform-admins'" \
  platform registry add "${smoke_registry}" \
    --vendor ghcr \
    --namespace smoke-no-connection
platform registry list > /dev/null
platform login --test-admin
previous_default="$(platform registry list --output json | jq --raw-output '.[] | select(.default) | .name')"
if [[ -z "${previous_default}" ]]; then
  # No default in this cluster: a build without --registry is refused before the connection is looked up.
  kubectl --context k3d-platform-local apply --filename - <<MANIFEST
apiVersion: catalog.platform.wasp.silvios.me/v1alpha1
kind: Component
metadata:
  name: ${build_component}
  namespace: platform-system
spec:
  owner: team-platform
  system: platform
  source:
    repo: smoke-no-connection/${build_component}
MANIFEST
  expect_failure "NoDefaultRegistry" \
    platform build create \
      --component "${build_component}" \
      --branch main
else
  echo "the cluster has a default registry (${previous_default}): NoDefaultRegistry is not checked"
fi
output="$(platform registry add "${smoke_registry}" \
  --vendor ghcr \
  --namespace smoke-no-connection \
  --default)"
echo "${output}"
expect_output "registry ${smoke_registry} added (default) · ghcr.io/smoke-no-connection" "${output}"
platform registry add "${other_registry}" \
  --vendor ghcr \
  --namespace "${other_namespace}"
expect_failure "a ghcr registry is ghcr.io" \
  platform registry add smoke-reg-bad \
    --vendor ghcr \
    --host registry.example.com \
    --namespace acme
expect_failure "is already registry '${smoke_registry}'" \
  platform registry add smoke-reg-twice \
    --vendor ghcr \
    --namespace smoke-no-connection
# --scm-connection fills ghcr.io/<org> from the connection added above (wasp-foundry): refused here
# only when the cluster already has that address.
if platform registry list --output json | jq --exit-status '.[] | select(.address == "ghcr.io/wasp-foundry")' > /dev/null; then
  expect_failure "ghcr.io/wasp-foundry is already registry" \
    platform registry add smoke-reg-from-connection \
      --scm-connection "${connection}"
