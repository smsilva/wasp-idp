provisioners:
  - type: postgres
    mode: compose
    params:
      instance: shared-pg
  - type: postgres
    class: restored
    mode: bind
    params:
      secretRef: restored-db
      host: shared-pg.resources
      database: restored
      username: restored
POLICY
)"
echo "${output}"
expect_output "environment  postgres  restored  —   bind       database=restored, host=shared-pg.resources, secretRef=restored-db, username=restored" "${output}"
