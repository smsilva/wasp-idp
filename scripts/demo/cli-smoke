# developer never sees the credential. remove takes only the copy of the Secret: the database stays.
shared_psql() {
  kubectl --context k3d-platform-local --namespace platform-resources exec statefulset/shared-pg -- \
    psql \
      --username postgres \
      --tuples-only \
      --no-align \
      --command "${1?}"
}
