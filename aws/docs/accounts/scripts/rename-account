#!/bin/bash
this_script_path="$(realpath ${0})"
this_script_name="${this_script_path##*/}"
this_script_directory="${this_script_path%/*}"

PATH="${this_script_directory}:${PATH}"

show_usage() {
  cat <<EOF

  Renames an Organization member account (Account Management API
  'put-account-name'), rodando a partir da management account.

  Idempotent: if the account already has the requested name, it does nothing.

    Options:

      -h,  --help              Show this help
      -n,  --name              CURRENT account name (required if --account-id is absent)
      -i,  --account-id        Account id (alternative to --name)
           --new-name          New account name (required)

  Prerequisite: Account Management trusted access enabled in the Organization —
  ${this_script_directory}/enable-service-access --service account.amazonaws.com

  Only the NAME changes. The root user email (which is the account unique identity across
  all of AWS) is NOT changed here, so a renamed account keeps the old
  address — changing it requires the root user flow, in the account own console.

    Examples:

      ${this_script_name} --name sandbox --new-name wasp-nonprod

      ${this_script_name} --account-id 123456789012 --new-name wasp-nonprod
EOF
}

name=""
account_id=""
new_name=""

while [[ "${1}" =~ ^- && ! "${1}" == "--" ]]; do
  case $1 in
    -h | --help )
      show_usage
      exit 1
      ;;

    -n | --name )
      shift
      name="${1}"
      ;;

    -i | --account-id )
      shift
      account_id="${1}"
      ;;

    --new-name )
      shift
      new_name="${1}"
      ;;

    * )
      echo "Invalid option: ${1}"
      show_usage
      exit 1
      ;;
  esac
  shift
done

if [ -z "${new_name}" ] || { [ -z "${name}" ] && [ -z "${account_id}" ]; }; then
  echo "Faltam argumentos: --new-name e (--name ou --account-id)." >&2
  show_usage
  exit 1
fi

set -e

check

if [ -z "${account_id}" ]; then
  account_id="$(aws organizations list-accounts \
    --query "Accounts[?Name=='${name}' && Status=='ACTIVE'].Id" --output text)"

  if [ -z "${account_id}" ]; then
    echo "No ACTIVE account named '${name}' in the Organization." >&2
    exit 1
  fi
fi

current_name="$(aws organizations describe-account --account-id "${account_id}" \
  --query Account.Name --output text)"

if [ "${current_name}" == "${new_name}" ]; then
  echo "ok  account ${account_id} is already named '${new_name}' — nothing to do."
  exit 0
fi

service_enabled="$(aws organizations list-aws-service-access-for-organization \
  --query "EnabledServicePrincipals[?ServicePrincipal=='account.amazonaws.com'].ServicePrincipal" \
  --output text)"

if [ -z "${service_enabled}" ]; then
  echo "Account Management trusted access is not enabled — run this first:" >&2
  echo "  ${this_script_directory}/enable-service-access --service account.amazonaws.com" >&2
  exit 1
fi

echo "Renaming account ${account_id}: '${current_name}' -> '${new_name}'..."
aws account put-account-name --account-id "${account_id}" --account-name "${new_name}"
echo "renomeada  ${account_id} = ${new_name}"
