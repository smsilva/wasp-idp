#!/bin/bash
this_script_path="$(realpath ${0})"
this_script_name="${this_script_path##*/}"
this_script_directory="${this_script_path%/*}"

PATH="${this_script_directory}:${PATH}"

show_usage() {
  cat <<EOF

  Enables AWS Organizations on the current account with feature-set ALL (a prerequisite for
  SCPs — ver aws/docs/accounts/01-organizations-and-ous.md). Idempotente: se a
  the Organization already exists, it only validates the feature-set and recreates nothing.

  The account you run this in becomes the MANAGEMENT ACCOUNT — it must never host
  workload depois disso (ver aws/docs/accounts/00-strategy.md).

    Options:

      -h,  --help    Show this help

    Examples:

      ${this_script_name}
EOF
}

while [[ "${1}" =~ ^- && ! "${1}" == "--" ]]; do
  case $1 in
    -h | --help )
      show_usage
      exit 1
      ;;

    * )
      echo "Invalid option: ${1}"
      show_usage
      exit 1
      ;;
  esac
  shift
done

set -e

check

existing_feature_set="$(aws organizations describe-organization --query Organization.FeatureSet --output text 2> /dev/null || true)"

if [ -n "${existing_feature_set}" ]; then
  if [ "${existing_feature_set}" == "ALL" ]; then
    echo "Organization already exists with feature-set=ALL — nothing to do."
    exit 0
  fi
  echo "Organization exists with feature-set=${existing_feature_set}. Upgrading to ALL..."
  aws organizations enable-all-features
  echo "Upgrade solicitado — cada conta-membro existente precisa aceitar (ver AWS Organizations console)."
  exit 0
fi

echo "Creating Organization with feature-set=ALL on the current account (it becomes the management account)..."
aws organizations create-organization --feature-set ALL

echo "Organization created. Next step: ${this_script_directory}/create-organizational-unit-structure"