#!/bin/bash
# Valida binários e credenciais AWS antes de qualquer bootstrap de Organization.
set -e

missing=0
for tool in aws jq; do
  if command -v "${tool}" > /dev/null 2>&1; then
    echo "ok  ${tool} -> $(command -v "${tool}")"
  else
    echo "MISSING ${tool}"
    missing=1
  fi
done

if [ "${missing}" -ne 0 ]; then
  echo "Instale os binários ausentes antes de prosseguir." >&2
  exit 1
fi

caller_arn="$(aws sts get-caller-identity --query Arn --output text 2> /dev/null || true)"
if [ -z "${caller_arn}" ]; then
  echo "Credenciais AWS inválidas — rode 'aws sso login' ou exporte AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY." >&2
  exit 1
fi
echo "ok  credenciais AWS válidas (${caller_arn})"

feature_set="$(aws organizations describe-organization --query Organization.FeatureSet --output text 2> /dev/null || true)"
if [ -z "${feature_set}" ]; then
  echo "info  nenhuma Organization associada a esta conta ainda — rode ./enable-organization"
elif [ "${feature_set}" != "ALL" ]; then
  echo "AVISO  Organization existe mas feature-set='${feature_set}' (esperado ALL) — SCPs não funcionarão." >&2
else
  echo "ok  Organization já habilitada com feature-set=ALL"
fi