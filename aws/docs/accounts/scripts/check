#!/bin/bash
# Validates binaries and AWS credentials before any Organization bootstrap.
set -e

missing=0
for tool in aws jq; do
  if command -v "${tool}" > /dev/null 2>&1; then
    echo "ok  ${tool} -> $(command -v "${tool}")"
  else
    echo "MISSING ${tool}"
    missing=1
  fi
done

if [ "${missing}" -ne 0 ]; then
  echo "Install the missing binaries before going on." >&2
  exit 1
fi

caller_arn="$(aws sts get-caller-identity --query Arn --output text 2> /dev/null || true)"
if [ -z "${caller_arn}" ]; then
  echo "Invalid AWS credentials — run 'aws sso login' or export AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY." >&2
  exit 1
fi
echo "ok  AWS credentials valid (${caller_arn})"

feature_set="$(aws organizations describe-organization --query Organization.FeatureSet --output text 2> /dev/null || true)"
if [ -z "${feature_set}" ]; then
  echo "info  no Organization associated with this account yet — run ./enable-organization"
elif [ "${feature_set}" != "ALL" ]; then
  echo "WARNING  Organization exists but feature-set='${feature_set}' (expected ALL) — SCPs will not work." >&2
else
  echo "ok  Organization already enabled with feature-set=ALL"
fi