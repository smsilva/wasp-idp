#!/bin/bash
this_script_path="$(realpath ${0})"
this_script_name="${this_script_path##*/}"
this_script_directory="${this_script_path%/*}"

PATH="${this_script_directory}:${PATH}"

show_usage() {
  cat <<EOF

  Creates (or reuses) an IAM Identity Center permission set and assigns it to a
  user/group on a member account — the step that makes the account show up in the SSO
  portal and in 'aws sso login' (see aws/docs/accounts/04-cross-account-access.md).

  Idempotent: reuses an existing permission set and an existing assignment.

    Options:

      -h,  --help              Show this help
      -a,  --account           Member account name or id (required)
      -p,  --permission-set    Permission set name (default: AdministratorAccess)
           --managed-policy    Managed policy ARN attached when creating the permission set
                                (default: arn:aws:iam::aws:policy/AdministratorAccess)
      -u,  --user              Identity Store username (required if --group is absent)
      -g,  --group             Identity Store group name (alternative to --user)
           --create-group      Create --group if it does not exist yet
      -m,  --member            Username added to --group (repeatable; implies
                                --create-group)
           --session-duration  Session duration, ISO-8601 (default: PT4H)

  Prerequisite: IAM Identity Center enabled on the management account (console only —
  there is no API to enable the instance).

  Prefer --group over --user: the assignment survives people joining and leaving a team.

    Examples:

      ${this_script_name} --account log-archive --user silvios

      ${this_script_name} --account wasp-nonprod --group platform-admins \\
        --create-group --member silvios

      ${this_script_name} --account network --group network-engineers \\
        --permission-set NetworkEngineer \\
        --managed-policy arn:aws:iam::aws:policy/job-function/NetworkAdministrator
EOF
}

account=""
permission_set="AdministratorAccess"
managed_policy="arn:aws:iam::aws:policy/AdministratorAccess"
user=""
group=""
create_group=""
members=()
session_duration="PT4H"

while [[ "${1}" =~ ^- && ! "${1}" == "--" ]]; do
  case $1 in
    -h | --help )
      show_usage
      exit 1
      ;;

    -a | --account )
      shift
      account="${1}"
      ;;

    -p | --permission-set )
      shift
      permission_set="${1}"
      ;;

    --managed-policy )
      shift
      managed_policy="${1}"
      ;;

    -u | --user )
      shift
      user="${1}"
      ;;

    -g | --group )
      shift
      group="${1}"
      ;;

    --create-group )
      create_group="yes"
      ;;

    -m | --member )
      shift
      members+=("${1}")
      create_group="yes"
      ;;

    --session-duration )
      shift
      session_duration="${1}"
      ;;

    * )
      echo "Invalid option: ${1}"
      show_usage
      exit 1
      ;;
  esac
  shift
done

if [ -z "${account}" ] || { [ -z "${user}" ] && [ -z "${group}" ]; }; then
  echo "Faltam argumentos: --account e (--user ou --group)." >&2
  show_usage
  exit 1
fi

set -e

check

instance_json="$(aws sso-admin list-instances --query 'Instances[0]' --output json)"
instance_arn="$(echo "${instance_json}" | jq -r '.InstanceArn // empty')"
identity_store_id="$(echo "${instance_json}" | jq -r '.IdentityStoreId // empty')"

if [ -z "${instance_arn}" ]; then
  echo "No IAM Identity Center instance in this Organization." >&2
  echo "Enable it in the console (management account -> IAM Identity Center -> Enable)." >&2
  exit 1
fi
echo "ok  Identity Center ${instance_arn} (identity store ${identity_store_id})"

# --- target account -----------------------------------------------------------
if [[ "${account}" =~ ^[0-9]{12}$ ]]; then
  account_id="${account}"
else
  account_id="$(aws organizations list-accounts \
    --query "Accounts[?Name=='${account}' && Status=='ACTIVE'].Id" --output text)"

  if [ -z "${account_id}" ]; then
    echo "No ACTIVE account named '${account}' in the Organization." >&2
    exit 1
  fi
fi
echo "ok  target account ${account} = ${account_id}"

# --- permission set -----------------------------------------------------------
permission_set_arn=""
for arn in $(aws sso-admin list-permission-sets --instance-arn "${instance_arn}" \
  --query 'PermissionSets[]' --output text); do
  arn_name="$(aws sso-admin describe-permission-set --instance-arn "${instance_arn}" \
    --permission-set-arn "${arn}" --query PermissionSet.Name --output text)"

  if [ "${arn_name}" == "${permission_set}" ]; then
    permission_set_arn="${arn}"
    break
  fi
done

if [ -n "${permission_set_arn}" ]; then
  echo "ok  permission set '${permission_set}' already exists (${permission_set_arn})"
else
  permission_set_arn="$(aws sso-admin create-permission-set \
    --instance-arn "${instance_arn}" \
    --name "${permission_set}" \
    --description "${permission_set} (created by ${this_script_name})" \
    --session-duration "${session_duration}" \
    --query PermissionSet.PermissionSetArn --output text)"
  echo "created  permission set '${permission_set}' (${permission_set_arn})"
fi

# Outside the else on purpose: if the attach fails (an invalid ARN, say), the permission
# set already exists and a rerun has to be able to fix it — inside the else the script
# would skip the attach forever, leaving an orphan permission set with no policy at all.
attached="$(aws sso-admin list-managed-policies-in-permission-set \
  --instance-arn "${instance_arn}" --permission-set-arn "${permission_set_arn}" \
  --query "AttachedManagedPolicies[?Arn=='${managed_policy}'].Arn" --output text)"

if [ -n "${attached}" ]; then
  echo "ok  managed policy ${managed_policy} already attached"
else
  aws sso-admin attach-managed-policy-to-permission-set \
    --instance-arn "${instance_arn}" \
    --permission-set-arn "${permission_set_arn}" \
    --managed-policy-arn "${managed_policy}"
  echo "attached  managed policy ${managed_policy}"

  # A changed permission set must be reprovisioned on the accounts where it is assigned.
  for provisioned_account in $(aws sso-admin list-accounts-for-provisioned-permission-set \
    --instance-arn "${instance_arn}" --permission-set-arn "${permission_set_arn}" \
    --query 'AccountIds[]' --output text); do
    aws sso-admin provision-permission-set \
      --instance-arn "${instance_arn}" \
      --permission-set-arn "${permission_set_arn}" \
      --target-id "${provisioned_account}" --target-type AWS_ACCOUNT > /dev/null
    echo "reprovisioned  on ${provisioned_account}"
  done
fi

# --- principal ----------------------------------------------------------------
find_user_id() {
  aws identitystore list-users \
    --identity-store-id "${identity_store_id}" \
    --filters "AttributePath=UserName,AttributeValue=${1}" \
    --query 'Users[0].UserId' --output text 2> /dev/null || true
}

if [ -n "${group}" ]; then
  principal_type="GROUP"
  principal_id="$(aws identitystore list-groups \
    --identity-store-id "${identity_store_id}" \
    --filters "AttributePath=DisplayName,AttributeValue=${group}" \
    --query 'Groups[0].GroupId' --output text 2> /dev/null || true)"
  principal_label="grupo '${group}'"

  if { [ -z "${principal_id}" ] || [ "${principal_id}" == "None" ]; } && [ -n "${create_group}" ]; then
    principal_id="$(aws identitystore create-group \
      --identity-store-id "${identity_store_id}" \
      --display-name "${group}" \
      --description "${group} (criado por ${this_script_name})" \
      --query GroupId --output text)"
    echo "created  ${principal_label} (${principal_id})"
  fi

  for member in "${members[@]}"; do
    member_id="$(find_user_id "${member}")"

    if [ -z "${member_id}" ] || [ "${member_id}" == "None" ]; then
      echo "user '${member}' not found in the Identity Store — not added to the group." >&2
      exit 1
    fi

    existing_membership="$(aws identitystore get-group-membership-id \
      --identity-store-id "${identity_store_id}" \
      --group-id "${principal_id}" \
      --member-id "UserId=${member_id}" \
      --query MembershipId --output text 2> /dev/null || true)"

    if [ -n "${existing_membership}" ] && [ "${existing_membership}" != "None" ]; then
      echo "ok  '${member}' is already a member of ${principal_label}"
      continue
    fi

    aws identitystore create-group-membership \
      --identity-store-id "${identity_store_id}" \
      --group-id "${principal_id}" \
      --member-id "UserId=${member_id}" > /dev/null
    echo "added  '${member}' -> ${principal_label}"
  done
else
  principal_type="USER"
  principal_id="$(find_user_id "${user}")"
  principal_label="user '${user}'"
fi

if [ -z "${principal_id}" ] || [ "${principal_id}" == "None" ]; then
  echo "${principal_label} not found in Identity Store ${identity_store_id}." >&2
  exit 1
fi
echo "ok  ${principal_label} = ${principal_id}"

# --- assignment ---------------------------------------------------------------
existing="$(aws sso-admin list-account-assignments \
  --instance-arn "${instance_arn}" \
  --account-id "${account_id}" \
  --permission-set-arn "${permission_set_arn}" \
  --query "AccountAssignments[?PrincipalId=='${principal_id}'].PrincipalId" --output text)"

if [ -n "${existing}" ]; then
  echo "ok  the assignment already exists — nothing to do."
  exit 0
fi

request_id="$(aws sso-admin create-account-assignment \
  --instance-arn "${instance_arn}" \
  --target-id "${account_id}" --target-type AWS_ACCOUNT \
  --permission-set-arn "${permission_set_arn}" \
  --principal-type "${principal_type}" --principal-id "${principal_id}" \
  --query AccountAssignmentCreationStatus.RequestId --output text)"

echo "Waiting for the assignment to propagate (request ${request_id})..."
for _ in $(seq 1 30); do
  status="$(aws sso-admin describe-account-assignment-creation-status \
    --instance-arn "${instance_arn}" --account-assignment-creation-request-id "${request_id}" \
    --query AccountAssignmentCreationStatus.Status --output text)"

  if [ "${status}" == "SUCCEEDED" ]; then
    echo "assigned  ${permission_set} -> ${account} (${account_id}) to ${principal_label}"
    echo
    echo "Run 'aws sso login' again for the account to show up in the portal/CLI."
    exit 0
  fi

  if [ "${status}" == "FAILED" ]; then
    aws sso-admin describe-account-assignment-creation-status \
      --instance-arn "${instance_arn}" --account-assignment-creation-request-id "${request_id}" \
      --query AccountAssignmentCreationStatus.FailureReason --output text >&2
    exit 1
  fi

  sleep 5
done

echo "The assignment did not finish in time — check the Identity Center console." >&2
exit 1
