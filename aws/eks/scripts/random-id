#!/bin/bash
# Generates a short random identifier (a-z0-9), used as the metadata.name of an XR
# (Network/Cluster). Default 5 chars, interleaved (e.g. ha13c, wv32g, x4rt1). Same random-suffix
# technique as ~/.scripts/random-name (fold over a filtered /dev/urandom).
length="${1:-5}"

tr --delete --complement 'a-z0-9' < /dev/urandom \
  | fold --width "${length?}" \
  | head --lines 1
