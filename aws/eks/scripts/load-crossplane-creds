#!/bin/bash
# WARNING: SOURCE this, do not execute it — the credentials have to end up exported in
# the calling shell (configure-aws-creds/provision-eks/teardown run afterwards, as
# separate commands in the same session; a subprocess cannot export env to its parent).
#
#   source aws/eks/scripts/load-crossplane-creds
#
# Key source: Secrets Manager (poc-idp/crossplane-poc-credentials, us-east-1) — never a
# local file. Same pattern documented in aws/CLAUDE.md ("Operacao: credenciais AWS via
# CLI"): retrieve inline, in process memory, never persist to disk and never print the
# keys. Prerequisite: active admin access to the account hosting the secret, for the
# bootstrap get-secret-value.
#
# Override (rare — another account/secret): export CROSSPLANE_SECRET_ID/
# CROSSPLANE_SECRET_REGION before sourcing.

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  echo "Error: run via 'source ${BASH_SOURCE[0]}', do not execute it directly — the" >&2
  echo "credentials have to end up exported in the calling shell." >&2
  exit 1
fi

secret_id="${CROSSPLANE_SECRET_ID:-poc-idp/crossplane-poc-credentials}"
secret_region="${CROSSPLANE_SECRET_REGION:-us-east-1}"

# Explicit assignment (not `source <(... | jq ...)`): the secret key never goes through
# shell interpretation as a command, only as a string value — even if it contains
# metacharacters. The JSON stays in process memory only, never in a file.
_secret_json="$(aws secretsmanager get-secret-value \
  --secret-id "${secret_id}" --region "${secret_region}" \
  --query SecretString --output text)"

export AWS_ACCESS_KEY_ID
AWS_ACCESS_KEY_ID="$(printf '%s' "${_secret_json}" | jq -r '.aws_access_key_id')"
export AWS_SECRET_ACCESS_KEY
AWS_SECRET_ACCESS_KEY="$(printf '%s' "${_secret_json}" | jq -r '.aws_secret_access_key')"
unset _secret_json

export AWS_DEFAULT_REGION="${secret_region}"
unset AWS_PROFILE AWS_SESSION_TOKEN

echo "Crossplane creds loaded (AWS_ACCESS_KEY_ID=${AWS_ACCESS_KEY_ID:0:4}…, region ${AWS_DEFAULT_REGION})"
