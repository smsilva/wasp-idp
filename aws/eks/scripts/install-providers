#!/bin/bash
this_script_path="$(realpath ${0})"
this_script_name="${this_script_path##*/}"
this_script_directory="${this_script_path%/*}"

PATH="${this_script_directory}:${PATH}"

show_usage() {
  cat <<EOF

  Instala os providers do Crossplane (5 AWS v2.5.1 + helm/kubernetes da fatia 2) e
  espera Healthy.

    Options:

      -h,  --help              Show this help
      -c,  --cluster-name      Nome do cluster k3d (default: poc-idp)
      -t,  --timeout           Timeout de espera por provider (default: 300s)

    Examples:

      ${this_script_name}

      ${this_script_name} \\
        --cluster-name poc-idp \\
        --timeout 300s
EOF
}

while [[ "${1}" =~ ^- && ! "${1}" == "--" ]]; do
  case $1 in
    -h | --help )
      show_usage
      exit 1
      ;;

    -c | --cluster-name )
      shift
      cluster_name="${1}"
      ;;

    -t | --timeout )
      shift
      timeout="${1}"
      ;;

    * )
      echo "Invalid option: ${1}"
      show_usage
      exit 1
      ;;

  esac
  shift
done

if [[ "${1}" == '--' ]]; then shift; fi

cluster_name="${cluster_name:-poc-idp}"
timeout="${timeout:-300s}"

set -e

context="k3d-${cluster_name}"

kubectl --context "${context}" apply -f "${this_script_directory}/../providers/providers-aws.yaml"

for provider in \
  upbound-provider-family-aws \
  upbound-provider-aws-vpc \
  upbound-provider-aws-ec2 \
  upbound-provider-aws-iam \
  upbound-provider-aws-eks \
  upbound-provider-aws-route53 \
  upbound-provider-helm \
  upbound-provider-kubernetes; do
  kubectl --context "${context}" wait "provider/${provider}" \
    --for=condition=Healthy \
    --timeout="${timeout}"
done

kubectl --context "${context}" get providers
