#!/bin/bash
# Validates binaries and AWS credentials before any provisioning.
set -e

missing=0
for tool in k3d kubectl helm aws; do
  if command -v "${tool}" > /dev/null 2>&1; then
    echo "ok  ${tool} -> $(command -v "${tool}")"
  else
    echo "MISSING ${tool}"
    missing=1
  fi
done

if [ "${missing}" -ne 0 ]; then
  echo "Install the missing binaries before going on." >&2
  exit 1
fi

if aws sts get-caller-identity --query Arn --output text; then
  echo "ok  AWS credentials valid"
else
  echo "Invalid AWS credentials — export AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY." >&2
  exit 1
fi
