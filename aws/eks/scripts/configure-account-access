#!/bin/bash
this_script_path="$(realpath ${0})"
this_script_name="${this_script_path##*/}"
this_script_directory="${this_script_path%/*}"

PATH="${this_script_directory}:${PATH}"

show_usage() {
  cat <<EOF

  Applies a cross-account (spoke) ProviderConfig to k3d, resolving the account id via
  envsubst. It does NOT create a credential: it reuses the aws-iam-credential Secret
  (assumeRoleChain starts from it). The "network" ProviderConfig (direct credential) is
  applied by configure-aws-creds, not here.

  Reads the providers/provider-config-<name>.yaml template and substitutes
  \${SPOKE_ACCOUNT_ID}.

    Options:

      -h,  --help              Show this help
      -n,  --name              ProviderConfig/spoke name (e.g. wasp-nonprod) [required]
      -a,  --account-id        Spoke account id (12 digits)                 [required]
      -c,  --cluster-name      k3d cluster name (default: control-plane)

    Examples:

      ${this_script_name} --name wasp-nonprod --account-id 832721568602
EOF
}

while [[ "${1}" =~ ^- && ! "${1}" == "--" ]]; do
  case $1 in
    -h | --help )
      show_usage
      exit 1
      ;;

    -n | --name )
      shift
      name="${1}"
      ;;

    -a | --account-id )
      shift
      account_id="${1}"
      ;;

    -c | --cluster-name )
      shift
      cluster_name="${1}"
      ;;

    * )
      echo "Invalid option: ${1}"
      show_usage
      exit 1
      ;;

  esac
  shift
done

if [[ "${1}" == '--' ]]; then shift; fi

cluster_name="${cluster_name:-control-plane}"

: "${name?pass --name (e.g. wasp-nonprod)}"
: "${account_id?pass --account-id (12 digits of the spoke account)}"

if [[ ! "${account_id}" =~ ^[0-9]{12}$ ]]; then
  echo "invalid account-id: '${account_id}' (expected 12 digits)" >&2
  exit 1
fi

set -e

context="k3d-${cluster_name}"
template="${this_script_directory}/../providers/provider-config-${name}.yaml"

if [[ ! -f "${template}" ]]; then
  echo "template not found: ${template}" >&2
  exit 1
fi

echo "Applying ProviderConfig '${name}' (assumeRoleChain → account ${account_id})"

SPOKE_ACCOUNT_ID="${account_id}" \
  envsubst '${SPOKE_ACCOUNT_ID}' < "${template}" \
  | kubectl --context "${context}" apply -f -
