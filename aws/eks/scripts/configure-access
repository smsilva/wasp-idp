#!/bin/bash
this_script_path="$(realpath ${0})"
this_script_name="${this_script_path##*/}"
this_script_directory="${this_script_path%/*}"

PATH="${this_script_directory}:${PATH}"

show_usage() {
  cat <<EOF

  Grants admin access to the caller (AccessEntry + AccessPolicyAssociation), updates the
  EKS kubeconfig and validates 'kubectl get nodes'. Closes the walk skeleton.

  WARNING: 'aws eks update-kubeconfig' CHANGES the active kubectl context to the EKS one.
  At the end the script switches the context back to k3d-control-plane.

    Options:

      -h,  --help              Show this help
      -c,  --cluster-name      k3d cluster name (default: control-plane)
      -i,  --cluster-id        clusterId (default: reads aws/eks/.cluster-id)

    Examples:

      ${this_script_name}

      ${this_script_name} \\
        --cluster-id smoke1
EOF
}

while [[ "${1}" =~ ^- && ! "${1}" == "--" ]]; do
  case $1 in
    -h | --help )
      show_usage
      exit 1
      ;;

    -c | --cluster-name )
      shift
      cluster_name="${1}"
      ;;

    -i | --cluster-id )
      shift
      cluster_id="${1}"
      ;;

    * )
      echo "Invalid option: ${1}"
      show_usage
      exit 1
      ;;

  esac
  shift
done

if [[ "${1}" == '--' ]]; then shift; fi

cluster_name="${cluster_name:-control-plane}"

set -e

context="k3d-${cluster_name}"
chart_dir="${this_script_directory}/../chart"
id_file="${this_script_directory}/../.cluster-id"

if [ -z "${cluster_id}" ]; then
  if [ ! -f "${id_file}" ]; then
    echo "Sem ${id_file} e sem --cluster-id — rode provision-eks antes (ou passe --cluster-id)." >&2
    exit 1
  fi
  cluster_id="$(cat "${id_file}")"
fi

full="poc-eks-${cluster_id}"

# The AccessEntry principalArn must be the ROLE ARN, NOT the STS session ARN.
# `aws sts get-caller-identity` on an SSO session returns
#   arn:aws:sts::ACCT:assumed-role/ROLE_NAME/SESSION
# but the EKS AccessEntry requires the IAM role ARN (with the SSO path):
#   arn:aws:iam::ACCT:role/aws-reserved/sso.amazonaws.com/REGION/ROLE_NAME
# We derive the role via `iam get-role` from the ROLE_NAME extracted from the session.
session_arn="$(aws sts get-caller-identity --query Arn --output text)"
case "${session_arn}" in
  *:assumed-role/*)
    role_name="$(echo "${session_arn}" | sed -E 's#.*:assumed-role/([^/]+)/.*#\1#')"
    caller_arn="$(aws iam get-role --role-name "${role_name}" --query Role.Arn --output text)"
    ;;
  *)
    # Already a direct IAM role/user ARN (not assumed-role) — use it as is.
    caller_arn="${session_arn}"
    ;;
esac

region="$(kubectl --context "${context}" get cluster.eks.aws.upbound.io/"${full}" \
  -o jsonpath='{.spec.forProvider.region}')"

echo "Granting admin access to ${caller_arn}"
echo "  cluster ${full} (region ${region})"

# crossplaneArn=unused satisfies the `fail` guard in 72-cluster-auth (helm evaluates ALL
# templates before --show-only). Phase 70 does not reference crossplaneArn and 72 is never
# emitted here — the placeholder never reaches the cluster (symmetric to the
# callerArn=unused in provision-eks).
helm template "${chart_dir}" \
  --set "clusterId=${cluster_id}" \
  --set "callerArn=${caller_arn}" \
  --set "crossplaneArn=unused" \
  --show-only templates/70-access.yaml \
  | kubectl --context "${context}" apply -f -

kubectl --context "${context}" wait "accessentry.eks.aws.upbound.io/${full}-access-entry" \
  --for=condition=Ready --timeout=120s
kubectl --context "${context}" wait "accesspolicyassociation.eks.aws.upbound.io/${full}-access-admin" \
  --for=condition=Ready --timeout=120s

# Updates the local kubeconfig — THIS CHANGES the active context to the EKS one.
aws eks update-kubeconfig --region "${region}" --name "${full}"

echo "Validation — EKS nodes:"
kubectl get nodes

# Switch the context back to k3d (avoids driving Crossplane while pointed at EKS).
kubectl config use-context "${context}"
echo "Contexto de volta em ${context}."
