#!/bin/bash
this_script_path="$(realpath ${0})"
this_script_name="${this_script_path##*/}"
this_script_directory="${this_script_path%/*}"

PATH="${this_script_directory}:${PATH}"

show_usage() {
  cat <<EOF

  Concede acesso admin ao caller (AccessEntry + AccessPolicyAssociation), atualiza o
  kubeconfig do EKS e valida 'kubectl get nodes'. Fecha o walk skeleton.

  ATENÇÃO: 'aws eks update-kubeconfig' MUDA o contexto kubectl ativo para o EKS.
  Ao final o script volta o contexto para k3d-poc-idp.

    Options:

      -h,  --help              Show this help
      -c,  --cluster-name      Nome do cluster k3d (default: poc-idp)
      -i,  --cluster-id        clusterId (default: lê aws/eks/.cluster-id)

    Examples:

      ${this_script_name}

      ${this_script_name} \\
        --cluster-id smoke1
EOF
}

while [[ "${1}" =~ ^- && ! "${1}" == "--" ]]; do
  case $1 in
    -h | --help )
      show_usage
      exit 1
      ;;

    -c | --cluster-name )
      shift
      cluster_name="${1}"
      ;;

    -i | --cluster-id )
      shift
      cluster_id="${1}"
      ;;

    * )
      echo "Invalid option: ${1}"
      show_usage
      exit 1
      ;;

  esac
  shift
done

if [[ "${1}" == '--' ]]; then shift; fi

cluster_name="${cluster_name:-poc-idp}"

set -e

context="k3d-${cluster_name}"
chart_dir="${this_script_directory}/../chart"
id_file="${this_script_directory}/../.cluster-id"

if [ -z "${cluster_id}" ]; then
  if [ ! -f "${id_file}" ]; then
    echo "Sem ${id_file} e sem --cluster-id — rode provision-eks antes (ou passe --cluster-id)." >&2
    exit 1
  fi
  cluster_id="$(cat "${id_file}")"
fi

full="poc-eks-${cluster_id}"

# principalArn do AccessEntry precisa ser o ARN da ROLE, NÃO o ARN de sessão STS.
# `aws sts get-caller-identity` de uma sessão SSO retorna
#   arn:aws:sts::ACCT:assumed-role/ROLE_NAME/SESSION
# mas o EKS AccessEntry exige o ARN da role IAM (com o path SSO):
#   arn:aws:iam::ACCT:role/aws-reserved/sso.amazonaws.com/REGION/ROLE_NAME
# Derivamos a role via `iam get-role` a partir do ROLE_NAME extraído da sessão.
session_arn="$(aws sts get-caller-identity --query Arn --output text)"
case "${session_arn}" in
  *:assumed-role/*)
    role_name="$(echo "${session_arn}" | sed -E 's#.*:assumed-role/([^/]+)/.*#\1#')"
    caller_arn="$(aws iam get-role --role-name "${role_name}" --query Role.Arn --output text)"
    ;;
  *)
    # Já é um ARN de role/user IAM direto (não assumed-role) — usa como veio.
    caller_arn="${session_arn}"
    ;;
esac

region="$(kubectl --context "${context}" get cluster.eks.aws.upbound.io/"${full}" \
  -o jsonpath='{.spec.forProvider.region}')"

echo "Concedendo acesso admin a ${caller_arn}"
echo "  cluster ${full} (region ${region})"

# crossplaneArn=unused satisfaz o guard `fail` de 72-cluster-auth (helm avalia TODOS os
# templates antes de --show-only). A fase 70 não referencia crossplaneArn e 72 nunca é
# emitido aqui — o placeholder jamais chega ao cluster (simétrico ao callerArn=unused do
# provision-eks).
helm template "${chart_dir}" \
  --set "clusterId=${cluster_id}" \
  --set "callerArn=${caller_arn}" \
  --set "crossplaneArn=unused" \
  --show-only templates/70-access.yaml \
  | kubectl --context "${context}" apply -f -

kubectl --context "${context}" wait "accessentry.eks.aws.upbound.io/${full}-access-entry" \
  --for=condition=Ready --timeout=120s
kubectl --context "${context}" wait "accesspolicyassociation.eks.aws.upbound.io/${full}-access-admin" \
  --for=condition=Ready --timeout=120s

# Atualiza o kubeconfig local — ISSO MUDA o contexto ativo para o EKS.
aws eks update-kubeconfig --region "${region}" --name "${full}"

echo "Validação — nós do EKS:"
kubectl get nodes

# Volta o contexto para o k3d (evita operar o Crossplane apontando para o EKS).
kubectl config use-context "${context}"
echo "Contexto de volta em ${context}."
