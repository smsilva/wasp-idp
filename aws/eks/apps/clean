#!/bin/bash
this_script_path="$(realpath ${0})"
this_script_name="${this_script_path##*/}"
this_script_directory="${this_script_path%/*}"

PATH="${this_script_directory}:${PATH}"

show_usage() {
  cat <<EOF

  Remove uma aplicação da fatia 2 instalada pelo 'deploy' (helm uninstall). NÃO toca
  na plataforma (istio/cert-manager/external-dns/LB Controller) nem no cluster — só
  desfaz o que o 'deploy <app>' criou.

  O external-dns roda com policy=upsert-only: ele NÃO deleta o A/TXT do host ao
  remover o Ingress-fantasma. O registro DNS órfão na zona compartilhada é esperado;
  limpar à mão só com autorização p/ mexer na zona (ver README, seção de apps).

    Options:

      -h,  --help              Show this help
      -i,  --cluster-id        clusterId (default: lê aws/eks/.cluster-id)
      -c,  --context           contexto kubectl do EKS (default: ARN produzido por
                                'configure-access' — ver aws/eks/apps/deploy)
      -r,  --region            região AWS do cluster (default: us-east-1) — usada só
                                para derivar o contexto default (ARN), se --context
                                não for passado

    Examples:

      ${this_script_name} echo
EOF
}

region="us-east-1"

# App e opções em QUALQUER ordem (mesmo parsing do apps/deploy — o loop antigo exigia
# opções ANTES do app; ver histórico do apps/deploy para o porquê).
while [[ $# -gt 0 ]]; do
  case "${1}" in
    -h | --help )
      show_usage
      exit 1
      ;;

    -i | --cluster-id )
      shift
      cluster_id="${1}"
      ;;

    -c | --context )
      shift
      context="${1}"
      ;;

    -r | --region )
      shift
      region="${1}"
      ;;

    -- )
      ;;

    -* )
      echo "Invalid option: ${1}"
      show_usage
      exit 1
      ;;

    * )
      app="${1}"
      ;;
  esac
  shift
done

app="${app:?informe a app a remover (ex.: ${this_script_name} echo)}"

set -e

id_file="${this_script_directory}/../.cluster-id"

if [ -z "${cluster_id}" ]; then
  if [ ! -f "${id_file}" ]; then
    echo "Sem ${id_file} e sem --cluster-id." >&2
    exit 1
  fi
  cluster_id="$(cat "${id_file}")"
fi

full="poc-eks-${cluster_id}"

# Mesmo default do apps/deploy: a ARN que 'aws eks update-kubeconfig' grava por padrão
# (sem --alias) — "poc-eks-<id>" sozinho não existe como contexto neste fluxo.
if [ -z "${context}" ]; then
  account_id="$(aws sts get-caller-identity --query Account --output text)"
  context="arn:aws:eks:${region}:${account_id}:cluster/${full}"
fi

echo "Removendo '${app}' do contexto ${context} (helm uninstall)..."
helm --kube-context "${context}" uninstall "${app}"

echo
echo "Feito. A plataforma permanece intacta."
echo "Lembrete: o A/TXT de DNS do host NÃO é removido (external-dns upsert-only) — ver README."
