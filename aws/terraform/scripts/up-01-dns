#!/bin/bash
this_script_path="$(realpath ${0})"
this_script_name="${this_script_path##*/}"
this_script_directory="${this_script_path%/*}"

PATH="${this_script_directory}:${PATH}"

source "${this_script_directory}/lib"

show_usage() {
  cat <<EOF

  Layer 1 — delegated DNS subzone. Creates the <label>.<base-domain> hosted
  zone in Route 53 in the network account, plus the delegating NS record in
  the PARENT zone, which lives in Azure DNS. The apex does not move.

  Tier T0: ~US\$ 0.50/month, prevent_destroy. Stays up between sessions.

  DEPENDS ON variables/values.tfvars (base_domain, azure_subscription_id,
  azure_dns_resource_group) — see variables/README.md. This root has no
  tfvars of its own; a colliding NS in the parent zone (an old delegation,
  another cloud) surfaces as a real azurerm apply error, not a pre-check.

    Options:

      -h,  --help           Show this help
      -y,  --yes            Do not ask before applying
           --state-bucket   Bucket name (default: tfstate-<organization-id>)
           --org-profile    Profile that reads Organizations (default: personal)

    Examples:

      ${this_script_name}

      ${this_script_name} --yes

EOF
}

assume_yes="false"
org_profile="personal"

while [[ "${1}" =~ ^- && ! "${1}" == "--" ]]; do
  case $1 in
    -h | --help )
      show_usage
      exit 1
      ;;

    -y | --yes )
      assume_yes="true"
      ;;

    --state-bucket )
      shift
      STATE_BUCKET="${1}"
      ;;

    --org-profile )
      shift
      org_profile="${1}"
      ;;

    * )
      echo "Invalid option: ${1}" >&2
      show_usage
      exit 1
      ;;
  esac
  shift
done

set -e

require_tools aws terraform

root="${terraform_directory}/dns"
[ -d "${root}" ] || fail "missing root: ${root}"

step "Layer 1 — delegated DNS subzone"

values_file="${terraform_directory}/variables/values.tfvars"

# Guard, not generation: without the file the plan would fail on base_domain anyway. What this
# block buys is the message — Terraform's error names the missing variable, not where to declare it.
[ -f "${values_file}" ] \
  || fail "missing ${values_file}. Copy variables/values.tfvars.example to values.tfvars and fill in the identity values — see variables/README.md."

ensure_symlink "${root}" "values.auto.tfvars" "${values_file}"

state_bucket="$(discover_state_bucket "${org_profile}")"
terraform_init "${root}" "${state_bucket}"
terraform_plan_and_apply "${root}" "dns" "${assume_yes}"

subzone="$(cd "${root}" && terraform output -raw subzone_name 2> /dev/null)" || subzone=""

if [ -n "${subzone}" ]; then
  cat >&2 <<EOF

Verification (NS propagation takes a few minutes):

  dig +short NS ${subzone}
  dig +trace ${subzone} | tail -5

The name servers returned must be the Route 53 ones (awsdns), not the Azure ones.

EOF
fi
