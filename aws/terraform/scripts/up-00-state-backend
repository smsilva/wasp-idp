#!/bin/bash
this_script_path="$(realpath ${0})"
this_script_name="${this_script_path##*/}"
this_script_directory="${this_script_path%/*}"

PATH="${this_script_directory}:${PATH}"

source "${this_script_directory}/lib"

show_usage() {
  cat <<EOF

  Layer 0 — state bucket. Runs ONCE per Organization; after that it is a no-op.
  It has no workload region: it holds the state of every layer and every
  region.

  Self-hosted: this root's state lives in the bucket it manages. That is not
  circular in practice, because the bucket already exists when it runs — but if
  the bucket does NOT exist, this script stops and prints the bootstrap path
  instead of guessing. A one-time bootstrap is not something to automate
  blindly.

    Options:

      -h,  --help           Show this help
      -y,  --yes            Do not ask before applying
           --state-bucket   Bucket name (default: tfstate-<organization-id>)
           --org-profile    Profile that reads Organizations (default: personal)

EOF
}

assume_yes="false"
org_profile="personal"

while [[ "${1}" =~ ^- && ! "${1}" == "--" ]]; do
  case $1 in
    -h | --help )
      show_usage
      exit 1
      ;;

    -y | --yes )
      assume_yes="true"
      ;;

    --state-bucket )
      shift
      STATE_BUCKET="${1}"
      ;;

    --org-profile )
      shift
      org_profile="${1}"
      ;;

    * )
      echo "Invalid option: ${1}" >&2
      show_usage
      exit 1
      ;;
  esac
  shift
done

set -e

require_tools aws terraform

root="${terraform_directory}/state-backend"
[ -d "${root}" ] || fail "missing root: ${root}"

step "Layer 0 — state bucket"

state_bucket="$(discover_state_bucket "${org_profile}")"
log "bucket: ${state_bucket}"

# The profile that reads the bucket is the same one this root's backend uses
# (network). If the bucket does not exist, this root cannot even initialize its
# backend.
if ! aws s3api head-bucket --bucket "${state_bucket}" --profile network > /dev/null 2>&1; then
  cat >&2 <<EOF

Bucket '${state_bucket}' does not exist, and this root keeps its own state in it.

One-time bootstrap, manual on purpose:

  cd ${root}
  printf 'terraform {\n  backend "local" {}\n}\n' > backend_override.tf
  terraform init && terraform apply
  rm backend_override.tf
  terraform init -migrate-state -backend-config="bucket=${state_bucket}"

After that, ${this_script_name} goes back to being a no-op.

EOF
  exit 1
fi

log "bucket exists"

[ -f "${root}/terraform.tfvars" ] \
  || fail "terraform.tfvars missing in ${root}. Copy it from terraform.tfvars.example and fill in bucket_name."

terraform_init "${root}" "${state_bucket}"
terraform_plan_and_apply "${root}" "state-backend" "${assume_yes}"
