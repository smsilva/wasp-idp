#!/bin/bash
this_script_path="$(realpath ${0})"
this_script_name="${this_script_path##*/}"
this_script_directory="${this_script_path%/*}"

PATH="${this_script_directory}:${PATH}"

source "${this_script_directory}/lib"

show_usage() {
  cat <<EOF

  Camada 0 — bucket de state. Roda UMA vez por Organization; depois disso e
  no-op. Nao tem regiao de workload: ele guarda o state de todas as camadas e
  todas as regioes.

  Auto-hospedado: o state desta raiz mora no bucket que ela mesma gerencia.
  Nao e circular na pratica, porque o bucket ja existe quando ela roda — mas
  se o bucket NAO existir, este script para e diz o caminho de bootstrap em
  vez de tentar adivinhar. Bootstrap de uma vez nao se automatiza as cegas.

    Options:

      -h,  --help           Show this help
      -y,  --yes            Nao perguntar antes de aplicar
           --state-bucket   Nome do bucket (default: tfstate-<organization-id>)
           --org-profile    Profile que le a Organization (default: personal)

EOF
}

assume_yes="false"
org_profile="personal"

while [[ "${1}" =~ ^- && ! "${1}" == "--" ]]; do
  case $1 in
    -h | --help )
      show_usage
      exit 1
      ;;

    -y | --yes )
      assume_yes="true"
      ;;

    --state-bucket )
      shift
      STATE_BUCKET="${1}"
      ;;

    --org-profile )
      shift
      org_profile="${1}"
      ;;

    * )
      echo "Invalid option: ${1}" >&2
      show_usage
      exit 1
      ;;
  esac
  shift
done

set -e

require_tools aws terraform

root="${terraform_directory}/state-backend"
[ -d "${root}" ] || fail "raiz ausente: ${root}"

step "Camada 0 — bucket de state"

state_bucket="$(discover_state_bucket "${org_profile}")"
log "bucket: ${state_bucket}"

# O profile que le o bucket e o mesmo do backend desta raiz (network). Se o
# bucket nao existe, esta raiz nao consegue nem inicializar o backend.
if ! aws s3api head-bucket --bucket "${state_bucket}" --profile network > /dev/null 2>&1; then
  cat >&2 <<EOF

O bucket '${state_bucket}' nao existe, e esta raiz guarda o proprio state nele.

Bootstrap de uma vez, manual de proposito:

  cd ${root}
  printf 'terraform {\n  backend "local" {}\n}\n' > backend_override.tf
  terraform init && terraform apply
  rm backend_override.tf
  terraform init -migrate-state -backend-config="bucket=${state_bucket}"

Depois disto, ${this_script_name} volta a ser no-op.

EOF
  exit 1
fi

log "bucket existe"

[ -f "${root}/terraform.tfvars" ] \
  || fail "terraform.tfvars ausente em ${root}. Copie de terraform.tfvars.example e preencha o bucket_name."

terraform_init "${root}" "${state_bucket}"
terraform_plan_and_apply "${root}" "state-backend" "${assume_yes}"
