#!/bin/bash
this_script_path="$(realpath ${0})"
this_script_name="${this_script_path##*/}"
this_script_directory="${this_script_path%/*}"

PATH="${this_script_directory}:${PATH}"

source "${this_script_directory}/lib"

fail "connectivity/ is the OLD root, replaced by regions/<region>/ (ADR 0014). Running this would duplicate the TGW, VPN and SAML provider that module.hub in regions/<region>/ already owns. Use scripts/up-02-region instead — this script is kept only as design history until phase 4 deletes the old roots."

show_usage() {
  cat <<EOF

  Layer 3 — hub connectivity. Creates the Transit Gateway (default association
  and propagation DISABLED, which is what makes per-tenant isolation possible),
  the endpoint certificate in ACM validated by DNS against the layer 2 subzone,
  the SAML provider, and the Client VPN endpoint with its association, supernet
  route and per-group authorization rules.

  TIER T1: ~US\$ 0.15/h (~US\$ 110/month) plus US\$ 0.05/h per active connection.
  It stays up DURING THE DAY on purpose and is destroyed at night — do not
  assume it is leftover. Tear it down with
  connectivity/us-east-1/scripts/destroy.

  DEPENDS ON:

    layer 1  the hub VPC, read by tag (the endpoint is created in it)
    layer 2  the delegated subzone (the certificate validates by DNS in it)
    the file variables/values.tfvars, with the identity values — see
    variables/README.md.

    And on a CONSOLE step: the SAML application in Identity Center. The
    CreateApplication API only creates custom OAuth 2.0 applications, so SAML
    is not Terraform. Save the downloaded metadata as
    variables/saml-metadata.xml — ONE application serves every region, since
    the Client VPN ACS URL is http://127.0.0.1:35001 everywhere. The
    walkthrough is in
    docs/superpowers/plans/2026-08-26-private-access-and-ingress/02-private-access.md,
    section "O passo de console, clique a clique".

    Options:

      -h,  --help           Show this help
      -y,  --yes            Do not ask before applying
           --state-bucket   Bucket name (default: tfstate-<organization-id>)
           --org-profile    Profile that reads Organizations and Identity
                             Center (default: personal)

    Examples:

      ${this_script_name}

      ${this_script_name} --yes

EOF
}

assume_yes="false"
org_profile="personal"

while [[ "${1}" =~ ^- && ! "${1}" == "--" ]]; do
  case $1 in
    -h | --help )
      show_usage
      exit 1
      ;;

    -y | --yes )
      assume_yes="true"
      ;;

    --state-bucket )
      shift
      STATE_BUCKET="${1}"
      ;;

    --org-profile )
      shift
      org_profile="${1}"
      ;;

    * )
      echo "Invalid option: ${1}" >&2
      show_usage
      exit 1
      ;;
  esac
  shift
done

set -e

require_tools aws jq terraform

root="${terraform_directory}/connectivity/us-east-1"
[ -d "${root}" ] || fail "missing root: ${root}"

step "Layer 3 — connectivity (TGW + Client VPN, ~US\$ 0.15/h)"

values_file="${terraform_directory}/variables/values.tfvars"

# Guard, not generation: without the file the plan would fail on base_domain anyway. What this
# block buys is the message — Terraform's error names the missing variable, not where to declare it.
[ -f "${values_file}" ] \
  || fail "missing ${values_file}. Copy variables/values.tfvars.example to values.tfvars and fill in the identity values — see variables/README.md."

state_bucket="$(discover_state_bucket "${org_profile}")"

terraform_init "${root}" "${state_bucket}"
terraform_plan_and_apply "${root}" "connectivity" "${assume_yes}"

endpoint_dns="$(cd "${root}" && terraform output -raw client_vpn_dns_name 2> /dev/null)" || endpoint_dns=""

if [ -n "${endpoint_dns}" ]; then
  cat >&2 <<EOF

Endpoint: ${endpoint_dns}

The DNS name above CHANGES every time this layer is recreated — never save an
.ovpn, always re-export:

  aws ec2 export-client-vpn-client-configuration \\
    --client-vpn-endpoint-id $(cd "${root}" && terraform output -raw client_vpn_endpoint_id 2> /dev/null) \\
    --profile network --region us-east-1 --output text > /tmp/hub.ovpn

  aws-vpn-client import-profile --profile-name hub --config-path /tmp/hub.ovpn
  aws-vpn-client connect --profile-name hub

Reminder: ~US\$ 0.15/h while up. Tear it down with
connectivity/us-east-1/scripts/destroy.

EOF
fi
