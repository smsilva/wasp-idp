#!/bin/bash
this_script_path="$(realpath ${0})"
this_script_name="${this_script_path##*/}"
this_script_directory="${this_script_path%/*}"

PATH="${this_script_directory}:${PATH}"

source "${this_script_directory}/lib"

show_usage() {
  cat <<EOF

  Runs the layers in order, stopping at the first failure.

  The order is NOT a preference — each step depends on the previous one:

    00  state-backend        no other root can initialize its backend without it
    01  network-foundation   hub VPC; layer 04 reads that VPC by tag
    02  dns                  independent of the others, but a prerequisite for
                             certificates and ingress further along
    03  connectivity         TGW + Client VPN; depends on 01 and 02, and on a
                             console step (the SAML application)
    04  control-plane        depends on 01

  COST: layers 00, 01 and 02 add up to cents. Layer 03 costs ~US\$ 110/month and
  layer 04 ~US\$ 165/month while up. That is why NEITHER is included by default
  — pass --with-connectivity and --with-control-plane deliberately.

  By default it runs through layer 02, which is this PoC's cheap resting state.

    Options:

      -h,  --help                Show this help
      -y,  --yes                 Do not ask before each apply
      -d,  --base-domain         Passed through to 02 on the first run
           --with-connectivity   Include layer 03 (~US\$ 110/month)
           --with-control-plane  Include layer 04 (~US\$ 165/month)
           --state-bucket        Passed through to all
           --org-profile         Passed through to all (default: personal)

    Examples:

      ${this_script_name} --base-domain exemplo.com

      ${this_script_name} --yes --with-connectivity --with-control-plane

EOF
}

assume_yes="false"
base_domain=""
with_connectivity="false"
with_control_plane="false"
passthrough=()

while [[ "${1}" =~ ^- && ! "${1}" == "--" ]]; do
  case $1 in
    -h | --help )
      show_usage
      exit 1
      ;;

    -y | --yes )
      assume_yes="true"
      ;;

    -d | --base-domain )
      shift
      base_domain="${1}"
      ;;

    --with-connectivity )
      with_connectivity="true"
      ;;

    --with-control-plane )
      with_control_plane="true"
      ;;

    --state-bucket )
      shift
      passthrough+=(--state-bucket "${1}")
      ;;

    --org-profile )
      shift
      passthrough+=(--org-profile "${1}")
      ;;

    * )
      echo "Invalid option: ${1}" >&2
      show_usage
      exit 1
      ;;
  esac
  shift
done

set -e

common=("${passthrough[@]}")
if [ "${assume_yes}" == "true" ]; then
  common+=(--yes)
fi

up-00-state-backend "${common[@]}"
up-01-network-foundation "${common[@]}"

dns_options=("${common[@]}")
if [ -n "${base_domain}" ]; then
  dns_options+=(--base-domain "${base_domain}")
fi
up-02-dns "${dns_options[@]}"

if [ "${with_connectivity}" == "true" ]; then
  up-03-connectivity "${common[@]}"
else
  step "Layer 3 — connectivity: skipped (~US\$ 110/month)"
  log "include it with --with-connectivity when that is the intent"
  log "and tear it down at the end of the day: connectivity/us-east-1/scripts/destroy"
fi

if [ "${with_control_plane}" == "true" ]; then
  up-04-control-plane "${common[@]}"
else
  step "Layer 4 — control-plane: skipped (~US\$ 165/month)"
  log "include it with --with-control-plane when that is the intent"
fi

step "Done"
