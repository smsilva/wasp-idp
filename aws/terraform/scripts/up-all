#!/bin/bash
this_script_path="$(realpath ${0})"
this_script_name="${this_script_path##*/}"
this_script_directory="${this_script_path%/*}"

PATH="${this_script_directory}:${PATH}"

source "${this_script_directory}/lib"

show_usage() {
  cat <<EOF

  Runs the layers in order, stopping at the first failure.

  The order is NOT a preference — each step depends on the previous one:

    00  state-backend   no other root can initialize its backend without it
    01  dns             independent of the others, but a prerequisite for the
                         certificate that validates by DNS in the region root.
                         Script is still named up-02-dns; the rename to
                         up-01-dns is deferred to phase 4
    02  region          hub (VPC, TGW, Client VPN, public ingress ALB) always;
                         the cell (EKS + workloads) only with --with-cell

  COST: layers 00 and 01 (dns) add up to cents. The hub inside layer 02 costs
  ~US\$ 110/month (TGW + Client VPN) and is applied by default — that is this
  PoC's resting state. The cell adds ~US\$ 165/month on top and is NOT
  included by default — pass --with-cell deliberately, and connect the
  Client VPN tunnel first.

  By default it runs through the hub, which is this PoC's cheap resting
  state.

    Options:

      -h,  --help            Show this help
      -y,  --yes             Do not ask before each apply
      -d,  --base-domain     Passed through to the dns layer on the first run
           --with-cell       Also apply the cell (~US\$ 165/month; needs the
                              Client VPN tunnel connected)
           --state-bucket    Passed through to all
           --org-profile     Passed through to all (default: personal)

    Examples:

      ${this_script_name} --base-domain exemplo.com

      ${this_script_name} --yes --with-cell

EOF
}

assume_yes="false"
base_domain=""
with_cell="false"
passthrough=()

while [[ "${1}" =~ ^- && ! "${1}" == "--" ]]; do
  case $1 in
    -h | --help )
      show_usage
      exit 1
      ;;

    -y | --yes )
      assume_yes="true"
      ;;

    -d | --base-domain )
      shift
      base_domain="${1}"
      ;;

    --with-cell )
      with_cell="true"
      ;;

    --state-bucket )
      shift
      passthrough+=(--state-bucket "${1}")
      ;;

    --org-profile )
      shift
      passthrough+=(--org-profile "${1}")
      ;;

    * )
      echo "Invalid option: ${1}" >&2
      show_usage
      exit 1
      ;;
  esac
  shift
done

set -e

common=("${passthrough[@]}")
if [ "${assume_yes}" == "true" ]; then
  common+=(--yes)
fi

up-00-state-backend "${common[@]}"

# Still named up-02-dns — the rename to up-01-dns is phase 4's job, together with removing the
# old network-foundation/connectivity/control-plane roots.
dns_options=("${common[@]}")
if [ -n "${base_domain}" ]; then
  dns_options+=(--base-domain "${base_domain}")
fi
up-02-dns "${dns_options[@]}"

region_options=("${common[@]}")
if [ "${with_cell}" == "true" ]; then
  region_options+=(--with-cell)
fi
up-02-region "${region_options[@]}"

step "Done"
