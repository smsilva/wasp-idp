#!/bin/bash
# Shared plumbing for the up-* scripts. Sourced, not executed.
#
# It exists so that "one script per layer" does not mean five copies of
# timestamped logging, PIPESTATUS handling and confirmation prompts — which is
# exactly how those things drift apart.

terraform_directory="$(realpath "${BASH_SOURCE[0]%/*}/..")"

log() {
  echo "  ${1}" >&2
}

step() {
  echo "" >&2
  echo "==> ${1}" >&2
}

fail() {
  echo "ERROR: ${1}" >&2
  exit 1
}

# Masks an identifier in diagnostic output. The generated file gets the whole
# value — it is gitignored; the terminal and the transcript do not need the
# full id.
mask() {
  local value="${1?}"
  echo "***${value: -4}"
}

require_tools() {
  local tool
  for tool in "${@}"; do
    command -v "${tool}" > /dev/null 2>&1 || fail "missing binary: ${tool}"
  done
}

# The state bucket name is derived from the Organization id, never committed.
# Accepts an override via --state-bucket for anyone running outside this
# Organization.
discover_state_bucket() {
  local org_profile="${1:-personal}"

  if [ -n "${STATE_BUCKET}" ]; then
    echo "${STATE_BUCKET}"
    return 0
  fi

  local organization_id
  organization_id="$(aws organizations describe-organization \
    --profile "${org_profile}" \
    --query Organization.Id \
    --output text 2> /dev/null)" \
    || fail "could not read the Organization with profile '${org_profile}'. Run 'aws sso login --profile ${org_profile}' or pass --state-bucket."

  echo "tfstate-${organization_id}"
}

# One init per root, idempotent. -reconfigure because the same tree serves
# several roots, and a .terraform inherited from another state key would make
# Terraform complain instead of reinitializing.
terraform_init() {
  local root="${1?}"
  local bucket="${2?}"

  (cd "${root}" && terraform init -reconfigure -backend-config="bucket=${bucket}" -input=false > /dev/null) \
    || fail "init failed in ${root}"
}

# plan -> confirm -> apply, applying EXACTLY the plan that was reviewed (the
# apply does not recompute it), with a timestamped log in <root>/logs/
# (gitignored: the output carries real account ids, ARNs and endpoints).
terraform_plan_and_apply() {
  local root="${1?}"
  local label="${2?}"
  local assume_yes="${3:-false}"

  local log_directory="${root}/logs"
  local timestamp
  timestamp="$(date +%Y%m%d-%H%M%S)"
  local plan_file="${root}/${label}-${timestamp}.tfplan"
  local plan_log="${log_directory}/plan-${timestamp}.log"
  local apply_log="${log_directory}/apply-${timestamp}.log"

  mkdir --parents "${log_directory}"

  log "plan (log: ${plan_log})"
  (cd "${root}" && terraform plan -no-color -input=false -out="${plan_file}") 2>&1 | tee "${plan_log}"
  # tee always returns 0; PIPESTATUS holds the terraform exit code.
  [ "${PIPESTATUS[0]}" -eq 0 ] || fail "the ${label} plan failed. Log: ${plan_log}"

  # -detailed-exitcode does not exist for a saved plan; the count comes from show.
  local changes
  changes="$( (cd "${root}" && terraform show -no-color "${plan_file}") | grep --count '^  # ' || true)"

  if [ "${changes}" -eq 0 ]; then
    log "nothing to change in ${label} — layer already applied"
    rm --force "${plan_file}"
    return 0
  fi

  log "${changes} resource(s) to change in ${label}"

  if [ "${assume_yes}" != "true" ]; then
    if [ ! -t 0 ]; then
      cat >&2 <<EOF

The ${label} plan was saved to ${plan_file}, but there is no terminal to
confirm on. Resources billed by the hour start counting at apply time, so the
answer is not assumed to be yes.

Apply it with:

  ${0##*/} --yes

EOF
      exit 1
    fi

    echo "" >&2
    read -r -p "Apply ${label}? [yes/N] " answer
    if [ "${answer}" != "yes" ]; then
      rm --force "${plan_file}"
      fail "cancelled at ${label}."
    fi
  fi

  log "apply (log: ${apply_log})"
  (cd "${root}" && terraform apply -no-color "${plan_file}") 2>&1 | tee "${apply_log}"
  local apply_status="${PIPESTATUS[0]}"

  rm --force "${plan_file}"

  [ "${apply_status}" -eq 0 ] \
    || fail "the ${label} apply failed (exit ${apply_status}). Partial resources may exist — check the state before retrying. Log: ${apply_log}"

  log "${label} applied"
}
