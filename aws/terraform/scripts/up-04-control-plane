#!/bin/bash
this_script_path="$(realpath ${0})"
this_script_name="${this_script_path##*/}"
this_script_directory="${this_script_path%/*}"

PATH="${this_script_directory}:${PATH}"

source "${this_script_directory}/lib"

show_usage() {
  cat <<EOF

  Layer 4 — Control Plane: spoke VPC, EKS, node group, four Pod Identities,
  the internal ingress NLB, ESO, ArgoCD and Crossplane, in a single
  terraform apply. ~13 min.

  COST ~US\$ 165/month while up (EKS ~73 + NAT ~32 + 2x t3.medium ~60).
  Tier T2: bring it up, validate, tear it down. Do NOT leave it up between
  sessions.

  Discovery is delegated to the root's own script (control-plane/scripts/
  generate-tfvars), which validates the hub VPC tag, CIDR collisions and the
  region against the SCP, and also discovers this machine's public IP for the
  API endpoint's public_access_cidrs.

  DEPENDS ON layer 1 (reads the hub VPC by tag:Name in the network account).
  Once layer 3 (connectivity) is applied, the TGW attachment belongs in THIS
  root's state — the state boundary follows the lifecycle, not the account.

    Options:

      -h,  --help            Show this help
      -y,  --yes             Do not ask before applying
           --state-bucket    Bucket name (default: tfstate-<organization-id>)
           --org-profile     Profile that reads Organizations (default: personal)
      -f,  --force-tfvars    Regenerate terraform.tfvars even if it exists
                              (needed when changing networks: the /32 changes)

EOF
}

assume_yes="false"
org_profile="personal"
force_tfvars="false"

while [[ "${1}" =~ ^- && ! "${1}" == "--" ]]; do
  case $1 in
    -h | --help )
      show_usage
      exit 1
      ;;

    -y | --yes )
      assume_yes="true"
      ;;

    --state-bucket )
      shift
      STATE_BUCKET="${1}"
      ;;

    --org-profile )
      shift
      org_profile="${1}"
      ;;

    -f | --force-tfvars )
      force_tfvars="true"
      ;;

    * )
      echo "Invalid option: ${1}" >&2
      show_usage
      exit 1
      ;;
  esac
  shift
done

set -e

require_tools aws jq terraform

root="${terraform_directory}/control-plane"
[ -d "${root}" ] || fail "missing root: ${root}"

step "Layer 4 — Control Plane (EKS)"

if [ ! -f "${root}/terraform.tfvars" ] || [ "${force_tfvars}" == "true" ]; then
  log "generating terraform.tfvars"
  "${root}/scripts/generate-tfvars" --force
else
  log "terraform.tfvars already exists (use --force-tfvars to regenerate — the endpoint /32 changes with the network)"
fi

state_bucket="$(discover_state_bucket "${org_profile}")"

terraform_init "${root}" "${state_bucket}"
terraform_plan_and_apply "${root}" "control-plane" "${assume_yes}"

cat >&2 <<EOF

Next step:

  $(cd "${root}" && terraform output -raw kubeconfig_command 2> /dev/null || echo "terraform output kubeconfig_command")
  kubectl get nodes

Reminder: ~US\$ 0.23/h. Tear it down with control-plane/scripts/destroy.

EOF
