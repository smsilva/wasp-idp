#!/bin/bash
this_script_path="$(realpath ${0})"
this_script_name="${this_script_path##*/}"
this_script_directory="${this_script_path%/*}"

PATH="${this_script_directory}:${PATH}"

source "${this_script_directory}/lib"

show_usage() {
  cat <<EOF

  Layer 1 — hub VPCs, one root per region. ZERO recurring cost: no NAT
  Gateway, because without a TGW nothing routes through the hub and a NAT would
  cost ~US\$ 32/month serving zero traffic. That changes once layer 3
  (connectivity) is in place.

  Without --region, applies EVERY region found under network-foundation/.
  One root per region is deliberate: a single root switching backends with
  'init -reconfigure' mixes regions up whenever someone forgets to switch, and
  nothing in Terraform catches that.

  NOT-AUTOMATED PREREQUISITE: the region must be approved in the
  DenyOutsideApprovedRegions SCP. Without it the error shows up on the first
  Create*, looking like a code bug. Approve it with:

    aws/docs/accounts/scripts/apply-baseline-service-control-policy --regions <r1>,<r2>

    Options:

      -h,  --help           Show this help
      -y,  --yes            Do not ask before applying
      -r,  --region         Only this region (default: every one found)
           --state-bucket   Bucket name (default: tfstate-<organization-id>)
           --org-profile    Profile that reads Organizations (default: personal)

    Examples:

      ${this_script_name}

      ${this_script_name} --region us-east-1 --yes

EOF
}

assume_yes="false"
org_profile="personal"
only_region=""

while [[ "${1}" =~ ^- && ! "${1}" == "--" ]]; do
  case $1 in
    -h | --help )
      show_usage
      exit 1
      ;;

    -y | --yes )
      assume_yes="true"
      ;;

    -r | --region )
      shift
      only_region="${1}"
      ;;

    --state-bucket )
      shift
      STATE_BUCKET="${1}"
      ;;

    --org-profile )
      shift
      org_profile="${1}"
      ;;

    * )
      echo "Invalid option: ${1}" >&2
      show_usage
      exit 1
      ;;
  esac
  shift
done

set -e

require_tools aws terraform

step "Layer 1 — hub VPCs"

state_bucket="$(discover_state_bucket "${org_profile}")"

regions=()
for candidate in "${terraform_directory}"/network-foundation/*/; do
  [ -f "${candidate}/main.tf" ] || continue
  region="$(basename "${candidate}")"
  if [ -n "${only_region}" ] && [ "${region}" != "${only_region}" ]; then
    continue
  fi
  regions+=("${region}")
done

if [ "${#regions[@]}" -eq 0 ]; then
  fail "no region root found in ${terraform_directory}/network-foundation/${only_region:+ (filter: ${only_region})}"
fi

log "regions: ${regions[*]}"

for region in "${regions[@]}"; do
  root="${terraform_directory}/network-foundation/${region}"

  # A cheap describe brings the SCP deny forward, ahead of any Create*.
  if ! aws ec2 describe-vpcs --region "${region}" --profile network --max-items 1 --output text > /dev/null 2>&1; then
    fail "the network account cannot read EC2 in ${region}. Likely a DenyOutsideApprovedRegions deny — approve the region first (see --help)."
  fi

  terraform_init "${root}" "${state_bucket}"
  terraform_plan_and_apply "${root}" "network-foundation-${region}" "${assume_yes}"
done
