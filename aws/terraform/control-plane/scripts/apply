#!/bin/bash
this_script_path="$(realpath ${0})"
this_script_name="${this_script_path##*/}"
this_script_directory="${this_script_path%/*}"

PATH="${this_script_directory}:${PATH}"

root_directory="$(realpath "${this_script_directory}/..")"

show_usage() {
  cat <<EOF

  Applies the control-plane layer and keeps the execution log.

  Without --plan-file, it runs 'terraform plan -out' first and asks for
  confirmation — the plan is applied exactly as reviewed, with no recomputation
  at apply time.

  The log goes to logs/apply-<timestamp>.log (gitignored: apply output carries
  real account ids, ARNs and endpoints).

    Options:

      -h,  --help            Show this help
      -p,  --plan-file       Existing saved plan to apply (default: generate one)
      -y,  --yes             Do not ask before applying the generated plan
           --log-directory   Where to write the log (default: ${root_directory}/logs)

    Examples:

      ${this_script_name}

      ${this_script_name} --plan-file control-plane.tfplan

      ${this_script_name} --yes

EOF
}

plan_file=""
assume_yes="false"
log_directory="${root_directory}/logs"

while [[ "${1}" =~ ^- && ! "${1}" == "--" ]]; do
  case $1 in
    -h | --help )
      show_usage
      exit 1
      ;;

    -p | --plan-file )
      shift
      plan_file="${1}"
      ;;

    -y | --yes )
      assume_yes="true"
      ;;

    --log-directory )
      shift
      log_directory="${1}"
      ;;

    * )
      echo "Invalid option: ${1}" >&2
      show_usage
      exit 1
      ;;
  esac
  shift
done

fail() {
  echo "ERROR: ${1}" >&2
  exit 1
}

set -e

command -v terraform > /dev/null 2>&1 || fail "missing binary: terraform"

cd "${root_directory}"

[ -f terraform.tfvars ] || fail "terraform.tfvars is missing. Generate it with scripts/generate-tfvars."
[ -d .terraform ] || fail "backend not initialized. Run 'terraform init -backend-config=\"bucket=<bucket>\"' (generate-tfvars prints the bucket)."

mkdir -p "${log_directory}"

timestamp="$(date +%Y%m%d-%H%M%S)"
log_file="${log_directory}/apply-${timestamp}.log"

generated_plan="false"

if [ -z "${plan_file}" ]; then
  plan_file="${root_directory}/control-plane-${timestamp}.tfplan"
  generated_plan="true"

  echo "Generating plan..." >&2
  terraform plan -no-color -out="${plan_file}" 2>&1 | tee "${log_directory}/plan-${timestamp}.log"

  # tee masks terraform's exit code; PIPESTATUS holds the first link's.
  [ "${PIPESTATUS[0]}" -eq 0 ] || fail "the plan failed. Log: ${log_directory}/plan-${timestamp}.log"

  if [ "${assume_yes}" != "true" ]; then
    # With no tty (pipe, CI, agent harness) read returns empty immediately and
    # the cancellation would look like the operator's decision. Better to say so.
    if [ ! -t 0 ]; then
      cat >&2 <<EOF

The plan was saved to ${plan_file}, but there is no terminal to confirm on.

Apply it with either:

  ${this_script_name} --plan-file ${plan_file}
  ${this_script_name} --yes

EOF
      exit 1
    fi

    echo "" >&2
    read -r -p "Apply this plan? Resources billed by the hour start counting now. [yes/N] " answer
    if [ "${answer}" != "yes" ]; then
      echo "Cancelled. The plan is still at ${plan_file}." >&2
      exit 1
    fi
  fi
else
  [ -f "${plan_file}" ] || fail "plan not found: ${plan_file}"
fi

echo "Applying. Log: ${log_file}" >&2

# -no-color because a saved file full of ANSI escapes is unreadable; 2>&1 because
# the provider error goes to stderr and that is exactly the part that matters later.
terraform apply -no-color "${plan_file}" 2>&1 | tee "${log_file}"
apply_status="${PIPESTATUS[0]}"

if [ "${generated_plan}" == "true" ] && [ "${apply_status}" -eq 0 ]; then
  rm --force "${plan_file}"
fi

echo "" >&2
echo "Log: ${log_file}" >&2

if [ "${apply_status}" -ne 0 ]; then
  fail "the apply failed (exit ${apply_status}). Partial resources may have been created — check the state before retrying."
fi

cat >&2 <<EOF

Next step:

  $(terraform output -raw kubeconfig_command)
  kubectl get nodes

EOF
