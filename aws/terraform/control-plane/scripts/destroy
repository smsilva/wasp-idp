#!/bin/bash
this_script_path="$(realpath ${0})"
this_script_name="${this_script_path##*/}"
this_script_directory="${this_script_path%/*}"

PATH="${this_script_directory}:${PATH}"

root_directory="$(realpath "${this_script_directory}/..")"

show_usage() {
  cat <<EOF

  Destroys the control-plane layer and keeps the execution log.

  Before destroying, it checks that Crossplane has no live managed resources.
  Destroying the cluster with XRs/managed resources up leaves orphans in AWS:
  the thing that knew how to delete them was Crossplane, and it goes away with
  the cluster.

  Chain order: control-plane BEFORE network-foundation.

  The log goes to logs/destroy-<timestamp>.log (gitignored).

    Options:

      -h,  --help              Show this help
      -y,  --yes               Do not ask (passes -auto-approve)
           --skip-crossplane   Skip the managed-resource check
           --log-directory     Where to write the log (default: ${root_directory}/logs)

    Examples:

      ${this_script_name}

      ${this_script_name} --yes

EOF
}

assume_yes="false"
skip_crossplane="false"
log_directory="${root_directory}/logs"

while [[ "${1}" =~ ^- && ! "${1}" == "--" ]]; do
  case $1 in
    -h | --help )
      show_usage
      exit 1
      ;;

    -y | --yes )
      assume_yes="true"
      ;;

    --skip-crossplane )
      skip_crossplane="true"
      ;;

    --log-directory )
      shift
      log_directory="${1}"
      ;;

    * )
      echo "Invalid option: ${1}" >&2
      show_usage
      exit 1
      ;;
  esac
  shift
done

fail() {
  echo "ERROR: ${1}" >&2
  exit 1
}

set -e

command -v terraform > /dev/null 2>&1 || fail "missing binary: terraform"

cd "${root_directory}"

[ -d .terraform ] || fail "backend not initialized. Run 'terraform init -backend-config=\"bucket=<bucket>\"'."

if [ "${skip_crossplane}" != "true" ]; then
  if ! command -v kubectl > /dev/null 2>&1; then
    fail "kubectl is missing — cannot check Crossplane resources. Use --skip-crossplane if the cluster is already gone."
  fi

  if kubectl cluster-info > /dev/null 2>&1; then
    # The current context may be the k3d control-plane rather than this layer's
    # EKS. Without this check, an empty 'get managed' against the wrong cluster
    # reads as "nothing alive" and the destroy goes ahead, leaving orphans.
    cluster_name="$(terraform output -raw cluster_name 2> /dev/null)" || cluster_name=""
    current_context="$(kubectl config current-context)"

    if [ -n "${cluster_name}" ] && [[ "${current_context}" != *"${cluster_name}"* ]]; then
      fail "the current kubectl context is '${current_context}', which does not match cluster '${cluster_name}'. Run '$(terraform output -raw kubeconfig_command)' first, or use --skip-crossplane."
    fi

    for kind in managed composite; do
      # Without the CRD the get fails; in that case Crossplane never even came up.
      alive="$(kubectl get "${kind}" --no-headers 2> /dev/null | wc --lines)"

      if [ "${alive}" -gt 0 ]; then
        kubectl get "${kind}" >&2
        fail "${alive} live '${kind}' resource(s). Delete the XRs first and wait for Crossplane to remove them from AWS — otherwise they become orphans."
      fi
    done

    echo "  Crossplane has no live managed resources" >&2
  else
    echo "  WARNING: kubectl cannot reach any cluster — Crossplane check skipped" >&2
  fi
fi

mkdir -p "${log_directory}"

timestamp="$(date +%Y%m%d-%H%M%S)"
log_file="${log_directory}/destroy-${timestamp}.log"

auto_approve=()
if [ "${assume_yes}" == "true" ]; then
  auto_approve=("-auto-approve")
fi

echo "Destroying. Log: ${log_file}" >&2

terraform destroy -no-color "${auto_approve[@]}" 2>&1 | tee "${log_file}"
destroy_status="${PIPESTATUS[0]}"

echo "" >&2
echo "Log: ${log_file}" >&2

if [ "${destroy_status}" -ne 0 ]; then
  fail "the destroy failed (exit ${destroy_status}). Remaining resources keep billing — check 'terraform state list'."
fi

echo "control-plane layer destroyed. network-foundation is still up." >&2
