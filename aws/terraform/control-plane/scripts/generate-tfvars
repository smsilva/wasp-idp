#!/bin/bash
this_script_path="$(realpath ${0})"
this_script_name="${this_script_path##*/}"
this_script_directory="${this_script_path%/*}"

PATH="${this_script_directory}:${PATH}"

show_usage() {
  cat <<EOF

  Discovers from AWS the values the control-plane layer needs and generates
  terraform.tfvars (gitignored). Read only — creates nothing, changes nothing.

  What is DISCOVERED (API calls):

    network_account_id   sts get-caller-identity on the network account profile
    availability_zones   describe-availability-zones for the region, first N
    target_account_ids   organizations list-accounts, resolving name -> id
    kubernetes_version   describe-cluster-versions, the EKS default version
    public_access_cidrs  THIS machine's public IP, as a /32, via checkip.amazonaws.com
    <state bucket>       tfstate-<organization-id>, printed for -backend-config

  About public_access_cidrs: whoever talks to the EKS API server is the machine
  running terraform apply — the helm and kubernetes providers originate here. So the
  right value is THIS machine's egress IP, and that is why it is rediscovered on every
  generation instead of being pinned in the file. A dynamic IP, changing networks or
  connecting/disconnecting a VPN all change it: regenerate. The public endpoint goes
  away at step 2.5, once the private path is up.

  What is DECIDED (comes from an option, not discovered):

    vpc_cidr             the spoke's /16 inside the 10.0.0.0/12 supernet. CIDR is the
                         only irreversible decision in the chain — see
                         aws/docs/network/01-cidr-addressing.md

  What is VALIDATED (fails before writing a file, instead of failing at apply):

    - the hub VPC Name tag matches EXACTLY one VPC in the network account
    - the requested vpc_cidr does not collide with any VPC in the target account
    - the region passes the DenyOutsideApprovedRegions SCP
    - the state bucket exists
    - the discovered IP is a valid IPv4, not a captive portal page

    Options:

      -h,  --help                Show this help
      -r,  --region              Cell region (default: us-east-1)
      -p,  --profile             Profile of the cicd account, which owns the cluster
                                  (default: cicd)
           --network-profile     Read-only profile for the network account (default: network)
           --org-profile         Management account profile, used to resolve account
                                  names into ids (default: personal)
           --hub-vpc-name        Name tag of the layer 1 hub VPC (default: poc-hub-vpc)
           --vpc-cidr            Spoke CIDR (default: 10.2.0.0/16)
           --target-account      Account where Crossplane creates resources. Accepts a
                                  name ("wasp-nonprod") or a 12-digit id. Repeatable.
                                  (default: wasp-nonprod)
           --availability-zones  How many AZs to use (default: 2)
           --kubernetes-version  Pin the version instead of discovering it
           --public-access-cidr  CIDR allowed on the public API endpoint. Repeatable.
                                  Passing at least one TURNS OFF IP discovery — use it
                                  when the apply runs elsewhere (CodeBuild, a CI runner)
                                  or to add the Client VPN CIDR
           --format              tfvars | json  (default: tfvars)
      -o,  --output              Output file (default: ../terraform.tfvars;
                                  use - for stdout)
      -f,  --force               Overwrite the file if it already exists

    Examples:

      ${this_script_name}

      ${this_script_name} --target-account wasp-nonprod --target-account cicd

      ${this_script_name} --format json --output -

      ${this_script_name} --region us-west-2 --vpc-cidr 10.4.0.0/16 --hub-vpc-name poc-hub-vpc

      ${this_script_name} --public-access-cidr 203.0.113.10/32 --force

EOF
}

region="us-east-1"
profile="cicd"
network_profile="network"
org_profile="personal"
hub_vpc_name="poc-hub-vpc"
vpc_cidr="10.2.0.0/16"
availability_zone_count="2"
kubernetes_version=""
format="tfvars"
output=""
force="false"
target_accounts=()
public_access_cidrs=()

while [[ "${1}" =~ ^- && ! "${1}" == "--" ]]; do
  case $1 in
    -h | --help )
      show_usage
      exit 1
      ;;

    -r | --region )
      shift
      region="${1}"
      ;;

    -p | --profile )
      shift
      profile="${1}"
      ;;

    --network-profile )
      shift
      network_profile="${1}"
      ;;

    --org-profile )
      shift
      org_profile="${1}"
      ;;

    --hub-vpc-name )
      shift
      hub_vpc_name="${1}"
      ;;

    --vpc-cidr )
      shift
      vpc_cidr="${1}"
      ;;

    --target-account )
      shift
      target_accounts+=("${1}")
      ;;

    --availability-zones )
      shift
      availability_zone_count="${1}"
      ;;

    --kubernetes-version )
      shift
      kubernetes_version="${1}"
      ;;

    --public-access-cidr )
      shift
      public_access_cidrs+=("${1}")
      ;;

    --format )
      shift
      format="${1}"
      ;;

    -o | --output )
      shift
      output="${1}"
      ;;

    -f | --force )
      force="true"
      ;;

    * )
      echo "Invalid option: ${1}" >&2
      show_usage
      exit 1
      ;;
  esac
  shift
done

if [ "${#target_accounts[@]}" -eq 0 ]; then
  target_accounts=("wasp-nonprod")
fi

case "${format}" in
  tfvars | json ) ;;
  * )
    echo "invalid --format: '${format}' (use tfvars or json)" >&2
    exit 1
    ;;
esac

if [ -z "${output}" ]; then
  output="${this_script_directory}/../terraform.tfvars"
fi

# Masks an account id in diagnostic output. The generated file gets the whole
# value — it is gitignored; the terminal and the transcript do not need it.
mask() {
  local value="${1?}"
  echo "***${value: -4}"
}

log() {
  echo "  ${1}" >&2
}

fail() {
  echo "ERROR: ${1}" >&2
  exit 1
}

set -e

for tool in aws jq curl; do
  command -v "${tool}" > /dev/null 2>&1 || fail "missing binary: ${tool}"
done

if [ "${output}" != "-" ] && [ -e "${output}" ] && [ "${force}" != "true" ]; then
  fail "${output} already exists. Use --force to overwrite."
fi

echo "Discovering values for the control-plane cell in ${region}..." >&2

# --- cicd account -----------------------------------------------------------
cicd_account_id="$(aws sts get-caller-identity \
  --profile "${profile}" \
  --query Account \
  --output text)" || fail "profile '${profile}' has no valid credentials. Run 'aws sso login --profile ${org_profile}'."
log "cluster account (profile ${profile}): $(mask "${cicd_account_id}")"

# --- network account --------------------------------------------------------
network_account_id="$(aws sts get-caller-identity \
  --profile "${network_profile}" \
  --query Account \
  --output text)" || fail "profile '${network_profile}' has no valid credentials."
log "network account (profile ${network_profile}): $(mask "${network_account_id}")"

# --- region approved by the SCP ---------------------------------------------
# A write call in a denied region only comes back with "explicit deny in a service
# control policy" on the first Create*, with resources already created behind it.
# A cheap describe here brings that forward, before any tfvars exists.
if ! aws ec2 describe-vpcs \
  --region "${region}" \
  --profile "${profile}" \
  --max-items 1 \
  --output text > /dev/null 2>&1; then
  fail "account '${profile}' cannot read EC2 in ${region}. Likely a DenyOutsideApprovedRegions deny — approve the region with 'aws/docs/accounts/scripts/apply-baseline-service-control-policy --regions <list>'."
fi
log "region ${region} approved by the SCP"

# --- layer 1 hub VPC --------------------------------------------------------
# The root's data "aws_vpc" fails at plan time if the tag filter does not return
# exactly one id. Better to find that out here.
hub_vpc_ids="$(aws ec2 describe-vpcs \
  --region "${region}" \
  --profile "${network_profile}" \
  --filters "Name=tag:Name,Values=${hub_vpc_name}" \
  --query 'Vpcs[].VpcId' \
  --output text)"
hub_vpc_count="$(echo "${hub_vpc_ids}" | wc -w)"

if [ "${hub_vpc_count}" -eq 0 ]; then
  fail "no VPC tagged Name='${hub_vpc_name}' in ${region} in the network account. Was layer 1 applied for that region?"
fi

if [ "${hub_vpc_count}" -gt 1 ]; then
  fail "${hub_vpc_count} VPCs tagged Name='${hub_vpc_name}' in ${region}. The filter must be unambiguous — data \"aws_vpc\" breaks at plan time."
fi
log "hub VPC: ${hub_vpc_ids}"

# --- CIDR collision ---------------------------------------------------------
colliding_vpc="$(aws ec2 describe-vpcs \
  --region "${region}" \
  --profile "${profile}" \
  --filters "Name=cidr,Values=${vpc_cidr}" \
  --query 'Vpcs[].VpcId' \
  --output text)"

if [ -n "${colliding_vpc}" ]; then
  fail "${vpc_cidr} is already in use in the cluster account by VPC ${colliding_vpc}. Pick another /16 from the supernet (see aws/docs/network/01-cidr-addressing.md)."
fi
log "CIDR ${vpc_cidr} free in the cluster account"

# --- availability zones -----------------------------------------------------
availability_zones="$(aws ec2 describe-availability-zones \
  --region "${region}" \
  --profile "${profile}" \
  --filters "Name=state,Values=available" \
  --query "AvailabilityZones[:${availability_zone_count}].ZoneName" \
  --output json | jq --compact-output '.')"
log "zones: $(echo "${availability_zones}" | jq --raw-output 'join(", ")')"

# --- Crossplane target accounts ---------------------------------------------
# Accepts a name or an id. A name requires the management account, because only it
# can list the whole Organization.
target_account_ids=()
organization_accounts=""

for target in "${target_accounts[@]}"; do
  if [[ "${target}" =~ ^[0-9]{12}$ ]]; then
    target_account_ids+=("${target}")
    log "target account (id given directly): $(mask "${target}")"
    continue
  fi

  if [ -z "${organization_accounts}" ]; then
    organization_accounts="$(aws organizations list-accounts \
      --profile "${org_profile}" \
      --output json)" || fail "profile '${org_profile}' cannot list the Organization. Run 'aws sso login --profile ${org_profile}'."
  fi

  resolved="$(echo "${organization_accounts}" \
    | jq --raw-output --arg name "${target}" \
      '.Accounts[] | select(.Name == $name and .Status == "ACTIVE") | .Id')"

  if [ -z "${resolved}" ]; then
    fail "no ACTIVE account named '${target}' in the Organization."
  fi

  if [ "$(echo "${resolved}" | wc -l)" -gt 1 ]; then
    fail "more than one ACTIVE account named '${target}'. Pass the 12-digit id."
  fi

  target_account_ids+=("${resolved}")
  log "target account '${target}': $(mask "${resolved}")"
done

# --- Kubernetes version -----------------------------------------------------
if [ -z "${kubernetes_version}" ]; then
  kubernetes_version="$(aws eks describe-cluster-versions \
    --region "${region}" \
    --profile "${profile}" \
    --output json 2> /dev/null \
    | jq --raw-output '[.clusterVersions[] | select(.defaultVersion == true)] | first | .clusterVersion // empty')" || true
fi

if [ -z "${kubernetes_version}" ]; then
  fail "could not discover the default EKS version. Pass --kubernetes-version explicitly."
fi
log "Kubernetes version: ${kubernetes_version}"

# --- CIDRs allowed on the public API endpoint -------------------------------
# Whoever talks to the EKS API server is the machine running the apply — the helm
# and kubernetes providers originate here. So the right value is THIS machine's
# egress IP, not something pinned in the file. An empty list will not do: AWS reads
# empty as 0.0.0.0/0, and the root rejects that in validation.
if [ "${#public_access_cidrs[@]}" -eq 0 ]; then
  # No pipe on purpose: with "curl | tr" the exit code would be tr's and a curl
  # failure would pass silently — the same trap the apply/destroy scripts solve with
  # PIPESTATUS. --fail turns HTTP >= 400 into an exit code.
  discovered_ip="$(curl --silent --fail --max-time 5 https://checkip.amazonaws.com)" \
    || fail "could not reach checkip.amazonaws.com. No network, or a proxy in the way — pass --public-access-cidr <cidr> explicitly."

  discovered_ip="${discovered_ip//[[:space:]]/}"

  # Captive portals and intercepting proxies return HTML with HTTP 200, so curl's
  # exit code is not enough. Octet ranges are not checked here: the CIDR goes through
  # the root's validation, which rejects 999.0.0.1/32 with its own message.
  if [[ ! "${discovered_ip}" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]]; then
    fail "checkip.amazonaws.com returned something that is not IPv4 ('${discovered_ip:0:24}'). Captive portal or intercepting proxy? Pass --public-access-cidr <cidr>."
  fi

  public_access_cidrs=("${discovered_ip}/32")
  log "this machine's public IP: $(mask "${discovered_ip}")/32 (regenerate when changing network or VPN)"
else
  log "public endpoint CIDRs: ${#public_access_cidrs[@]} given by option, discovery turned off"
fi

# --- state bucket -----------------------------------------------------------
# It does not go into the tfvars: the backend gets the bucket via -backend-config,
# precisely so the real name never becomes a committed file.
organization_id="$(aws organizations describe-organization \
  --profile "${org_profile}" \
  --query Organization.Id \
  --output text 2> /dev/null)" || organization_id=""

state_bucket=""
if [ -n "${organization_id}" ]; then
  state_bucket="tfstate-${organization_id}"

  if ! aws s3api head-bucket \
    --bucket "${state_bucket}" \
    --profile "${network_profile}" > /dev/null 2>&1; then
    log "WARNING: state bucket '${state_bucket}' not found in the network account"
    state_bucket=""
  else
    log "state bucket: ${state_bucket}"
  fi
fi

# --- output -----------------------------------------------------------------
target_account_ids_json="$(printf '%s\n' "${target_account_ids[@]}" | jq --raw-input --slurp --compact-output 'split("\n") | map(select(length > 0))')"
public_access_cidrs_json="$(printf '%s\n' "${public_access_cidrs[@]}" | jq --raw-input --slurp --compact-output 'split("\n") | map(select(length > 0))')"

if [ "${format}" == "json" ]; then
  rendered="$(jq --null-input \
    --arg region "${region}" \
    --arg aws_profile "${profile}" \
    --arg network_profile "${network_profile}" \
    --arg hub_vpc_name "${hub_vpc_name}" \
    --arg hub_vpc_id "${hub_vpc_ids}" \
    --arg vpc_cidr "${vpc_cidr}" \
    --arg kubernetes_version "${kubernetes_version}" \
    --arg network_account_id "${network_account_id}" \
    --arg cluster_account_id "${cicd_account_id}" \
    --arg state_bucket "${state_bucket}" \
    --argjson availability_zones "${availability_zones}" \
    --argjson target_account_ids "${target_account_ids_json}" \
    --argjson public_access_cidrs "${public_access_cidrs_json}" \
    '{
      region: $region,
      aws_profile: $aws_profile,
      network_profile: $network_profile,
      hub_vpc_name: $hub_vpc_name,
      vpc_cidr: $vpc_cidr,
      kubernetes_version: $kubernetes_version,
      availability_zones: $availability_zones,
      network_account_id: $network_account_id,
      target_account_ids: $target_account_ids,
      public_access_cidrs: $public_access_cidrs,
      discovered: {
        hub_vpc_id: $hub_vpc_id,
        cluster_account_id: $cluster_account_id,
        state_bucket: $state_bucket
      }
    }')"
else
  rendered="$(cat <<EOF
# Generated by ${this_script_name} — do not hand-edit without knowing why.
# Discovered from AWS; regenerate with:
#   scripts/${this_script_name} --region ${region} --vpc-cidr ${vpc_cidr} --force
#
# Discovered hub VPC: ${hub_vpc_ids}

region             = "${region}"
aws_profile        = "${profile}"
network_profile    = "${network_profile}"
hub_vpc_name       = "${hub_vpc_name}"
vpc_cidr           = "${vpc_cidr}"
kubernetes_version = "${kubernetes_version}"
availability_zones = $(echo "${availability_zones}" | jq --raw-output '"[" + (map("\"" + . + "\"") | join(", ")) + "]"')
network_account_id = "${network_account_id}"
target_account_ids = $(echo "${target_account_ids_json}" | jq --raw-output '"[" + (map("\"" + . + "\"") | join(", ")) + "]"')

# The EKS API public endpoint accepts ONLY these CIDRs. Discovered during this
# generation; changing network or VPN invalidates the value — regenerate instead of
# hand-editing. This goes away when step 2.5 closes the public endpoint.
public_access_cidrs = $(echo "${public_access_cidrs_json}" | jq --raw-output '"[" + (map("\"" + . + "\"") | join(", ")) + "]"')
EOF
)"
fi

if [ "${output}" == "-" ]; then
  echo "${rendered}"
else
  echo "${rendered}" > "${output}"
  echo "" >&2
  echo "Wrote: $(realpath "${output}")" >&2

  if ! git -C "${this_script_directory}" check-ignore -q "${output}" 2> /dev/null; then
    echo "" >&2
    echo "WARNING: ${output} is NOT gitignored. Fix that before committing." >&2
  fi
fi

if [ -n "${state_bucket}" ] && [ "${output}" != "-" ]; then
  cat >&2 <<EOF

Next step:

  cd $(realpath "${this_script_directory}/..")
  terraform init -backend-config="bucket=${state_bucket}"
  terraform plan -out=control-plane.tfplan

EOF
fi
