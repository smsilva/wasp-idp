# Domínio, resource group e subscription identificam a conta de quem roda, e este repo é
# público — por isso vão em terraform.tfvars (gitignored) em vez de inline como nas outras
# raízes, onde os valores são decisão de desenho e não identidade.

base_domain = "<dominio-do-apex-no-azure-dns>"

azure_subscription_id    = "<subscription-id>"
azure_dns_resource_group = "<resource-group-da-zona-pai>"

# subzone_label     = "nonprod"   # default
# network_profile   = "network"   # default
# manage_delegation = true        # false = trabalhar só o lado AWS, sem credencial Azure
