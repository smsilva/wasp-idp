#!/bin/bash
this_script_path="$(realpath ${0})"
this_script_name="${this_script_path##*/}"
this_script_directory="${this_script_path%/*}"

root="$(realpath "${this_script_directory}/..")"

show_usage() {
  cat <<EOF

  Discovers what layer 3 needs from AWS and writes terraform.tfvars.
  READ ONLY — creates nothing, changes nothing, deletes nothing.

  DISCOVERS:

    base_domain          from the <label>.<domain> hosted zone layer 2 delegated
    operator_group_ids   from Identity Center, translating name -> UUID

  VALIDATES before writing any file:

    - EXACTLY one public hosted zone <label>.*  (layer 2 applied)
    - the hub VPC matches exactly one id by its Name tag
    - the hub has private subnets (the endpoint association needs them)
    - the region is not denied by an SCP
    - the SAML metadata exists on disk  (a console step, not Terraform)

    Options:

      -h,  --help            Show this help
      -g,  --group           Identity Center group name. Repeatable.
                             Default: platform-admins
      -l,  --label           Subzone label (default: nonprod)
           --network-profile Profile for the network account (default: network)
           --org-profile     Profile that reads Identity Center (default: personal)
      -f,  --force           Overwrite an existing terraform.tfvars

    Examples:

      ${this_script_name}

      ${this_script_name} --group platform-admins --group cliente-a --force

EOF
}

groups=()
label="nonprod"
network_profile="network"
org_profile="personal"
force="false"

while [[ "${1}" =~ ^- && ! "${1}" == "--" ]]; do
  case $1 in
    -h | --help )
      show_usage
      exit 1
      ;;

    -g | --group )
      shift
      groups+=("${1}")
      ;;

    -l | --label )
      shift
      label="${1}"
      ;;

    --network-profile )
      shift
      network_profile="${1}"
      ;;

    --org-profile )
      shift
      org_profile="${1}"
      ;;

    -f | --force )
      force="true"
      ;;

    * )
      echo "Invalid option: ${1}" >&2
      show_usage
      exit 1
      ;;
  esac
  shift
done

set -e

if [ "${#groups[@]}" -eq 0 ]; then
  groups=(platform-admins)
fi

region="us-east-1"
hub_vpc_name="poc-hub-vpc"
tfvars="${root}/terraform.tfvars"

fail() {
  echo "ERROR: ${1}" >&2
  exit 1
}

log() {
  echo "  ${1}" >&2
}

# Masks an identifier in diagnostic output. The generated file gets the whole
# value — it is gitignored; the terminal and the transcript do not need it.
mask() {
  local value="${1?}"
  echo "***${value: -4}"
}

for tool in aws jq; do
  command -v "${tool}" > /dev/null 2>&1 || fail "missing binary: ${tool}"
done

if [ -f "${tfvars}" ] && [ "${force}" != "true" ]; then
  fail "${tfvars} already exists. Use --force to overwrite."
fi

echo "" >&2
echo "==> Discovering what layer 3 needs" >&2

# --------------------------------------------------------------------------------------
# The region, before anything else
# --------------------------------------------------------------------------------------

# An SCP denying the region fails on the first Create* — after this script has said
# everything looked fine — and the error reads like a code bug. One cheap read call
# settles it here.
aws ec2 describe-vpcs \
  --profile "${network_profile}" \
  --region "${region}" \
  --max-items 1 \
  --query 'Vpcs[0].VpcId' \
  --output text > /dev/null 2>&1 \
  || fail "could not read VPCs in ${region} with profile '${network_profile}'. Expired credentials ('aws sso login --profile ${org_profile}') or a region denied by an SCP."

log "region ${region} reachable with profile '${network_profile}'"

# --------------------------------------------------------------------------------------
# The layer 2 subzone — the domain comes from it
# --------------------------------------------------------------------------------------

# Discovered through the API, not from the dns/ root terraform.tfvars: depending on the
# resource existing survives a backend or key change on the other side. And if layer 2
# was never applied, this layer's certificate would have nowhere to validate — better to
# find out now.
zones_json="$(aws route53 list-hosted-zones \
  --profile "${network_profile}" \
  --output json)" \
  || fail "could not list hosted zones in the network account."

subzone_names="$(echo "${zones_json}" \
  | jq --raw-output --arg prefix "${label}." \
    '.HostedZones[] | select(.Config.PrivateZone == false) | select(.Name | startswith($prefix)) | .Name | rtrimstr(".")')"

zone_count="$(echo "${subzone_names}" | grep --count . || true)"

if [ "${zone_count}" -eq 0 ]; then
  fail "no public hosted zone '${label}.*' in the network account. Layer 2 (dns) must be applied — run scripts/up-02-dns."
fi

if [ "${zone_count}" -gt 1 ]; then
  fail "${zone_count} public hosted zones '${label}.*': $(echo ${subzone_names} | tr '\n' ' '). Ambiguous — cannot tell which one to issue the certificate for."
fi

subzone_fqdn="${subzone_names}"
base_domain="${subzone_fqdn#"${label}".}"

log "subzone '${subzone_fqdn}' -> base_domain '${base_domain}'"

# --------------------------------------------------------------------------------------
# The hub VPC and its private subnets
# --------------------------------------------------------------------------------------

hub_vpc_ids="$(aws ec2 describe-vpcs \
  --profile "${network_profile}" \
  --region "${region}" \
  --filters "Name=tag:Name,Values=${hub_vpc_name}" \
  --query 'Vpcs[].VpcId' \
  --output text)"

hub_vpc_count="$(echo "${hub_vpc_ids}" | wc --words)"

if [ "${hub_vpc_count}" -eq 0 ]; then
  fail "no VPC tagged Name='${hub_vpc_name}' in ${region}. Layer 1 must be applied — run scripts/up-01-network-foundation."
fi

if [ "${hub_vpc_count}" -gt 1 ]; then
  fail "${hub_vpc_count} VPCs tagged Name='${hub_vpc_name}'. The Terraform data source requires exactly one — disambiguate first."
fi

log "hub VPC: $(mask "${hub_vpc_ids}")"

private_subnet_count="$(aws ec2 describe-subnets \
  --profile "${network_profile}" \
  --region "${region}" \
  --filters "Name=vpc-id,Values=${hub_vpc_ids}" "Name=tag:Name,Values=${hub_vpc_name%-vpc}-private-*" \
  --query 'length(Subnets)' \
  --output text)"

# No private subnet means no association, and without an association the endpoint stays
# in pending-associate forever — it comes up, it bills, and it never connects.
[ "${private_subnet_count}" -ge 1 ] \
  || fail "the hub VPC has no private subnet tagged Name='${hub_vpc_name%-vpc}-private-*'. The endpoint would stay in pending-associate."

log "${private_subnet_count} private subnet(s) in the hub"

# --------------------------------------------------------------------------------------
# Identity Center groups — name -> UUID
# --------------------------------------------------------------------------------------

# Client VPN matches authorization rules against the `memberOf` attribute of the assertion,
# and Identity Center sends UUIDs. Translating here avoids the nastiest symptom on this
# path: a tunnel that comes up and reaches nothing, with an error that does not say why.
identity_store_id="$(aws sso-admin list-instances \
  --profile "${org_profile}" \
  --query 'Instances[0].IdentityStoreId' \
  --output text 2> /dev/null)" \
  || fail "could not read Identity Center with profile '${org_profile}'. Run 'aws sso login --profile ${org_profile}'."

[ "${identity_store_id}" != "None" ] && [ -n "${identity_store_id}" ] \
  || fail "no Identity Center instance in this Organization."

log "identity store: $(mask "${identity_store_id}")"

group_ids=()
for group_name in "${groups[@]}"; do
  group_id="$(aws identitystore list-groups \
    --profile "${org_profile}" \
    --identity-store-id "${identity_store_id}" \
    --query "Groups[?DisplayName=='${group_name}'].GroupId" \
    --output text)"

  [ -n "${group_id}" ] \
    || fail "group '${group_name}' does not exist in Identity Center. Create it first, or pass a different --group."

  # Two groups with the same DisplayName should not exist, but if they do, --output text
  # returns both separated by a tab and the tfvars would come out garbled.
  [ "$(echo "${group_id}" | wc --words)" -eq 1 ] \
    || fail "more than one group named '${group_name}'. Ambiguous."

  log "group '${group_name}' -> $(mask "${group_id}")"
  group_ids+=("${group_id}")
done

# --------------------------------------------------------------------------------------
# The SAML metadata — a console step, and therefore the easiest one to forget
# --------------------------------------------------------------------------------------

saml_metadata_path="saml-metadata.xml"

if [ ! -f "${root}/${saml_metadata_path}" ]; then
  cat >&2 <<EOF

ERROR: ${root}/${saml_metadata_path} does not exist.

It cannot be generated by Terraform: the Identity Center CreateApplication API only
creates custom OAuth 2.0 applications. A SAML application is a console step.

Click-by-click walkthrough (which console, which button, which field):

  docs/superpowers/plans/2026-08-26-private-access-and-ingress/02-private-access.md
  section "O passo de console, clique a clique"

Short version — IAM Identity Center in the MANAGEMENT account
(https://console.aws.amazon.com/singlesignon):

  Applications -> Customer managed -> Add application
    -> "I have an application I want to set up" -> SAML 2.0

  Display name              hub-client-vpn
  Application ACS URL       http://127.0.0.1:35001
  Application SAML audience urn:amazon:webservices:clientvpn

  Attribute mappings (memberOf is CASE SENSITIVE):

    Subject   -> \${user:email}   format emailAddress
    memberOf  -> \${user:groups}  format unspecified

  Download the "IAM Identity Center SAML metadata file" (Default / IPv4 only tab)
  and save it as:

    ${root}/${saml_metadata_path}

  Then assign the groups under "Assigned users and groups" — without that the
  assertion arrives with no memberOf and the tunnel reaches nothing.

Run this script again afterwards.

EOF
  exit 1
fi

metadata_size="$(wc --chars < "${root}/${saml_metadata_path}")"

# The provider rejects saml_metadata_document outside 1000..10000000 characters, and that
# validation runs at plan time. Real Identity Center metadata is a few KB; a short file
# here is almost always an error page saved by mistake.
[ "${metadata_size}" -ge 1000 ] \
  || fail "${saml_metadata_path} has ${metadata_size} characters. The provider requires >= 1000, and real Identity Center metadata is a few KB — this is probably the wrong file."

log "SAML metadata: ${metadata_size} characters"

# --------------------------------------------------------------------------------------
# Write
# --------------------------------------------------------------------------------------

group_ids_hcl="$(printf '"%s", ' "${group_ids[@]}")"
group_ids_hcl="[${group_ids_hcl%, }]"

cat > "${tfvars}" <<EOF
# Generated by ${this_script_name} on $(date --iso-8601=seconds).
#
# Identity values (domain, Identity Center groups), which is why they live here and not
# inline in main.tf: this repository is public. Region, hub name and supernet stay inline
# there, because they are documented design decisions.

base_domain   = "${base_domain}"
subzone_label = "${label}"

saml_metadata_path = "${saml_metadata_path}"

operator_group_ids = ${group_ids_hcl}

client_cidr_block = "100.64.0.0/22"
EOF

echo "" >&2
echo "==> Wrote ${tfvars}" >&2

git -C "${root}" check-ignore --quiet "${tfvars}" 2> /dev/null \
  || fail "${tfvars} is NOT gitignored. Fix that before going on — it carries the domain and group ids."

git -C "${root}" check-ignore --quiet "${root}/${saml_metadata_path}" 2> /dev/null \
  || fail "${saml_metadata_path} is NOT gitignored. Fix that before going on — it identifies the Identity Center instance."

log "terraform.tfvars and ${saml_metadata_path} are gitignored"
