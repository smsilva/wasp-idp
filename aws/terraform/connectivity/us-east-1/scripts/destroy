#!/bin/bash
this_script_path="$(realpath ${0})"
this_script_name="${this_script_path##*/}"
this_script_directory="${this_script_path%/*}"

PATH="${this_script_directory}:${PATH}"

root_directory="$(realpath "${this_script_directory}/..")"

show_usage() {
  cat <<EOF

  Destroys the connectivity layer (TGW + Client VPN) and keeps the log.

  This layer is destroyed ON PURPOSE at the end of the day — tier T1, around
  US\$ 0.22/h idle (two Client VPN subnet associations plus the ALB), before
  per-connection and LCU charges. Nothing here has prevent_destroy; the
  protection is this script saying out loud what is lost before you confirm.

  Before destroying, it REFUSES if anything that does not belong to this state
  is still hanging off its resources: a TGW attachment, or a certificate or
  rule on the shared :443 listener. The hub's OWN attachment (2.3) and the
  listener's own default certificate DO belong here and are excluded; only
  foreign ones (a cell's) trip it.

  AWS also refuses to delete a TGW with a live attachment, and an ALB with a
  listener a cell still uses, but those errors arrive after the destroy has
  already removed half the layer — the certificate and the endpoint would be
  gone while the TGW stayed, billing and unused.

  Chain order: control-plane BEFORE this one (the spoke attachment lives in
  the control-plane state).

    Options:

      -h,  --help              Show this help
      -y,  --yes               Do not ask (passes -auto-approve)
           --skip-attachments  Skip the TGW attachment check
           --skip-listener     Skip the :443 listener certificate/rule check
           --log-directory     Where to write the log (default: ${root_directory}/logs)

    Examples:

      ${this_script_name}

      ${this_script_name} --yes

EOF
}

assume_yes="false"
skip_attachments="false"
skip_listener="false"
log_directory="${root_directory}/logs"

while [[ "${1}" =~ ^- && ! "${1}" == "--" ]]; do
  case $1 in
    -h | --help )
      show_usage
      exit 1
      ;;

    -y | --yes )
      assume_yes="true"
      ;;

    --skip-attachments )
      skip_attachments="true"
      ;;

    --skip-listener )
      skip_listener="true"
      ;;

    --log-directory )
      shift
      log_directory="${1}"
      ;;

    * )
      echo "Invalid option: ${1}" >&2
      show_usage
      exit 1
      ;;
  esac
  shift
done

fail() {
  echo "ERROR: ${1}" >&2
  exit 1
}

set -e

for tool in aws terraform; do
  command -v "${tool}" > /dev/null 2>&1 || fail "missing binary: ${tool}"
done

cd "${root_directory}"

[ -d .terraform ] || fail "backend not initialized. Run 'terraform init -backend-config=\"bucket=<bucket>\"'."

profile="$(terraform output -raw aws_profile 2> /dev/null)" || profile="network"

transit_gateway_id="$(terraform output -raw transit_gateway_id 2> /dev/null)" || transit_gateway_id=""

if [ "${skip_attachments}" != "true" ] && [ -n "${transit_gateway_id}" ]; then
  # The hub's own attachment (2.3) belongs to THIS state — terraform destroy removes it as
  # part of the same run. Only an attachment that is NOT this one is foreign.
  own_attachment_id="$(terraform output -raw transit_gateway_attachment_id 2> /dev/null)" || own_attachment_id=""

  attachments="$(aws ec2 describe-transit-gateway-attachments \
    --profile "${profile}" \
    --region us-east-1 \
    --filters "Name=transit-gateway-id,Values=${transit_gateway_id}" "Name=state,Values=available,pending,modifying" \
    --query 'TransitGatewayAttachments[].[TransitGatewayAttachmentId,ResourceType,ResourceId,State]' \
    --output text 2> /dev/null)" || attachments=""

  foreign_attachments="$(echo "${attachments}" | awk -v own="${own_attachment_id}" -F'\t' '$1 != own')"
  attachment_count="$(echo "${foreign_attachments}" | grep --count . || true)"

  if [ "${attachment_count}" -gt 0 ]; then
    echo "" >&2
    echo "${foreign_attachments}" >&2
    echo "" >&2
    fail "${attachment_count} live attachment(s) on TGW ${transit_gateway_id} outside this layer. Destroy the layer that owns them first (the spoke: control-plane/scripts/destroy) or use --skip-attachments knowing the destroy will fail on the TGW."
  fi

  echo "  TGW has no attachment from outside this state" >&2
fi

# Same class of foreign dependency as the TGW attachment, on a different resource. Each cell
# hangs its own certificate (SNI) and its own host rule on the SHARED :443 listener, from the
# control-plane state. Destroying this layer with those in place fails the same way the TGW
# does — halfway through, after the ALB is already gone.
listener_arn="$(terraform output -raw alb_listener_arn 2> /dev/null)" || listener_arn=""

if [ "${skip_listener}" != "true" ] && [ -n "${listener_arn}" ]; then
  # A certificate added by another state shows up with IsDefault=false; the default one is
  # this layer's own wildcard.
  foreign_certificates="$(aws elbv2 describe-listener-certificates \
    --profile "${profile}" \
    --region us-east-1 \
    --listener-arn "${listener_arn}" \
    --query 'Certificates[?IsDefault==`false`].CertificateArn' \
    --output text 2> /dev/null)" || foreign_certificates=""

  # This layer creates NO rule — the listener has only its fixed-response default action. Any
  # non-default rule came from a cell.
  foreign_rules="$(aws elbv2 describe-rules \
    --profile "${profile}" \
    --region us-east-1 \
    --listener-arn "${listener_arn}" \
    --query 'Rules[?IsDefault==`false`].RuleArn' \
    --output text 2> /dev/null)" || foreign_rules=""

  foreign_listener_count="$(echo "${foreign_certificates} ${foreign_rules}" | tr '\t ' '\n\n' | grep --count . || true)"

  if [ "${foreign_listener_count}" -gt 0 ]; then
    echo "" >&2
    [ -n "${foreign_certificates}" ] && echo "  certificates: ${foreign_certificates}" >&2
    [ -n "${foreign_rules}" ] && echo "  rules: ${foreign_rules}" >&2
    echo "" >&2
    fail "${foreign_listener_count} certificate(s)/rule(s) on listener ${listener_arn} outside this layer. Destroy the layer that owns them first (the cell: control-plane/scripts/destroy) or use --skip-listener knowing the destroy will fail on the ALB."
  fi

  echo "  :443 listener has no certificate or rule from outside this state" >&2
fi

# What is lost, said before asking. The point is not to scare: two of these come back
# different after recreation, and whoever confirms needs to know that.
cat >&2 <<EOF

This goes away:

  TGW ${transit_gateway_id:-<no output>}
    and the hub route table. Recreating yields NEW ids — layer 4 reads the TGW
    by tag and does not store the id, so it does not break.

  Client VPN endpoint
    its DNS name CHANGES on recreation. Any saved .ovpn becomes invalid; use
    'vpn config' to re-export instead of reusing a file.

  ACM certificate and its validation record
    the subzone (layer 2) STAYS — it is T0 and has prevent_destroy. The
    certificate is reissued on the next apply, and waiting for validation takes
    a few minutes.

  Authorization rules
    the policy of who reaches what. Comes back from terraform.tfvars.

  Public ingress ALB, its :443 listener and the default wildcard certificate
    the PUBLIC INGRESS OF EVERY CELL goes with it. Its DNS name changes on
    recreation, so each cell's alias record is rewritten by the next apply of
    layer 4 — which is why 4 goes down before this one and comes up after.

This does NOT go away: the DNS subzone, the hub VPC, the state bucket.

EOF

if [ "${assume_yes}" != "true" ]; then
  if [ ! -t 0 ]; then
    fail "no terminal to confirm on. Use --yes if this is deliberate."
  fi

  read -r -p "Destroy the connectivity layer? [yes/N] " answer
  [ "${answer}" == "yes" ] || fail "cancelled."
fi

mkdir --parents "${log_directory}"

timestamp="$(date +%Y%m%d-%H%M%S)"
log_file="${log_directory}/destroy-${timestamp}.log"

auto_approve=("-auto-approve")

echo "Destroying. Log: ${log_file}" >&2

terraform destroy -no-color "${auto_approve[@]}" 2>&1 | tee "${log_file}"
# tee always returns 0; PIPESTATUS holds the terraform exit code.
destroy_status="${PIPESTATUS[0]}"

echo "" >&2
echo "Log: ${log_file}" >&2

if [ "${destroy_status}" -ne 0 ]; then
  fail "the destroy failed (exit ${destroy_status}). The TGW and the endpoint keep billing — check 'terraform state list'."
fi

echo "connectivity layer destroyed. dns and network-foundation are still up." >&2
