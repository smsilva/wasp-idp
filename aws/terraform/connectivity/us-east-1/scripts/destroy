#!/bin/bash
this_script_path="$(realpath ${0})"
this_script_name="${this_script_path##*/}"
this_script_directory="${this_script_path%/*}"

PATH="${this_script_directory}:${PATH}"

root_directory="$(realpath "${this_script_directory}/..")"

show_usage() {
  cat <<EOF

  Destroys the connectivity layer (TGW + Client VPN) and keeps the log.

  This layer is destroyed ON PURPOSE at the end of the day — tier T1,
  ~US\$ 0.15/h. Nothing here has prevent_destroy; the protection is this
  script saying out loud what is lost before you confirm.

  Before destroying, it REFUSES if there is any TGW attachment that does not
  belong to this state. AWS also refuses to delete a TGW with a live
  attachment, but its error arrives after the destroy has already removed half
  the layer — the certificate and the endpoint would be gone and the TGW would
  stay, billing and unused.

  Chain order: control-plane BEFORE this one (the spoke attachment lives in
  the control-plane state).

    Options:

      -h,  --help              Show this help
      -y,  --yes               Do not ask (passes -auto-approve)
           --skip-attachments  Skip the attachment check
           --log-directory     Where to write the log (default: ${root_directory}/logs)

    Examples:

      ${this_script_name}

      ${this_script_name} --yes

EOF
}

assume_yes="false"
skip_attachments="false"
log_directory="${root_directory}/logs"

while [[ "${1}" =~ ^- && ! "${1}" == "--" ]]; do
  case $1 in
    -h | --help )
      show_usage
      exit 1
      ;;

    -y | --yes )
      assume_yes="true"
      ;;

    --skip-attachments )
      skip_attachments="true"
      ;;

    --log-directory )
      shift
      log_directory="${1}"
      ;;

    * )
      echo "Invalid option: ${1}" >&2
      show_usage
      exit 1
      ;;
  esac
  shift
done

fail() {
  echo "ERROR: ${1}" >&2
  exit 1
}

set -e

for tool in aws terraform; do
  command -v "${tool}" > /dev/null 2>&1 || fail "missing binary: ${tool}"
done

cd "${root_directory}"

[ -d .terraform ] || fail "backend not initialized. Run 'terraform init -backend-config=\"bucket=<bucket>\"'."

transit_gateway_id="$(terraform output -raw transit_gateway_id 2> /dev/null)" || transit_gateway_id=""

if [ "${skip_attachments}" != "true" ] && [ -n "${transit_gateway_id}" ]; then
  profile="$(terraform output -raw aws_profile 2> /dev/null)" || profile="network"

  attachments="$(aws ec2 describe-transit-gateway-attachments \
    --profile "${profile}" \
    --region us-east-1 \
    --filters "Name=transit-gateway-id,Values=${transit_gateway_id}" "Name=state,Values=available,pending,modifying" \
    --query 'TransitGatewayAttachments[].[TransitGatewayAttachmentId,ResourceType,ResourceId,State]' \
    --output text 2> /dev/null)" || attachments=""

  attachment_count="$(echo "${attachments}" | grep --count . || true)"

  if [ "${attachment_count}" -gt 0 ]; then
    echo "" >&2
    echo "${attachments}" >&2
    echo "" >&2
    fail "${attachment_count} live attachment(s) on TGW ${transit_gateway_id}, and none of them belong to this layer. Destroy the layer that owns them first (the spoke: control-plane/scripts/destroy) or use --skip-attachments knowing the destroy will fail on the TGW."
  fi

  echo "  TGW has no attachment from outside this state" >&2
fi

# What is lost, said before asking. The point is not to scare: two of these come back
# different after recreation, and whoever confirms needs to know that.
cat >&2 <<EOF

This goes away:

  TGW ${transit_gateway_id:-<no output>}
    and the hub route table. Recreating yields NEW ids — layer 4 reads the TGW
    by tag and does not store the id, so it does not break.

  Client VPN endpoint
    its DNS name CHANGES on recreation. Any saved .ovpn becomes invalid; use
    'vpn config' to re-export instead of reusing a file.

  ACM certificate and its validation record
    the subzone (layer 2) STAYS — it is T0 and has prevent_destroy. The
    certificate is reissued on the next apply, and waiting for validation takes
    a few minutes.

  Authorization rules
    the policy of who reaches what. Comes back from terraform.tfvars.

This does NOT go away: the DNS subzone, the hub VPC, the state bucket.

EOF

if [ "${assume_yes}" != "true" ]; then
  if [ ! -t 0 ]; then
    fail "no terminal to confirm on. Use --yes if this is deliberate."
  fi

  read -r -p "Destroy the connectivity layer? [yes/N] " answer
  [ "${answer}" == "yes" ] || fail "cancelled."
fi

mkdir --parents "${log_directory}"

timestamp="$(date +%Y%m%d-%H%M%S)"
log_file="${log_directory}/destroy-${timestamp}.log"

auto_approve=("-auto-approve")

echo "Destroying. Log: ${log_file}" >&2

terraform destroy -no-color "${auto_approve[@]}" 2>&1 | tee "${log_file}"
# tee always returns 0; PIPESTATUS holds the terraform exit code.
destroy_status="${PIPESTATUS[0]}"

echo "" >&2
echo "Log: ${log_file}" >&2

if [ "${destroy_status}" -ne 0 ]; then
  fail "the destroy failed (exit ${destroy_status}). The TGW and the endpoint keep billing — check 'terraform state list'."
fi

echo "connectivity layer destroyed. dns and network-foundation are still up." >&2
