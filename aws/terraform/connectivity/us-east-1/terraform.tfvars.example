# Copie para terraform.tfvars (gitignored) ou deixe scripts/up-03-connectivity gerar.
#
# Região, nome do hub e o supernet NÃO estão aqui: são decisões de desenho inline no main.tf.
# O que entra por tfvars é o que identifica a conta e as pessoas de quem roda.

base_domain   = "exemplo.com"
subzone_label = "nonprod"

# Caminho do metadata XML da aplicação SAML do Identity Center, relativo a esta raiz.
# NÃO é gerado por Terraform: a API CreateApplication do Identity Center só cria aplicação
# OAuth 2.0 customizada, então aplicação SAML é passo de console.
saml_metadata_path = "saml-metadata.xml"

# IDs de grupo do Identity Center, não nomes — o Client VPN casa contra o `memberOf` da
# assertion, e o Identity Center manda UUID. Descubra com:
#
#   aws identitystore list-groups --identity-store-id <id> --profile personal \
#     --query 'Groups[].[DisplayName,GroupId]' --output table
operator_group_ids = ["00000000-0000-0000-0000-000000000000"]

# Fora do supernet 10.0.0.0/12 de propósito. Não muda depois de o endpoint existir.
client_cidr_block = "100.64.0.0/22"

# Contas às quais o TGW é compartilhado via RAM, para que cada uma crie o próprio attachment.
# Uma por spoke — hoje só a conta cicd (control-plane).
spoke_account_ids = ["000000000000"]
